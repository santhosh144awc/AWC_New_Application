---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import PersonalFinanceStatementApp from '../../features/statement/PersonalFinanceStatementApp';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/health-check/real-statement/');
const { regulatory, disclosures } = BUSINESS_PROFILE;

const registrationNotice = regulatory.arnStatus === 'CONFIRMED'
  ? 'Ant Wealth Creation is an AMFI-registered mutual fund distributor.'
  : `Ant Wealth Creation provides ${regulatory.registrationStatusText}.`;

const statementStages = [
  {
    step: 'Stage 1',
    title: 'Income & Household Inflows',
    focus: 'Total Cash Inflow',
    description: 'Map take-home salaries, business earnings, bonuses, rental income, and investment yield with explicit deduction tracking.',
    liveFeedback: 'Computes Gross Annual Income, Deductions, and Net Annual / Monthly Equivalent.',
  },
  {
    step: 'Stage 2',
    title: 'Expenses & Living Costs',
    focus: 'Mode A vs Mode B',
    description: 'Enter consolidated monthly household spending or break down living costs line-by-line across essentials, lifestyle, dependent support, insurance premiums, and loan EMIs.',
    liveFeedback: 'Computes Annual Living Costs and Monthly Cash Outflow Equivalent without double counting.',
  },
  {
    step: 'Stage 3',
    title: 'Savings & Ongoing Investments',
    focus: 'Investible Surplus',
    description: 'Bridge income against living costs to determine gross savings, subtract systematic commitments (mutual fund SIPs, PPF, RDs), and calculate fresh investible surplus.',
    liveFeedback: 'Computes Annual Savings Rate (%) and surplus compounding projections at 5, 10, 15, and 20 years.',
  },
  {
    step: 'Stage 4',
    title: 'Assets Portfolio (6 Classes)',
    focus: 'Productive vs Personal',
    description: 'Register Liquid, Debt, Equity, Gold, Real Estate (investments), and Personal Consumption assets with owner-wise attribution across self, spouse, and children.',
    liveFeedback: 'Separates Productive Wealth Assets from Personal Residence & Consumption Assets.',
  },
  {
    step: 'Stage 5',
    title: 'Liabilities & Obligations',
    focus: 'Debt Solvency',
    description: 'Consolidate outstanding debt principals across home loans, vehicle financing, personal borrowings, education loans, and credit card balances.',
    liveFeedback: 'Computes Total Debt Obligations and Debt-to-Asset Solvency Ratio.',
  },
  {
    step: 'Stage 6',
    title: 'Net Worth & Final Review',
    focus: 'True Balance Sheet',
    description: 'Review the dual net worth balance sheet (Accounting Net Worth vs Productive Net Worth), evaluate solvency ratios, add preparer notes, and generate a client-ready PDF.',
    liveFeedback: 'Generates client-side 5-page Personal Finance Statement PDF with zero server upload.',
  },
];
---

<BaseLayout
  title="Personal Finance Statement & Household Balance Sheet — Ant Wealth Creation"
  description="Comprehensive 6-stage family cash flow, asset allocation, and productive net worth balance sheet. Reconciles income, living expenses, investments, debts, and generates client-ready PDF reports."
  currentPath="/health-check/real-statement/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Comprehensive Household Diagnostic"
      title="Personal Finance Statement & Household Balance Sheet"
      description="A structured 6-stage family financial review that maps cash flows, itemizes assets and debts across owners, separates productive investments from personal residence utility, and generates a client-ready statement."
    />

    <!-- Interactive 6-Stage Personal Finance Statement Application -->
    <PersonalFinanceStatementApp client:load />

    <!-- Collapsed by default methodology and definitions -->
    <details class="statement-details">
      <summary class="statement-details-summary">
        <span class="summary-icon">📖</span>
        <span class="summary-text">How the 6-Stage Personal Finance Statement Works: Methodology &amp; Metric Definitions</span>
        <span class="toggle-indicator">▼</span>
      </summary>
      <div class="details-content">
        <p class="details-intro">
          To provide a complete and rigorous diagnostic, the Personal Finance Statement organizes your household finances into six clear stages:
        </p>

        <div class="stages-grid">
          {statementStages.map((st) => (
            <div class="stage-card">
              <div class="stage-badge-row">
                <span class="stage-badge">{st.step}</span>
                <span class="stage-focus">{st.focus}</span>
              </div>
              <h3 class="stage-title">{st.title}</h3>
              <p class="stage-desc">{st.description}</p>
              <div class="stage-feedback-box">
                <span class="feedback-label">Calculated Metrics</span>
                <p class="feedback-text">{st.liveFeedback}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="methodology-note">
          <p>
            <strong>Core Principle:</strong> A primary residence provides shelter and family utility, but does not generate cash flow to fund monthly expenses. The Personal Finance Statement calculates both Accounting Net Worth (total assets − total liabilities) and Actual Net Worth (excluding personal residence and vehicles) to measure the true capital available to fund life milestones.
          </p>
        </div>
      </div>
    </details>

    <!-- Reciprocal Navigation & Next Steps -->
    <section class="related-tools-section" aria-labelledby="related-tools-title">
      <div class="section-header-compact">
        <span class="eyebrow">Explore Next</span>
        <h2 id="related-tools-title" class="related-heading">Connected Diagnostics &amp; Planners</h2>
        <p class="related-sub">Move between quick balance sheets, milestone roadmaps, and full health checks.</p>
      </div>

      <div class="related-grid">
        <a href="/tools/net-worth/" class="related-card highlight-card">
          <div class="card-top">
            <span class="card-icon" style="background: var(--primitive-teal-100, #CFEFE3)">▤</span>
            <span class="card-tag">Quick Diagnostic</span>
          </div>
          <h3 class="card-title">Quick Net Worth Snapshot</h3>
          <p class="card-desc">Want a shorter asset-and-debt snapshot? Open the Quick Net Worth balance sheet to consolidate figures in two minutes.</p>
          <span class="card-action">Open Quick Net Worth →</span>
        </a>

        <a href="/health-check/" class="related-card">
          <div class="card-top">
            <span class="card-icon" style="background: var(--primitive-gold-50, #FDF7E7)">◉</span>
            <span class="card-tag">Foundational Health</span>
          </div>
          <h3 class="card-title">7-Pillar Health Check</h3>
          <p class="card-desc">Evaluate emergency reserves, debt limits, and family defense pillars through a 2-minute qualitative checkup.</p>
          <span class="card-action">Take health check →</span>
        </a>

        <a href="/plan/" class="related-card">
          <div class="card-top">
            <span class="card-icon" style="background: var(--primitive-slate-50, #F1F5F9)">◎</span>
            <span class="card-tag">Milestone Planners</span>
          </div>
          <h3 class="card-title">Milestone Goal Planners</h3>
          <p class="card-desc">Put your monthly surplus to work with inflation-adjusted funding roadmaps for education, home, and retirement.</p>
          <span class="card-action">Explore goal planners →</span>
        </a>
      </div>
    </section>

    <!-- Transparent Regulatory Disclosure -->
    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {registrationNotice} {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} The Personal Finance Statement generates diagnostic aggregations based on user-supplied values. It is not an audit, formal net worth certification, tax computation, or personalized investment recommendation.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  /* Collapsible Methodology Details */
  .statement-details {
    background-color: var(--color-bg-surface, #ffffff);
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    margin: var(--space-8) 0;
    overflow: hidden;
    box-shadow: var(--shadow-subtle, 0 1px 3px rgba(0, 0, 0, 0.04));
  }

  .statement-details-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-brand-primary, #173047);
    user-select: none;
    list-style: none;
  }

  .statement-details-summary::-webkit-details-marker {
    display: none;
  }

  .summary-icon {
    font-size: 1.1rem;
  }

  .summary-text {
    flex: 1;
  }

  .toggle-indicator {
    font-size: 0.75rem;
    color: var(--color-text-secondary, #64748b);
    transition: transform var(--transition-fast, 150ms ease);
  }

  .statement-details[open] .toggle-indicator {
    transform: rotate(180deg);
  }

  .details-content {
    padding: 0 var(--space-5) var(--space-5) var(--space-5);
    border-top: 1px solid var(--color-border-subtle, #f1f5f9);
    margin-top: var(--space-2);
  }

  .details-intro {
    font-size: 0.88rem;
    color: var(--color-text-secondary, #64748b);
    margin: var(--space-3) 0 var(--space-4) 0;
    line-height: 1.5;
  }

  .stages-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .stages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stage-card {
    background-color: var(--awc-paper);
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
  }

  .stage-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .stage-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-brand-accent, #16877E);
    background-color: var(--primitive-teal-50, #f0fdfa);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm, 4px);
    border: 1px solid var(--primitive-teal-200, #99f6e4);
  }

  .stage-focus {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-brand-primary, #173047);
    background-color: var(--primitive-gold-50, #FDF7E7);
    border: 1px solid var(--primitive-gold-100, #FCEBC2);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill, 9999px);
  }

  .stage-title {
    font-size: 0.98rem;
    font-family: var(--font-family-heading, inherit);
    font-weight: 700;
    color: var(--color-brand-primary, #173047);
    margin: 0 0 var(--space-2) 0;
  }

  .stage-desc {
    font-size: 0.8rem;
    color: var(--color-text-secondary, #64748b);
    line-height: 1.45;
    margin-bottom: var(--space-3);
    flex-grow: 1;
  }

  .stage-feedback-box {
    background-color: #ffffff;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-sm, 6px);
    padding: var(--space-2) var(--space-3);
  }

  .feedback-label {
    display: block;
    font-weight: 700;
    color: var(--color-brand-accent, #16877E);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }

  .feedback-text {
    font-size: 0.78rem;
    color: var(--color-brand-primary, #173047);
    line-height: 1.4;
    margin: 0;
  }

  .methodology-note {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background-color: var(--primitive-teal-50, #f0fdfa);
    border-left: 3px solid var(--color-brand-accent, #16877E);
    border-radius: 0 var(--radius-sm, 6px) var(--radius-sm, 6px) 0;
  }

  .methodology-note p {
    font-size: 0.8rem;
    color: var(--color-brand-primary, #173047);
    margin: 0;
    line-height: 1.45;
  }

  /* Related Tools Section */
  .related-tools-section {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-subtle, #e2e8f0);
  }

  .section-header-compact {
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-accent, #16877E);
    display: block;
    margin-bottom: var(--space-1);
  }

  .related-heading {
    font-size: var(--text-h3, 1.3rem);
    font-family: var(--font-family-heading, inherit);
    font-weight: 700;
    color: var(--color-brand-primary, #173047);
    margin: 0 0 var(--space-1) 0;
  }

  .related-sub {
    font-size: 0.88rem;
    color: var(--color-text-secondary, #64748b);
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .related-card {
    background-color: var(--color-bg-surface, #ffffff);
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-fast, 150ms ease);
    box-shadow: var(--shadow-subtle, 0 1px 3px rgba(0, 0, 0, 0.04));
  }

  .related-card:hover {
    border-color: var(--color-brand-accent, #16877E);
    box-shadow: 0 4px 12px rgba(22, 135, 126, 0.1);
    transform: translateY(-2px);
  }

  .highlight-card {
    border-color: var(--primitive-teal-200, #99f6e4);
    background: linear-gradient(180deg, #ffffff 0%, var(--primitive-teal-50, #f0fdfa) 100%);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .card-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm, 6px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  .card-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-brand-primary, #173047);
    background-color: var(--awc-paper);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill, 9999px);
  }

  .card-title {
    font-size: 1.05rem;
    font-family: var(--font-family-heading, inherit);
    font-weight: 700;
    color: var(--color-brand-primary, #173047);
    margin: 0 0 var(--space-2) 0;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--color-text-secondary, #64748b);
    line-height: 1.45;
    margin: 0 0 var(--space-4) 0;
    flex: 1;
  }

  .card-action {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-brand-accent, #16877E);
    display: inline-flex;
    align-items: center;
  }

  /* Regulatory Note */
  .regulatory-disclosure-note {
    margin-top: var(--space-10);
    padding: var(--space-4) var(--space-5);
    background-color: var(--awc-sand);
    border-left: 3px solid var(--awc-gold);
    border-radius: 0 var(--radius-md, 8px) var(--radius-md, 8px) 0;
  }

  .regulatory-disclosure-note p {
    font-size: 0.78rem;
    color: var(--color-text-secondary, #475569);
    line-height: 1.5;
    margin: 0;
  }
</style>
