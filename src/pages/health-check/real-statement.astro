---
// Compatibility redirect for legacy route: /health-check/real-statement/
// Canonical destination: /tools/personal-finance-statement/
const destination = '/tools/personal-finance-statement/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={`https://antwealth.in${destination}`} />
    <title>Redirecting to Personal Finance Statement…</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body style="font-family: system-ui, -apple-system, sans-serif; padding: 2rem; text-align: center; color: #1e293b; background: #f8fafc;">
    <p>Redirecting to <a href={destination} style="color: #0f766e; text-decoration: underline; font-weight: 600;">Personal Finance Statement</a>…</p>
  </body>
</html>
