---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import HealthQuestionnaire from '../../features/health/HealthQuestionnaire';
import { getBreadcrumbsForPath } from '../../config/routes';

const crumbs = getBreadcrumbsForPath('/health-check/');
---

<BaseLayout
  title="Understand Your Family's Financial Health — Ant Wealth Creation"
  description="Answer a few practical questions about your household finances to see where things are going well and where you may want to focus next."
  currentPath="/health-check/"
>
  <div class="health-page-container">
    <Breadcrumbs crumbs={crumbs} />

    <!-- Interactive Financial Health Assessment Island -->
    <HealthQuestionnaire client:load />
  </div>
</BaseLayout>

<style>
  .health-page-container {
    width: 100%;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem; /* 32px desktop */
    padding-right: 2rem;
    padding-bottom: var(--space-16, 4rem);
    box-sizing: border-box;
  }

  @media (max-width: 1024px) {
    .health-page-container {
      padding-left: 1.5rem; /* 24px tablet */
      padding-right: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .health-page-container {
      padding-left: 1rem; /* 16px mobile */
      padding-right: 1rem;
    }
  }
</style>
