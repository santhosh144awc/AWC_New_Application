---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_PROFILE } from '../config/businessProfile';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PillarCard from '../components/ui/PillarCard.astro';
import GoalCard from '../components/ui/GoalCard.astro';
import ToolPreviewCard from '../components/ui/ToolPreviewCard.astro';

const pillarsData = [
  {
    number: "01",
    name: "Cash Flow & Surplus",
    focus: "Foundation",
    question: "Do you reliably generate a monthly savings surplus above 25% after household expenses?",
    benchmark: "Healthy savings rate of 25%–35% of net monthly family income."
  },
  {
    number: "02",
    name: "Emergency Reserve",
    focus: "Safety Net",
    question: "If all household income stopped tomorrow, how many months could your family sustain essentials?",
    benchmark: "6 to 9 months of essential living expenses parked in liquid instruments."
  },
  {
    number: "03",
    name: "Debt Comfort & Solvency",
    focus: "Solvency",
    question: "Are your monthly debt EMIs taking away the freedom to invest for your future goals?",
    benchmark: "Total loan EMIs kept strictly below 35%–40% of net take-home salary."
  },
  {
    number: "04",
    name: "Pure Risk Protection",
    focus: "Defense",
    question: "Is your life cover purely protective (15x annual income), or tied to low-yielding endowment policies?",
    benchmark: "12x–20x pure term life cover and independent family health insurance."
  },
  {
    number: "05",
    name: "Productive Investing",
    focus: "Growth",
    question: "Are your long-term savings beating real-world inflation, or losing purchasing power in savings accounts?",
    benchmark: "Disciplined equity allocation for 7+ year horizons to beat 6%–8% inflation."
  },
  {
    number: "06",
    name: "Goal Horizons",
    focus: "Direction",
    question: "Do you have specific target dates and earmarked asset allocations for your life milestones?",
    benchmark: "Distinct earmarked portfolios matching the time horizon of each milestone."
  },
  {
    number: "07",
    name: "Retirement Freedom",
    focus: "Independence",
    question: "Will your retirement corpus generate inflation-protected monthly cash flow for 30+ years?",
    benchmark: "25x–30x annual post-retirement expenses, structured for longevity."
  }
];

const goalsData = [
  {
    title: "Children's Higher Education",
    horizon: "10–18 Years Ahead",
    iconText: "🎓",
    coreQuestion: "How much will college tuition, hostel, and overseas degrees cost when inflation runs at 8%–10%?",
    planningInsight: "Build an equity mutual fund SIP early. Protect the goal with adequate pure term cover so education is secured regardless of life uncertainties."
  },
  {
    title: "Family Home Purchase",
    horizon: "3–8 Years Ahead",
    iconText: "🏡",
    coreQuestion: "How do you accumulate a 25% down payment without exhausting your family emergency fund?",
    planningInsight: "Use conservative hybrid and debt allocation for the down payment buffer, ensuring future EMIs stay comfortably under 35% of monthly income."
  },
  {
    title: "Disciplined Wealth Accumulation",
    horizon: "7–15+ Years Ahead",
    iconText: "🌱",
    coreQuestion: "How does patient monthly compounding across market cycles create generational peace of mind?",
    planningInsight: "Maintain annual step-up SIPs that grow alongside your salary, resisting market noise and staying invested through volatility."
  },
  {
    title: "Dignified Retirement Freedom",
    horizon: "15–30 Years Ahead",
    iconText: "🌅",
    coreQuestion: "How much corpus is required to maintain your current lifestyle through 30 years without working?",
    planningInsight: "Transition from accumulation to a 3-bucket distribution strategy (Liquidity, Safety, Growth) to ensure your money outlives you."
  }
];

const toolsData = [
  {
    title: "SIP Wealth Simulator",
    category: "Investments",
    realQuestion: "How much wealth could a disciplined monthly SIP generate over 10 or 15 years?",
    description: "Models compound growth, compares nominal versus inflation-adjusted purchasing power, and illustrates annual step-up benefits."
  },
  {
    title: "Home Loan Foreclosure vs SIP",
    category: "Debt Strategy",
    realQuestion: "Should you prepay your home loan early or build a parallel mutual fund SIP?",
    description: "Amortizes loan balances and illustrates the mathematical crossover point where a parallel SIP can clear debt years ahead of schedule."
  },
  {
    title: "Loan Interest Recovery SIP",
    category: "Borrowing",
    realQuestion: "Can a small parallel monthly SIP recover 100% of the interest paid on your loan?",
    description: "Calculates the exact parallel investment required alongside your EMI so compound growth offsets your total interest burden."
  },
  {
    title: "Productive Net Worth Balance Sheet",
    category: "Diagnostic",
    realQuestion: "What is your real productive net worth after removing personal cars and your home?",
    description: "Separates lifestyle consumption assets from productive income-generating capital to assess your true financial freedom."
  }
];

const journeyStages = [
  {
    step: "01",
    title: "Starting Out",
    timeline: "First Earnings",
    focus: "Disciplined Cash Flow",
    description: "Establishing sound budgeting, creating a 25%+ monthly surplus, and avoiding consumer debt traps."
  },
  {
    step: "02",
    title: "Building Stability",
    timeline: "Years 1–3",
    focus: "Emergency Safety Net",
    description: "Accumulating 6 months of essential household expenses in liquid funds and eliminating high-interest liabilities."
  },
  {
    step: "03",
    title: "Protecting Family",
    timeline: "Years 2–5",
    focus: "Pure Risk Defense",
    description: "Securing pure term life cover (15x annual income) and standalone comprehensive health insurance."
  },
  {
    step: "04",
    title: "Growing Wealth",
    timeline: "Years 4–10",
    focus: "Long-Term Compounding",
    description: "Building automated mutual fund SIPs aligned to your risk tolerance, with annual step-ups as income increases."
  },
  {
    step: "05",
    title: "Achieving Milestones",
    timeline: "Years 8–18",
    focus: "Goal Realization",
    description: "Systematically funding children's higher education and home equity without compromising retirement reserves."
  },
  {
    step: "06",
    title: "Financial Independence",
    timeline: "Retirement & Beyond",
    focus: "Sustainable Cash Flow",
    description: "Deploying a multi-bucket distribution strategy to generate steady, inflation-protected monthly income for life."
  }
];

const learnArticles = [
  {
    category: "Milestones",
    readTime: "5 min read",
    title: "How Much Should You Save for a Future Goal? Time, Inflation & Compounding",
    summary: "Discover how real-world education and lifestyle inflation affect future costs, and how time horizon changes the monthly SIP required.",
    takeaway: "Education inflation in India often runs at 8%–10%, requiring earlier starts and disciplined equity allocation."
  },
  {
    category: "Loans & Debt",
    readTime: "5 min read",
    title: "Should You Prepay Your Home Loan or Invest? The Mathematical Trade-offs",
    summary: "Understand the key considerations between prepaying home loan principal early versus building a parallel mutual fund wealth fund.",
    takeaway: "Balancing psychological peace with long-term compound wealth often yields the most resilient outcome."
  },
  {
    category: "Family Safety",
    readTime: "5 min read",
    title: "How Much Emergency Fund Does an Indian Family Truly Need?",
    summary: "A practical guide to calculating your essential monthly expenses, where to park emergency funds, and why liquidity comes before returns.",
    takeaway: "Park 6–9 months of true essentials in liquid funds and sweep deposits—never in locked or volatile instruments."
  },
  {
    category: "Children's Future",
    readTime: "6 min read",
    title: "Planning for Child Higher Education in India: An Inflation-Adjusted Roadmap",
    summary: "A step-by-step framework to calculate inflation-adjusted college costs in India and abroad, and how to build the corpus systematically.",
    takeaway: "Starting when your child is in primary school can cut the required monthly investment by more than half."
  }
];

const coreValues = [
  {
    number: "01",
    title: "Client First Always",
    description: "Your family's financial security and milestone clarity are the sole priority behind every consultation and review."
  },
  {
    number: "02",
    title: "Goals Before Products",
    description: "We always identify what your money must achieve before ever discussing a mutual fund scheme or investment vehicle."
  },
  {
    number: "03",
    title: "Plain Language, Zero Jargon",
    description: "No confusing technical terms. Every concept is explained in clear, relatable terms so you feel empowered and confident."
  },
  {
    number: "04",
    title: "Patient Wealth Compounding",
    description: "We prioritize disciplined habits, asset allocation, and milestone security over short-term market speculation or chasing hot trends."
  },
  {
    number: "05",
    title: "Absolute Respect for Privacy",
    description: "Zero forced phone number gates, zero spam callbacks, and zero commercial data sharing. Your numbers stay entirely confidential."
  }
];
---

<BaseLayout 
  title="Ant Wealth Creation — Make Better Money Decisions. Build a Better Future."
  description="Goal-oriented financial guidance for Indian families. Evaluate your financial health across 7 pillars, plan life milestones, and invest with clarity from AMFI-Registered MFD C. Santhosh Sathriyan."
>
  <!-- 1. HERO SECTION -->
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="credibility-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>Independent AMFI-Registered MFD • Markets Since {BUSINESS_PROFILE.firm.experienceSince} • QPFP Discipline</span>
        </div>

        <h1 id="hero-title" class="hero-title">
          Make Better Money Decisions. Build a Better Future.
        </h1>

        <p class="hero-lead">
          Goal-oriented financial guidance for Indian families. Evaluate your family’s resilience across 7 vital pillars, plan key milestones with zero salesperson callbacks, and invest in mutual funds with complete fee transparency.
        </p>

        <div class="hero-actions">
          <a href="#financial-health" class="btn-primary-hero">
            Explore 7 Pillars of Health ↓
          </a>
          <a href="#goals" class="btn-secondary-hero">
            Plan Life Milestones ↓
          </a>
          <a href="#tools" class="btn-ghost-hero">
            Tools Preview ↓
          </a>
        </div>

        <div class="hero-trust-strip">
          <div class="trust-item">
            <span class="trust-check">✓</span>
            <span>Zero forced phone number capture</span>
          </div>
          <div class="trust-item">
            <span class="trust-check">✓</span>
            <span>AMFI commission transparency</span>
          </div>
          <div class="trust-item">
            <span class="trust-check">✓</span>
            <span>QPFP Certified financial discipline</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-image-wrapper">
          <img 
            src="/assets/homeScreenimage.webp" 
            alt="The Family Money Map — Guiding everyday Indian families through life milestones to financial freedom" 
            width="560" 
            height="380"
            class="hero-img"
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero-image-caption">
            <span class="caption-tag">The Family Money Map</span>
            <span class="caption-text">Connecting today's cash flow with tomorrow's life milestones</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE EVERYDAY PROBLEM SECTION -->
  <section id="everyday-problem" class="section section-problem" aria-labelledby="problem-heading">
    <div class="container">
      <SectionHeader 
        eyebrow="Relatable Family Finance"
        title="The Questions Indian Families Face Every Single Day"
        subtitle="Most families do not need complex derivative products or aggressive trading calls. They need clear, calm answers to practical life questions."
        centered={true}
      />

      <div class="questions-grid">
        <div class="question-card">
          <div class="question-icon">🎓</div>
          <h3 class="question-title">"Will college costs overwhelm our savings?"</h3>
          <p class="question-desc">With real education inflation running between 8% and 10%, relying on traditional savings accounts or low-yield insurance policies can leave a massive funding shortfall right when your child turns 18.</p>
        </div>

        <div class="question-card">
          <div class="question-icon">🏡</div>
          <h3 class="question-title">"Should we prepay our home loan or invest?"</h3>
          <p class="question-desc">Every extra rupee diverted toward loan prepayment provides immediate psychological peace, but completely sacrificing equity SIPs can leave you house-rich and liquid-cash poor.</p>
        </div>

        <div class="question-card">
          <div class="question-icon">🛡️</div>
          <h3 class="question-title">"Is our family truly protected if the worst happens?"</h3>
          <p class="question-desc">Many families hold multiple low-cover endowment policies paying ₹5 Lakhs to ₹10 Lakhs, mistakenly believing they are protected. A true safety net requires 15x annual income in pure term cover.</p>
        </div>

        <div class="question-card">
          <div class="question-icon">🌅</div>
          <h3 class="question-title">"How much will we actually need to retire with dignity?"</h3>
          <p class="question-desc">Healthcare costs, longer life expectancies, and ongoing living expenses require an inflation-protected corpus that continues compounding throughout 25 to 35 years of retirement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SEVEN PILLARS OF FINANCIAL HEALTH -->
  <section id="financial-health" class="section section-pillars" aria-labelledby="pillars-heading">
    <div class="container">
      <SectionHeader 
        eyebrow="Diagnostic Framework"
        title="Evaluate Your Family Across the 7 Pillars of Financial Health"
        subtitle="Before investing in any scheme or committing to major debts, assess where your foundation is solid and where dangerous vulnerabilities exist."
      />

      <div class="pillars-grid">
        {pillarsData.map((pillar) => (
          <PillarCard 
            number={pillar.number}
            name={pillar.name}
            focus={pillar.focus}
            question={pillar.question}
            benchmark={pillar.benchmark}
          />
        ))}
      </div>

      <div class="pillars-diagnostic-banner">
        <div class="diagnostic-banner-text">
          <h3 class="diagnostic-title">Self-Assessment Tooling Under Staging Verification</h3>
          <p class="diagnostic-desc">
            Our 2-minute diagnostic assessment computes your family's weighted financial health score across these 7 pillars with zero lead-wall friction. The calculation engine is currently undergoing domain specification review and will be released in an upcoming phase.
          </p>
        </div>
        <div class="diagnostic-banner-action">
          <a href="#about" class="btn-diagnostic">
            Discuss Your 7 Pillars with Santhosh →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FINANCIAL WELLBEING JOURNEY -->
  <section id="journey" class="section section-journey" aria-labelledby="journey-heading">
    <div class="container">
      <SectionHeader 
        eyebrow="Step-by-Step Roadmap"
        title="The 6 Stages of Family Financial Wellbeing"
        subtitle="Financial security is not a single product transaction. It is an evolving journey from basic stability to generational independence."
        centered={true}
      />

      <div class="journey-grid">
        {journeyStages.map((stage) => (
          <div class="journey-step-card">
            <div class="step-badge">{stage.step}</div>
            <div class="step-timeline">{stage.timeline}</div>
            <h3 class="step-title">{stage.title}</h3>
            <div class="step-focus">{stage.focus}</div>
            <p class="step-desc">{stage.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. LIFE MILESTONES & GOAL PLANNING -->
  <section id="goals" class="section section-goals" aria-labelledby="goals-heading">
    <div class="container">
      <SectionHeader 
        eyebrow="Goal-Based Planning"
        title="Map Your Most Important Life Milestones"
        subtitle="Every financial goal has its own time horizon, inflation rate, and required risk discipline. We build dedicated roadmaps for each milestone."
      />

      <div class="goals-grid">
        {goalsData.map((goal) => (
          <GoalCard 
            title={goal.title}
            horizon={goal.horizon}
            iconText={goal.iconText}
            coreQuestion={goal.coreQuestion}
            planningInsight={goal.planningInsight}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. MATHEMATICAL TOOLS PREVIEW -->
  <section id="tools" class="section section-tools" aria-labelledby="tools-heading">
    <div class="container">
      <SectionHeader 
        eyebrow="Calculation Engines"
        title="Simulators Designed to Answer Practical Questions"
        subtitle="A preview of our upcoming question-driven mathematical simulators. Every engine is being built with verified formulas and strict domain isolation."
      />

      <div class="tools-grid">
        {toolsData.map((tool) => (
          <ToolPreviewCard 
            title={tool.title}
            category={tool.category}
            realQuestion={tool.realQuestion}
            description={tool.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. LEARNING CENTER HIGHLIGHTS -->
  <section id="learn" class="section section-learn" aria-labelledby="learn-heading">
    <div class="container">
      <SectionHeader 
        eyebrow="Financial Education"
        title="Learn the Fundamentals of Money"
        subtitle="Simple, jargon-free educational guides written to help everyday Indian families make informed, confident choices."
        centered={true}
      />

      <div class="learn-grid">
        {learnArticles.map((article) => (
          <article class="learn-card">
            <div class="learn-meta">
              <span class="learn-category">{article.category}</span>
              <span class="learn-read-time">{article.readTime}</span>
            </div>
            <h3 class="learn-title">{article.title}</h3>
            <p class="learn-summary">{article.summary}</p>
            <div class="learn-takeaway">
              <span class="takeaway-label">Key Takeaway:</span>
              <p class="takeaway-text">{article.takeaway}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. ABOUT & FOUNDER PROFILE -->
  <section id="about" class="section section-about" aria-labelledby="about-heading">
    <div class="container">
      <div class="about-grid">
        <div class="about-visual">
          <div class="founder-card">
            <img 
              src={BUSINESS_PROFILE.founder.photoPath} 
              alt={`${BUSINESS_PROFILE.founder.fullName}, Founder of Ant Wealth Creation`} 
              width="320" 
              height="320"
              class="founder-photo"
              loading="lazy"
            />
            <div class="founder-info-bar">
              <h3 class="founder-name">{BUSINESS_PROFILE.founder.fullName}</h3>
              <p class="founder-creds">{BUSINESS_PROFILE.founder.credentials}</p>
              <p class="founder-exp">Active in Financial Markets Since {BUSINESS_PROFILE.firm.experienceSince}</p>
            </div>
          </div>
        </div>

        <div class="about-text-content">
          <span class="eyebrow">About the Founder & Philosophy</span>
          <h2 id="about-heading" class="about-title">
            "My goal is simple — to help everyday families make better financial decisions and build lasting wealth with peace of mind."
          </h2>

          <div class="about-narrative">
            <p>
              {BUSINESS_PROFILE.founder.heritage}
            </p>
            <p>
              {BUSINESS_PROFILE.founder.bio}
            </p>
            <p>
              {BUSINESS_PROFILE.founder.foundingStory}
            </p>
          </div>

          <div class="about-service-distinction">
            <h4 class="distinction-title">Clear Regulatory Distinction of Services:</h4>
            <p class="distinction-text">
              Ant Wealth Creation is an AMFI-Registered Mutual Fund Distributor. We receive trailing commissions from Asset Management Companies (AMCs) for mutual fund distribution. We do not charge fees for investment advice or claim to be a SEBI-registered Investment Adviser (RIA). Our educational simulators and roadmaps are provided for personal financial simulation and planning clarity.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. HOW WE WORK / CORE PRINCIPLES -->
  <section class="section section-values" aria-labelledby="values-heading">
    <div class="container">
      <SectionHeader 
        eyebrow="Operating Discipline"
        title="Our Core Principles & Commitment to You"
        subtitle="Built on patience, transparency, and lifelong partnership with families. We hold zero tolerance for aggressive sales pressure."
        centered={true}
      />

      <div class="values-grid">
        {coreValues.map((val) => (
          <div class="value-card">
            <span class="value-number">{val.number}</span>
            <h3 class="value-title">{val.title}</h3>
            <p class="value-desc">{val.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. TRANSPARENT CONSULTATION EXPECTATIONS -->
  <section class="section section-consult" aria-labelledby="consult-heading">
    <div class="container">
      <div class="consult-card">
        <SectionHeader 
          eyebrow="Direct Guidance"
          title="What Happens When You Speak with Santhosh?"
          subtitle="A transparent 20-minute conversation structured to bring simplicity, calm, and direction to your family finances."
          centered={true}
        />

        <div class="consult-steps-grid">
          <div class="consult-step">
            <div class="consult-step-num">Step 1</div>
            <h3 class="consult-step-title">We Understand Your Situation</h3>
            <p class="consult-step-desc">We listen to your current monthly cash flows, existing savings, insurance policies, and family context in complete confidence.</p>
          </div>

          <div class="consult-step">
            <div class="consult-step-num">Step 2</div>
            <h3 class="consult-step-title">We Clarify Goals & Timelines</h3>
            <p class="consult-step-desc">We identify what you want your money to accomplish—from children's college and home purchase to retirement freedom.</p>
          </div>

          <div class="consult-step">
            <div class="consult-step-num">Step 3</div>
            <h3 class="consult-step-title">We Explore Disciplined Pathways</h3>
            <p class="consult-step-desc">We review practical asset allocations and actionable steps—with zero obligation or pressure to transfer existing investments.</p>
          </div>
        </div>

        <div class="consult-actions">
          <a 
            href={BUSINESS_PROFILE.contact.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-whatsapp"
          >
            Chat with Santhosh on WhatsApp ↗
          </a>
          <a 
            href={`tel:${BUSINESS_PROFILE.contact.phone}`} 
            class="btn-phone"
          >
            Call {BUSINESS_PROFILE.contact.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     HERO SECTION
     ========================================================================== */
  .hero-section {
    padding: var(--space-12) 0 var(--space-16);
    background: linear-gradient(180deg, #FFFFFF 0%, var(--primitive-slate-50) 100%);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  .credibility-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.85rem;
    background-color: var(--primitive-teal-50);
    border: 1px solid var(--primitive-teal-100);
    color: var(--color-text-brand);
    font-size: var(--text-caption);
    font-weight: 700;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-4);
    letter-spacing: 0.02em;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--primitive-teal-600);
  }

  .hero-title {
    font-size: var(--text-display);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--color-brand-primary);
    line-height: 1.1;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .btn-primary-hero {
    background-color: var(--color-brand-primary);
    color: var(--primitive-white);
    font-size: var(--text-body-sm);
    font-weight: 700;
    padding: 0.85rem 1.65rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-subtle);
  }

  .btn-primary-hero:hover {
    background-color: var(--primitive-navy-800);
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }

  .btn-secondary-hero {
    background-color: var(--primitive-teal-700);
    color: var(--primitive-white);
    font-size: var(--text-body-sm);
    font-weight: 700;
    padding: 0.85rem 1.65rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-secondary-hero:hover {
    background-color: var(--primitive-teal-600);
    transform: translateY(-1px);
  }

  .btn-ghost-hero {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1.5px solid var(--color-border-medium);
    font-size: var(--text-body-sm);
    font-weight: 600;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
