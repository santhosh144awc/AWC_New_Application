<script>
  function initTestimonialsSlider() {
    const track = document.getElementById('reviews-track');
    const prevBtn = document.getElementById('reviews-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('reviews-next-btn') as HTMLButtonElement | null;
    const counter = document.getElementById('reviews-counter');
    const dotsContainer = document.getElementById('reviews-dots');

    if (!track || !prevBtn || !nextBtn || !counter || !dotsContainer) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>('.review-card'));
    const totalCards = cards.length;
    if (totalCards === 0) return;

    const getScrollStep = (): number => {
      if (cards.length < 2) return cards[0].offsetWidth;
      return cards[1].offsetLeft - cards[0].offsetLeft;
    };

    const getMetrics = () => {
      const step = getScrollStep();
      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
      const totalSlides = step > 0 ? Math.max(1, Math.round(maxScroll / step) + 1) : 1;
      return { step, maxScroll, totalSlides };
    };

    const syncDotsCount = (totalSlides: number) => {
      const existingDots = dotsContainer.querySelectorAll('.slider-dot');
      if (existingDots.length === totalSlides) return;

      dotsContainer.innerHTML = '';
      for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `slider-dot${i === 0 ? ' active' : ''}`;
        dot.dataset.slide = String(i);
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        dot.addEventListener('click', () => {
          const { totalSlides: currentTotal } = getMetrics();
          track.scrollTo({ left: getSlideTarget(i, currentTotal), behavior: 'smooth' });
        });
        dotsContainer.appendChild(dot);
      }
    };

    const getSlideTarget = (index: number, totalSlides: number): number => {
      const { step, maxScroll } = getMetrics();
      if (totalSlides <= 1) return 0;
      if (index >= totalSlides - 1) return maxScroll;
      if (index <= 0) return 0;
      return Math.min(maxScroll, index * step);
    };

    const getCurrentSlideIndex = (totalSlides: number, step: number, maxScroll: number): number => {
      if (totalSlides <= 1 || step <= 0) return 0;
      if (track.scrollLeft >= maxScroll - 20) {
        return totalSlides - 1;
      }
      return Math.min(totalSlides - 1, Math.max(0, Math.round(track.scrollLeft / step)));
    };

    const updateUI = () => {
      const { step, maxScroll, totalSlides } = getMetrics();
      syncDotsCount(totalSlides);

      const activeSlide = getCurrentSlideIndex(totalSlides, step, maxScroll);

      const currentFormatted = String(activeSlide + 1).padStart(2, '0');
      const totalFormatted = String(totalSlides).padStart(2, '0');
      counter.textContent = `${currentFormatted} / ${totalFormatted}`;

      prevBtn.disabled = false;
      nextBtn.disabled = false;

      const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.slider-dot'));
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeSlide);
        dot.setAttribute('aria-current', idx === activeSlide ? 'true' : 'false');
      });
    };

    prevBtn.addEventListener('click', () => {
      const { step, maxScroll, totalSlides } = getMetrics();
      const current = getCurrentSlideIndex(totalSlides, step, maxScroll);
      const prevIndex = current <= 0 ? totalSlides - 1 : current - 1;
      track.scrollTo({ left: getSlideTarget(prevIndex, totalSlides), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      const { step, maxScroll, totalSlides } = getMetrics();
      const current = getCurrentSlideIndex(totalSlides, step, maxScroll);
      const nextIndex = current >= totalSlides - 1 ? 0 : current + 1;
      track.scrollTo({ left: getSlideTarget(nextIndex, totalSlides), behavior: 'smooth' });
    });

    track.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextBtn.click();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevBtn.click();
      }
    });

    let isDown = false;
    let startX = 0;
    let scrollStart = 0;

    track.addEventListener('mousedown', (e: MouseEvent) => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollStart = track.scrollLeft;
    });

    const stopDrag = () => {
      isDown = false;
    };

    track.addEventListener('mouseleave', stopDrag);
    track.addEventListener('mouseup', stopDrag);
    track.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.4;
      track.scrollLeft = scrollStart - walk;
    });

    track.addEventListener('scroll', () => {
      window.requestAnimationFrame(updateUI);
    }, { passive: true });

    window.addEventListener('resize', () => {
      window.requestAnimationFrame(updateUI);
    });

    updateUI();
  }

  initTestimonialsSlider();
  document.addEventListener('astro:page-load', initTestimonialsSlider);
</script>
