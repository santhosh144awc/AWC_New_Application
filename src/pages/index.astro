---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_PROFILE } from '../layouts/../config/businessProfile';
import { CLIENT_TESTIMONIALS } from '../config/testimonials';

const approvedArticles = await getCollection('articles', ({ data }) => {
  return data.publicationStatus === 'APPROVED';
});

approvedArticles.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const featuredArticles = approvedArticles.slice(0, 3);

const coreServices = [
  {
    tag: 'AMFI-Registered · ARN-266896',
    icon: '📈',
    title: 'Mutual Fund Distribution',
    summary:
      'Build long-term wealth through disciplined monthly SIPs, Step-Up SIPs, Lump Sum investments, and retirement SWP cash-flow portfolios across equity, hybrid, debt, and liquid funds.',
    highlights: [
      'Goal-linked portfolios for education, home & retirement',
      'Asset allocation tailored to your risk comfort & timeline',
      'Dedicated client portfolio tracking via TheMFBox portal',
    ],
    ctaLabel: 'Explore SIP & Wealth Calculators →',
    ctaHref: '/tools/sip/',
    tint: 'mint',
  },
  {
    tag: 'LIC Life Insurance Advisor',
    icon: '🛡️',
    title: 'Life Insurance & Term Cover',
    summary:
      'Protect the people who depend on your income. We help you evaluate your family’s true protection gap—covering living costs, active loans, and future children’s milestones.',
    highlights: [
      'Pure term life insurance & family income replacement',
      'Needs-based protection sizing (no high-pressure sales)',
      'Rooted in decades of second-generation LIC service heritage',
    ],
    ctaLabel: 'Check Your Life Cover Need →',
    ctaHref: '/tools/life-insurance/',
    tint: 'sand',
  },
  {
    tag: 'Star Health Insurance Agent',
    icon: '🏥',
    title: 'Health & Medical Insurance',
    summary:
      'A single unexpected hospitalization can wipe out years of disciplined savings. We help families put a reliable medical shield in place before market-linked investing.',
    highlights: [
      'Family floater & individual medical insurance plans',
      'Senior citizen & parents’ health protection guidance',
      'Dedicated support for policy selection & renewals',
    ],
    ctaLabel: 'Discuss Health Cover on WhatsApp ↗',
    ctaHref: BUSINESS_PROFILE.contact.whatsappUrl,
    external: true,
    tint: 'mist',
  },
  {
    tag: 'QPFP Certified Guidance',
    icon: '🧭',
    title: 'Personal Finance & Goal Planning',
    summary:
      'Practical, jargon-free guidance to organize your household cash flow, build an emergency reserve, balance loan prepayments against investments, and map every family goal.',
    highlights: [
      'Complete 6-Stage Household Personal Finance Statement',
      'Children’s higher education & marriage funding roadmaps',
      'Home loan prepayment vs SIP & retirement planning',
    ],
    ctaLabel: 'Open Personal Finance Statement →',
    ctaHref: '/tools/personal-finance-statement/',
    tint: 'mint',
  },
];

const laymanSteps = [
  {
    step: 'Step 01',
    title: 'Know Where Your Money Goes',
    subtitle: 'Cash Flow, Emergency Cushion & True Net Worth',
    description:
      'Good personal finance starts with clarity. Before buying any financial product, map your family’s monthly income, essential living expenses, existing EMIs, and keep 3 to 6 months of expenses in a safe emergency reserve.',
    actionLabel: 'Try the 2-Minute Health Check →',
    actionHref: '/health-check/',
  },
  {
    step: 'Step 02',
    title: 'Protect Your Family First',
    subtitle: 'Health Insurance & Pure Term Life Cover',
    description:
      'Before chasing investment returns, build a strong safety wall around your family. Adequate Health Insurance protects your savings from hospital bills, and Term Life Insurance ensures your family’s lifestyle and goals are never disrupted.',
    actionLabel: 'Estimate Family Life Cover →',
    actionHref: '/tools/life-insurance/',
  },
  {
    step: 'Step 03',
    title: 'Invest With Purpose for Life Goals',
    subtitle: 'Disciplined Mutual Fund SIPs & Asset Allocation',
    description:
      'Give every rupee a clear purpose and timeline. By linking your monthly mutual fund SIPs and lump-sum investments to real milestones—children’s college, a debt-free home, and retirement—you stay calm through market ups and downs.',
    actionLabel: 'Explore Goal Roadmaps →',
    actionHref: '/plan/',
  },
];

const diagnosticTools = [
  {
    badge: 'Flagship 6-Stage Diagnostic + PDF',
    title: 'Personal Finance Statement',
    question: 'Want a complete picture of your household income, expenses, assets, debts, and net worth?',
    desc: 'Organize your family finances across 6 clear stages and download a 5-page client-ready PDF statement—100% locally in your browser.',
    href: '/tools/personal-finance-statement/',
    cta: 'Open Personal Finance Statement →',
    featured: true,
  },
  {
    badge: '2-Minute Self-Check',
    title: '7-Pillar Financial Health Check',
    question: 'How strong are your emergency reserves, insurance cover, and savings habits?',
    desc: 'Answer seven simple questions to see where your household finances are strong and what to prioritize next.',
    href: '/health-check/',
    cta: 'Start 2-Minute Checkup →',
    featured: false,
  },
  {
    badge: '2-Minute Balance Sheet',
    title: 'Quick Net Worth Snapshot',
    question: 'What does your family own and owe right now?',
    desc: 'Separate personal-use property (like your home and car) from productive financial assets that can fund future goals.',
    href: '/tools/net-worth/',
    cta: 'Open Net Worth Snapshot →',
    featured: false,
  },
];

const quickCalculators = [
  { label: 'SIP Wealth Simulator', category: 'Monthly Investing', href: '/tools/sip/' },
  { label: 'Lump Sum Calculator', category: 'One-Time Investing', href: '/tools/lumpsum/' },
  { label: 'Step-Up SIP Growth', category: 'Annual Step-Ups', href: '/tools/sip-growth/' },
  { label: 'Children’s Future Planner', category: 'Education & Marriage', href: '/plan/children/' },
  { label: 'Home Purchase Planner', category: 'Down Payment & EMI', href: '/plan/home-purchase/' },
  { label: 'Retirement Corpus Planner', category: 'Lifelong Nest Egg', href: '/plan/retirement/' },
  { label: '3-Bucket Retirement Income', category: 'Post-Retirement Cash Flow', href: '/plan/retirement-income/' },
  { label: 'SWP Monthly Income', category: 'Systematic Withdrawal', href: '/tools/swp/' },
  { label: 'Loan Prepayment vs SIP', category: 'Debt vs Investment', href: '/tools/home-loan-foreclosure/' },
  { label: 'Loan Interest Recovery SIP', category: 'Borrowing Cost Offset', href: '/tools/loan-sip-recovery/' },
  { label: 'Life Insurance Needs Audit', category: 'Family Protection', href: '/tools/life-insurance/' },
];
---

<BaseLayout
  title={`${BUSINESS_PROFILE.firm.name} — Mutual Funds, Life & Health Insurance & Personal Finance Guidance`}
  description="Ant Wealth Creation helps Indian families understand personal finance, protect their loved ones with Life and Health Insurance, and build lasting wealth through goal-based Mutual Fund investments."
  currentPath="/"
>
  <div class="container home-page">
    <!-- 1. HERO: COMPANY IDENTITY & EXECUTIVE DIGITAL VISITING CARD -->
    <section class="hero surface-dark" aria-labelledby="hero-heading">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow-light">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            Ant Wealth Creation · Mutual Funds · Life &amp; Health Insurance
          </div>

          <h1 id="hero-heading">
            Helping Indian families protect what matters and build lasting wealth.
          </h1>

          <p class="hero-lead">
            Personal finance does not have to be complicated. Whether you want to start disciplined <strong>Mutual Fund investments</strong>, safeguard your family with the right <strong>Life and Health Insurance</strong>, or plan step-by-step for your children’s education and retirement—we guide you with clarity, patience, and transparency.
          </p>

          <div class="hero-cta-row">
            <a
              class="btn-hero-gold"
              href={BUSINESS_PROFILE.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Chat with {BUSINESS_PROFILE.founder.shortName} on WhatsApp ↗
            </a>
            <a class="btn-hero-ghost" href="#services">
              Explore Our Services ↓
            </a>
            <a class="btn-hero-ghost" href="#personal-finance-guide">
              How Personal Finance Works ↓
            </a>
          </div>

          <div class="hero-trust" role="list" aria-label="Core practice credentials">
            <div class="trust-item" role="listitem">
              <strong>Mutual Fund Distribution</strong>
              <span>AMFI-Registered ({BUSINESS_PROFILE.regulatory.arn})</span>
            </div>
            <div class="trust-item" role="listitem">
              <strong>Life &amp; Health Protection</strong>
              <span>LIC Advisor &amp; Star Health Agent</span>
            </div>
            <div class="trust-item" role="listitem">
              <strong>Personal Finance Guidance</strong>
              <span>QPFP Certified · Markets Since {BUSINESS_PROFILE.firm.experienceSince}</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Digital Visiting Card of C. Santhosh Sathriyan -->
        <aside class="visiting-card" aria-label="Advisor Digital Visiting Card">
          <div class="vc-header">
            <img
              src={BUSINESS_PROFILE.founder.photoPath}
              alt={BUSINESS_PROFILE.founder.fullName}
              width="84"
              height="84"
              class="vc-avatar"
            />
            <div class="vc-identity">
              <span class="vc-badge">Founder &amp; Financial Guide</span>
              <h2 class="vc-name">{BUSINESS_PROFILE.founder.fullName}</h2>
              <p class="vc-creds">{BUSINESS_PROFILE.founder.credentials}</p>
              <p class="vc-location">📍 {BUSINESS_PROFILE.firm.headquarters} · Serving Clients Across India</p>
            </div>
          </div>

          <blockquote class="vc-quote">
            “{BUSINESS_PROFILE.founder.quote}”
          </blockquote>

          <div class="vc-services-box">
            <span class="vc-box-label">Products &amp; Services We Provide</span>
            <div class="vc-pills">
              <span class="vc-pill">Mutual Funds (SIP / Lump Sum / SWP)</span>
              <span class="vc-pill">Life Insurance (LIC)</span>
              <span class="vc-pill">Health Insurance (Star Health)</span>
              <span class="vc-pill">Goal &amp; Retirement Planning</span>
            </div>
          </div>

          <div class="vc-contact-strip">
            <a href={`tel:${BUSINESS_PROFILE.contact.phone}`} class="vc-contact-item">
              <span class="vc-contact-lbl">Direct Phone</span>
              <strong>{BUSINESS_PROFILE.contact.phoneDisplay}</strong>
            </a>
            <a href={`mailto:${BUSINESS_PROFILE.contact.email}`} class="vc-contact-item">
              <span class="vc-contact-lbl">Email</span>
              <strong>{BUSINESS_PROFILE.contact.email}</strong>
            </a>
          </div>

          <div class="vc-actions">
            <a
              href={BUSINESS_PROFILE.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-vc-primary"
            >
              Message on WhatsApp ↗
            </a>
            <a
              href={BUSINESS_PROFILE.contact.portfolioLoginUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-vc-secondary"
            >
              Client Portfolio Login ↗
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- 2. WHAT WE OFFER: PRODUCTS & SERVICES -->
    <section class="section" id="services" aria-labelledby="services-heading">
      <div class="section-head">
        <div>
          <div class="eyebrow">What We Offer · Products &amp; Services</div>
          <h2 id="services-heading">Complete Protection &amp; Wealth Solutions for Your Family</h2>
        </div>
        <p>
          Everything you need to safeguard your family against life’s uncertainties and grow your savings systematically—explained in plain language.
        </p>
      </div>

      <div class="services-grid">
        {coreServices.map((service) => (
          <article class={`service-card tint-${service.tint}`}>
            <div class="service-top">
              <span class="service-icon" aria-hidden="true">{service.icon}</span>
              <span class="service-tag">{service.tag}</span>
            </div>

            <h3 class="service-title">{service.title}</h3>
            <p class="service-summary">{service.summary}</p>

            <ul class="service-list">
              {service.highlights.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>

            <a
              href={service.ctaHref}
              class="service-cta"
              target={service.external ? '_blank' : undefined}
              rel={service.external ? 'noopener noreferrer' : undefined}
            >
              {service.ctaLabel}
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- 3. PERSONAL FINANCE FOR EVERY LAYMAN (3 SIMPLE STEPS) -->
    <section class="section" id="personal-finance-guide" aria-labelledby="layman-heading">
      <div class="layman-banner">
        <div class="section-head">
          <div>
            <div class="eyebrow">Personal Finance Simplified</div>
            <h2 id="layman-heading">New to Personal Finance? Here Is How It Works in 3 Simple Steps</h2>
          </div>
          <p>
            You do not need complex financial jargon to manage money well. Every strong family financial plan follows this simple order:
          </p>
        </div>

        <div class="steps-grid">
          {laymanSteps.map((st) => (
            <div class="step-card">
              <span class="step-badge">{st.step}</span>
              <h3 class="step-title">{st.title}</h3>
              <p class="step-subtitle">{st.subtitle}</p>
              <p class="step-desc">{st.description}</p>
              <a href={st.actionHref} class="step-link">{st.actionLabel}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. WHY FAMILIES TRUST ANT WEALTH CREATION (ABOUT SANTHOSH) -->
    <section class="section" id="about" aria-labelledby="about-heading">
      <div class="about-card">
        <div class="about-photo-col">
          <img
            src={BUSINESS_PROFILE.founder.photoPath}
            alt={BUSINESS_PROFILE.founder.fullName}
            width="280"
            height="340"
            loading="lazy"
            class="founder-photo"
          />
        </div>
        <div class="about-copy-col">
          <div class="eyebrow">Our Story &amp; Heritage</div>
          <h2 id="about-heading">Personal Guidance Rooted in Trust Since {BUSINESS_PROFILE.firm.experienceSince}</h2>
          <p class="founder-role">
            {BUSINESS_PROFILE.founder.fullName} · {BUSINESS_PROFILE.founder.designation} ({BUSINESS_PROFILE.founder.credentials})
          </p>
          <p class="founder-bio">{BUSINESS_PROFILE.founder.bio}</p>
          <p class="founder-bio" style="margin-top: 10px;">{BUSINESS_PROFILE.founder.heritage}</p>

          <div class="promises-grid">
            <div class="promise-item">
              <strong>01 · Protection Before Products</strong>
              <span>We ensure emergency funds, health cover, and term insurance are in place first.</span>
            </div>
            <div class="promise-item">
              <strong>02 · Clarity Over Jargon</strong>
              <span>Every mutual fund or insurance option is explained simply so you decide with confidence.</span>
            </div>
            <div class="promise-item">
              <strong>03 · Goal-Driven Discipline</strong>
              <span>No speculative tips—investments are mapped to your family’s real timelines.</span>
            </div>
            <div class="promise-item">
              <strong>04 · Regulated &amp; Transparent</strong>
              <span>AMFI-registered distributor ({BUSINESS_PROFILE.regulatory.arn}) with full commission transparency.</span>
            </div>
          </div>

          <div class="about-actions">
            <a class="btn-primary" href="/about/">Read Full Story &amp; Credentials →</a>
            <a class="btn-secondary" href="/commission-disclosure/">How We Are Compensated →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. REAL CLIENT EXPERIENCES (TESTIMONIALS) -->
    <section class="section" id="testimonials" aria-labelledby="testimonials-heading">
      <div class="section-head">
        <div>
          <div class="eyebrow">Client Reviews &amp; Experiences</div>
          <h2 id="testimonials-heading">Trusted by Families, Professionals &amp; Business Owners</h2>
        </div>
        <p>
          Read genuine experiences shared by our clients across mutual fund portfolio management, term and health insurance, and personal finance mentoring.
        </p>
      </div>

      <div class="testimonials-grid">
        {CLIENT_TESTIMONIALS.map((item) => (
          <article class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar" aria-hidden="true">
                {item.photoPath ? (
                  <img src={item.photoPath} alt={item.name} width="48" height="48" loading="lazy" />
                ) : (
                  <span class="avatar-initials">{item.initials}</span>
                )}
              </div>
              <div class="testimonial-author">
                <h3 class="author-name">{item.name}</h3>
                <p class="author-role">{item.companyOrOrg ? `${item.role} · ${item.companyOrOrg}` : item.role}</p>
              </div>
            </div>

            <span class="testimonial-highlight">Verified Client Review</span>

            <blockquote class="testimonial-quote">
              “{item.quote}”
            </blockquote>
          </article>
        ))}
      </div>
    </section>

    <!-- 6. SUPPORTING PERSONAL FINANCE TOOLS & CALCULATORS -->
    <section class="section" id="interactive-tools-workbench" aria-labelledby="workbench-heading">
      <div class="section-head">
        <div>
          <div class="eyebrow">Free Supporting Tools &amp; Diagnostics</div>
          <h2 id="workbench-heading">Explore Your Numbers at Your Own Pace</h2>
        </div>
        <p>
          We built these free, browser-private tools to help you understand your household finances and test scenarios before or during our consultation.
        </p>
      </div>

      <!-- 3 Household Diagnostics -->
      <div class="diagnostics-grid">
        {diagnosticTools.map((tool) => (
          <a href={tool.href} class={`diag-card ${tool.featured ? 'is-featured' : ''}`}>
            <div class="diag-top">
              <span class="diag-badge">{tool.badge}</span>
            </div>
            <h3 class="diag-title">{tool.title}</h3>
            <p class="diag-question">“{tool.question}”</p>
            <p class="diag-desc">{tool.desc}</p>
            <span class="diag-cta">{tool.cta}</span>
          </a>
        ))}
      </div>

      <!-- Compact Supporting Calculators Grid -->
      <div class="calculators-subhead">
        <h3>Quick Goal, SIP &amp; Loan Calculators</h3>
        <a href="/tools/" class="view-all-link">Open Full Tools Directory →</a>
      </div>

      <div class="workbench-grid">
        {quickCalculators.map((calc) => (
          <a href={calc.href} class="workbench-card">
            <span class="workbench-cat">{calc.category}</span>
            <h4 class="workbench-title">{calc.label} →</h4>
          </a>
        ))}
      </div>
    </section>

    <!-- 7. LEARNING LIBRARY PREVIEW -->
    <section class="section" id="learn" aria-labelledby="learn-heading">
      <div class="section-head">
        <div>
          <div class="eyebrow">Plain-Language Financial Guides</div>
          <h2 id="learn-heading">Learn the Basics of Smart Money Management</h2>
        </div>
        <p>
          Short, practical articles written for Indian families—covering SIPs, emergency reserves, asset allocation, and life insurance.
        </p>
      </div>

      <div class="learn-grid">
        {featuredArticles.map((article) => (
          <article class="article-card">
            <div class="article-meta">
              <span>{article.data.category}</span>
              <span>{article.data.readingTime}</span>
            </div>
            <h3>
              <a href={`/learn/${article.id}/`}>{article.data.title}</a>
            </h3>
            <p>{article.data.description}</p>
            <a class="card-cta" href={`/learn/${article.id}/`}>
              Read guide →
            </a>
          </article>
        ))}
      </div>

      <div class="section-foot">
        <a class="btn-secondary" href="/learn/">Browse all {approvedArticles.length} educational guides →</a>
      </div>
    </section>

    <!-- 8. CONTACT & DIRECT CONSULTATION -->
    <section class="section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-band surface-dark">
        <div class="contact-copy">
          <div class="eyebrow-light">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            Direct 1-on-1 Consultation
          </div>
          <h2 id="contact-heading">Ready to organize your family’s financial future?</h2>
          <p>
            Reach out directly to <strong>{BUSINESS_PROFILE.founder.fullName}</strong> for a friendly, no-obligation conversation about Mutual Funds, Life Insurance, Health Insurance, or your family’s financial goals.
          </p>
          <div class="contact-cta-row">
            <a
              class="btn-hero-gold"
              href={BUSINESS_PROFILE.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Chat with {BUSINESS_PROFILE.founder.shortName} on WhatsApp ↗
            </a>
            <a class="btn-hero-ghost" href="/contact/">
              Consultation details &amp; office info →
            </a>
          </div>
        </div>
        <div class="contact-details">
          <div class="contact-detail-card">
            <span>Direct Phone</span>
            <strong><a href={`tel:${BUSINESS_PROFILE.contact.phone}`}>{BUSINESS_PROFILE.contact.phoneDisplay}</a></strong>
          </div>
          <div class="contact-detail-card">
            <span>Email</span>
            <strong><a href={`mailto:${BUSINESS_PROFILE.contact.email}`}>{BUSINESS_PROFILE.contact.email}</a></strong>
          </div>
          <div class="contact-detail-card">
            <span>Office Location</span>
            <strong>{BUSINESS_PROFILE.firm.headquarters}</strong>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    padding-top: 22px;
    padding-bottom: 48px;
  }

  /* Eyebrows */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--awc-jade-deep);
  }

  .eyebrow-light {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--primitive-teal-100);
    font-size: 12px;
    font-weight: 700;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--awc-gold);
  }

  /* 1. HERO & DIGITAL VISITING CARD */
  .hero {
    padding: 36px;
    border-radius: 32px;
    background:
      radial-gradient(circle at 86% 18%, rgba(242, 198, 93, 0.2), transparent 26%),
      radial-gradient(circle at 70% 80%, rgba(22, 135, 126, 0.28), transparent 34%),
      linear-gradient(135deg, var(--awc-navy) 0%, var(--primitive-navy-800) 58%, var(--primitive-teal-700) 100%);
    color: var(--primitive-white);
    box-shadow: var(--shadow-elevated);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 28px;
    align-items: center;
  }

  .hero h1 {
    margin: 16px 0 14px;
    font-size: clamp(32px, 4.3vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.04em;
    font-weight: 850;
    color: var(--primitive-white);
  }

  .hero-lead {
    margin: 0;
    max-width: 58ch;
    color: var(--color-text-on-dark);
    font-size: 16px;
    line-height: 1.65;
  }

  .hero-lead strong {
    color: var(--primitive-white);
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .btn-hero-gold,
  .btn-hero-ghost,
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease, filter 0.15s ease;
  }

  .btn-hero-gold {
    background: var(--awc-gold);
    color: var(--awc-navy);
  }

