---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_PROFILE } from '../config/businessProfile';
import { CLIENT_TESTIMONIALS } from '../config/testimonials';

const approvedArticles = await getCollection('articles', ({ data }) => {
  return data.publicationStatus === 'APPROVED';
});

approvedArticles.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const featuredArticles = approvedArticles.slice(0, 3);

const servicePillars = [
  {
    number: '01 / Protection First',
    title: 'Life & Health Insurance',
    subtitle: 'LIC Advisor & Star Health Insurance Agent',
    description:
      'Before investing in the market, we make sure your family is protected against medical emergencies and unexpected loss of income.',
    points: [
      'Pure Term Life Insurance for family income security',
      'Family Floater & Senior Citizen Health Insurance',
      'Honest, needs-based coverage sizing without high-pressure sales',
    ],
    ctaLabel: 'Estimate your family protection need →',
    ctaHref: '/tools/life-insurance/',
  },
  {
    number: '02 / Wealth Creation',
    title: 'Mutual Fund Distribution',
    subtitle: 'AMFI-Registered Distributor (ARN-266896)',
    description:
      'Grow your savings systematically through diversified equity, hybrid, and debt mutual funds aligned with your family’s timeline and risk comfort.',
    points: [
      'Monthly SIPs, Step-Up SIPs & Lump Sum portfolios',
      'Retirement monthly income (SWP) planning',
      '24/7 online portfolio tracking via TheMFBox client portal',
    ],
    ctaLabel: 'Explore SIP & wealth calculators →',
    ctaHref: '/tools/sip/',
  },
  {
    number: '03 / Family Roadmap',
    title: 'Personal Finance Planning',
    subtitle: 'QPFP Certified Financial Guidance',
    description:
      'Understand where your money goes, organize your emergency fund, balance loan prepayments against investments, and map every family milestone.',
    points: [
      'Children’s higher education & marriage planning',
      'Home purchase & loan prepayment strategy',
      'Complete 6-Stage Household Personal Finance Statement',
    ],
    ctaLabel: 'Build your Personal Finance Statement →',
    ctaHref: '/tools/personal-finance-statement/',
  },
];

const startingTools = [
  {
    type: 'Flagship 6-Stage Tool',
    title: 'Personal Finance Statement',
    description:
      'Map your family income, expenses, assets, and liabilities, and download a client-ready 5-page PDF balance sheet.',
    ctaLabel: 'Open Statement →',
    href: '/tools/personal-finance-statement/',
    featured: true,
  },
  {
    type: '2-Minute Checkup',
    title: 'Financial Health Check',
    description:
      'Answer 7 quick questions to check your emergency reserve, EMI load, insurance cover, and retirement readiness.',
    ctaLabel: 'Start Checkup →',
    href: '/health-check/',
    featured: false,
  },
  {
    type: 'Family Milestones',
    title: 'Goal & SIP Calculators',
    description:
      'Plan inflation-adjusted targets for children’s education, home purchase, retirement corpus, and monthly SIPs.',
    ctaLabel: 'Open Calculators →',
    href: '/plan/',
    featured: false,
  },
  {
    type: 'Debt Decisions',
    title: 'Loan Prepay vs SIP',
    description:
      'Compare prepaying your home loan early against investing your monthly surplus in a diversified mutual fund SIP.',
    ctaLabel: 'Compare Options →',
    href: '/tools/home-loan-foreclosure/',
    featured: false,
  },
];
---

<BaseLayout
  title="Ant Wealth Creation | Personal Finance, Mutual Funds & Family Insurance"
  description="Ant Wealth Creation (AMFI ARN-266896), founded by C. Santhosh Sathriyan, B.E., QPFP, helps Indian families with Mutual Fund investments, LIC Life Insurance, Star Health Insurance, and clear Personal Finance planning."
>
  <div class="container home-page">
    <!-- 1. CLEAN LIGHT EDITORIAL HERO WITH 6-STEP FAMILY JOURNEY VISUAL -->
    <section class="hero-section" aria-labelledby="hero-heading">
      <div class="hero-banner">
        <div class="hero-content">
          <span class="hero-kicker">Personal Finance · Mutual Funds · Insurance</span>
          <h1 id="hero-heading">Make Better Money Decisions. Build a Better Future.</h1>
          <p>
            We help Indian families organize their household finances, protect their loved ones with the right Life and Health Insurance, and build lasting wealth through disciplined Mutual Fund investing.
          </p>
          <div class="hero-buttons">
            <a
              class="btn-primary-navy"
              href={BUSINESS_PROFILE.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Speak with {BUSINESS_PROFILE.founder.shortName} on WhatsApp ↗
            </a>
            <a class="btn-secondary-jade" href="/tools/personal-finance-statement/">
              Open Personal Finance Statement →
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <img
            src="/assets/homeScreenimage.webp"
            alt="6 Steps of Personal Finance: 1. Income, 2. Savings, 3. Protection, 4. Goals, 5. Investment, 6. Financial Freedom"
            width="900"
            height="600"
            loading="eager"
          />
        </div>
      </div>

      <!-- 4-COLUMN PRACTICE CREDENTIAL BAR -->
      <div class="trust-bar" aria-label="Practice Credentials">
        <div class="trust-col">
          <span class="trust-label">Advisor &amp; Founder</span>
          <strong class="trust-value">{BUSINESS_PROFILE.founder.fullName}, QPFP</strong>
        </div>
        <div class="trust-col">
          <span class="trust-label">Mutual Fund Distribution</span>
          <strong class="trust-value">AMFI-Registered ({BUSINESS_PROFILE.regulatory.arn})</strong>
        </div>
        <div class="trust-col">
          <span class="trust-label">Insurance Partners</span>
          <strong class="trust-value">LIC Life Cover &amp; Star Health</strong>
        </div>
        <div class="trust-col">
          <span class="trust-label">Track Record</span>
          <strong class="trust-value">Market Experience Since {BUSINESS_PROFILE.firm.experienceSince}</strong>
        </div>
      </div>
    </section>

    <!-- 2. MEET SANTHOSH (CLEAN EXECUTIVE PROFILE / DIGITAL VISITING CARD) -->
    <section class="section" id="about" aria-labelledby="about-heading">
      <div class="advisor-card">
        <div class="advisor-photo-wrap">
          <img
            src="/assets/santhosh_photo.webp"
            alt={BUSINESS_PROFILE.founder.fullName}
            width="240"
            height="280"
            loading="eager"
          />
        </div>

        <div class="advisor-body">
          <span class="section-kicker">Your Financial Guide</span>
          <h2 id="about-heading">{BUSINESS_PROFILE.founder.fullName}</h2>
          <div class="advisor-creds">
            QPFP Certified · AMFI-Registered Mutual Fund Distributor ({BUSINESS_PROFILE.regulatory.arn})
          </div>

          <blockquote class="advisor-quote">
            “{BUSINESS_PROFILE.founder.quote}”
          </blockquote>

          <p class="advisor-bio">
            With experience in Indian financial markets since {BUSINESS_PROFILE.firm.experienceSince} and raised in a family with decades of LIC service heritage, Santhosh founded {BUSINESS_PROFILE.firm.name} in {BUSINESS_PROFILE.firm.foundingYear} to give families honest, jargon-free guidance across Mutual Funds, Life Insurance, and Health Insurance—without high-pressure sales.
          </p>

          <div class="advisor-contact-row">
            <div class="contact-item">
              <span>Direct Phone &amp; WhatsApp</span>
              <strong><a href={`tel:${BUSINESS_PROFILE.contact.phone}`}>{BUSINESS_PROFILE.contact.phoneDisplay}</a></strong>
            </div>
            <div class="contact-item">
              <span>Email</span>
              <strong><a href={`mailto:${BUSINESS_PROFILE.contact.email}`}>{BUSINESS_PROFILE.contact.email}</a></strong>
            </div>
            <div class="contact-item">
              <span>Office</span>
              <strong>Dharmapuri, Tamil Nadu</strong>
            </div>
            <div class="contact-item">
              <span>Practice Details</span>
              <strong><a href="/about/">Read full profile →</a></strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. THREE CLEAN SERVICE PILLARS -->
    <section class="section" id="services" aria-labelledby="services-heading">
      <div class="section-header">
        <div>
          <span class="section-kicker">How We Help Your Family</span>
          <h2 id="services-heading">Clear Products &amp; Practical Financial Guidance</h2>
          <p>
            Everything your family needs to stay protected today and invest confidently for tomorrow—explained in plain English.
          </p>
        </div>
      </div>

      <div class="services-grid">
        {servicePillars.map((pillar) => (
          <article class="service-card">
            <span class="service-num">{pillar.number}</span>
            <h3>{pillar.title}</h3>
            <div class="service-sub">{pillar.subtitle}</div>
            <p>{pillar.description}</p>
            <ul class="service-points">
              {pillar.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <a class="service-link" href={pillar.ctaHref}>
              {pillar.ctaLabel}
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. CLIENT EXPERIENCES (ALL 8 VERIFIED CLIENT REVIEWS) -->
    <section class="section" id="testimonials" aria-labelledby="testimonials-heading">
      <div class="section-header">
        <div>
          <span class="section-kicker">Client Experiences</span>
          <h2 id="testimonials-heading">Trusted by Families, Educators &amp; Professionals</h2>
          <p>
            Genuine words from clients who partner with {BUSINESS_PROFILE.founder.shortName} and {BUSINESS_PROFILE.firm.name} for mutual fund investing, insurance protection, and long-term family planning.
          </p>
        </div>
      </div>

      <div class="reviews-grid">
        {CLIENT_TESTIMONIALS.map((item) => (
          <article class="review-card testimonial-card">
            <blockquote class="review-text">“{item.quote}”</blockquote>
            <div class="review-author">
              <div class="review-initials" aria-hidden="true">
                {item.photoPath ? (
                  <img src={item.photoPath} alt={item.name} loading="lazy" />
                ) : (
                  <span>{item.initials}</span>
                )}
              </div>
              <div>
                <h3 class="review-name">{item.name}</h3>
                <p class="review-role">
                  {item.role}
                  {item.companyOrOrg ? ` · ${item.companyOrOrg}` : ''}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. SUPPORTING SELF-CHECK TOOLS (4 CLEAN STARTING POINTS) -->
    <section class="section" id="interactive-tools-workbench" aria-labelledby="tools-heading">
      <div class="section-header section-header-row">
        <div>
          <span class="section-kicker">Free Self-Check Tools</span>
          <h2 id="tools-heading">Understand Your Numbers at Your Own Pace</h2>
          <p>
            Try our browser-private calculators to check your household balance sheet or test a goal scenario before we meet.
          </p>
        </div>
        <a class="section-link" href="/tools/">View All Tools →</a>
      </div>

      <div class="tools-row">
        {startingTools.map((tool) => (
          <a class:list={['tool-box', { featured: tool.featured }]} href={tool.href}>
            <span class="tool-type">{tool.type}</span>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <span class="tool-cta">{tool.ctaLabel}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. PLAIN-LANGUAGE GUIDES -->
    <section class="section" id="learn" aria-labelledby="learn-heading">
      <div class="section-header section-header-row">
        <div>
          <span class="section-kicker">Investor Education</span>
          <h2 id="learn-heading">Plain-Language Personal Finance Guides</h2>
          <p>
            Short, practical reads written for Indian households—without confusing textbook jargon.
          </p>
        </div>
        <a class="section-link" href="/learn/">Browse All {approvedArticles.length} Guides →</a>
      </div>

      <div class="guides-grid">
        {featuredArticles.map((article) => (
          <article class="guide-card">
            <span class="guide-meta">{article.data.category} · {article.data.readingTime}</span>
            <h3>
              <a href={`/learn/${article.id}/`}>{article.data.title}</a>
            </h3>
            <p>{article.data.description}</p>
            <a class="guide-link" href={`/learn/${article.id}/`}>Read guide →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- 7. DIRECT CONSULTATION / CONTACT -->
    <section class="section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-card">
        <div class="contact-copy">
          <span class="section-kicker">Direct 1-on-1 Consultation</span>
          <h2 id="contact-heading">Have a question about your family’s finances?</h2>
          <p>
            Reach out directly to <strong>{BUSINESS_PROFILE.founder.fullName}</strong> for a friendly, no-obligation conversation about Mutual Funds, Life Insurance, Health Insurance, or your household financial roadmap.
          </p>
          <div class="hero-buttons">
            <a
              class="btn-primary-navy"
              href={BUSINESS_PROFILE.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Message {BUSINESS_PROFILE.founder.shortName} on WhatsApp ↗
            </a>
            <a class="btn-secondary-jade" href="/contact/">
              Office Address &amp; Consultation Details →
            </a>
          </div>
        </div>

        <div class="contact-meta-grid">
          <div class="contact-meta-box">
            <span>Direct Phone &amp; WhatsApp</span>
            <strong><a href={`tel:${BUSINESS_PROFILE.contact.phone}`}>{BUSINESS_PROFILE.contact.phoneDisplay}</a></strong>
          </div>
          <div class="contact-meta-box">
            <span>Email</span>
            <strong><a href={`mailto:${BUSINESS_PROFILE.contact.email}`}>{BUSINESS_PROFILE.contact.email}</a></strong>
          </div>
          <div class="contact-meta-box">
            <span>Office Location</span>
            <strong>{BUSINESS_PROFILE.firm.headquarters}</strong>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    padding-top: 28px;
    padding-bottom: 56px;
  }

  /* 1. CLEAN LIGHT HERO WITH 6-STEP FAMILY JOURNEY VISUAL */
  .hero-section {
    padding-bottom: 44px;
  }

  .hero-banner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background-color: var(--primitive-white);
    background-image:
      linear-gradient(90deg, #FFFFFF 0%, #FFFFFF 34%, rgba(255, 255, 255, 0) 43%),
      url('/assets/homeScreenimage.webp');
    background-size: cover, contain;
    background-position: left center, right center;
    background-repeat: no-repeat;
    border: 1px solid var(--awc-line);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    min-height: 500px;
  }

  .hero-content {
    padding: 48px 24px 48px 48px;
    max-width: 530px;
    z-index: 2;
  }

  .hero-kicker,
  .section-kicker {
    display: block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--awc-jade-deep);
    margin-bottom: 10px;
  }

  .hero-content h1 {
    margin: 0 0 16px;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--awc-navy);
  }

  .hero-content p {
    margin: 0 0 26px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 48ch;
  }

  .hero-buttons {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-primary-navy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 22px;
    border-radius: 10px;
    background-color: var(--awc-navy);
    color: var(--primitive-white);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .btn-primary-navy:hover {
    background-color: var(--primitive-navy-800);
    transform: translateY(-1px);
  }

  .btn-secondary-jade {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    border-radius: 10px;
    background-color: var(--awc-jade-soft);
    color: var(--awc-jade-deep);
    border: 1px solid var(--awc-mint);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn-secondary-jade:hover {
    background-color: var(--awc-mint);
    border-color: var(--awc-jade);
  }

  .hero-visual {
    display: none;
  }

  .hero-visual img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 4-COLUMN CREDENTIAL BAR */
  .trust-bar {
    margin-top: 18px;
    padding: 18px 28px;
    background: var(--primitive-white);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .trust-col {
    border-right: 1px solid var(--awc-line);
    padding-right: 16px;
  }

  .trust-col:last-child {
    border-right: none;
    padding-right: 0;
  }

  .trust-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 3px;
  }

  .trust-value {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--awc-navy);
  }

  /* COMMON SECTION STYLING */
  .section {
    padding: 48px 0;
    border-top: 1px solid var(--awc-line);
  }

  .section-header {
    margin-bottom: 30px;
  }

  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .section-header h2 {
    margin: 0 0 8px;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--awc-navy);
  }

  .section-header p {
    margin: 0;
    max-width: 64ch;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .section-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--awc-jade-deep);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  /* 2. MEET SANTHOSH (ADVISOR PROFILE CARD) */
  .advisor-card {
    background: var(--primitive-white);
    border: 1px solid var(--awc-line);
    border-radius: 22px;
    padding: 36px;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 36px;
    align-items: center;
    box-shadow: var(--shadow-subtle);
  }

  .advisor-photo-wrap {
    text-align: center;
  }

  .advisor-photo-wrap img {
    width: 220px;
    height: 260px;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--awc-line);
    background: var(--awc-paper);
  }

  .advisor-body h2 {
    margin: 0 0 4px;
    font-size: clamp(24px, 2.6vw, 30px);
    font-weight: 800;
    color: var(--awc-navy);
    letter-spacing: -0.02em;
  }

  .advisor-creds {
    font-size: 14px;
    font-weight: 600;
    color: var(--awc-jade-deep);
    margin-bottom: 16px;
  }

  .advisor-quote {
    margin: 0 0 16px;
    font-size: 15.5px;
    font-style: italic;
    color: var(--awc-navy);
    border-left: 3px solid var(--awc-gold);
    padding-left: 16px;
    line-height: 1.55;
  }

  .advisor-bio {
    margin: 0 0 22px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 70ch;
  }

  .advisor-contact-row {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--awc-line);
    justify-content: start;
  }

  .contact-item span {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 2px;
  }

  .contact-item strong {
    font-size: 14px;
    color: var(--awc-navy);
  }

  .contact-item a {
    color: var(--awc-navy);
    text-decoration: none;
  }

  .contact-item a:hover {
    color: var(--awc-jade-deep);
    text-decoration: underline;
  }

  /* 3. THREE CLEAN SERVICE PILLARS */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .service-card {
    background: var(--primitive-white);
    border: 1px solid var(--awc-line);
    border-radius: 18px;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
  }

  .service-num {
    font-size: 12px;
    font-weight: 800;
    color: var(--awc-jade-deep);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .service-card h3 {
    margin: 0 0 6px;
    font-size: 21px;
    font-weight: 800;
    color: var(--awc-navy);
    letter-spacing: -0.02em;
  }

  .service-sub {
    font-size: 13px;
    font-weight: 600;
    color: var(--awc-jade-deep);
    margin-bottom: 14px;
  }

  .service-card p {
    margin: 0 0 18px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .service-points {
    list-style: none;
    margin: 0 0 20px;
    padding: 16px 0 0;
    border-top: 1px solid var(--awc-line);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
    color: var(--awc-navy);
    font-weight: 500;
  }

  .service-points li::before {
    content: "— ";
    color: var(--awc-jade-deep);
    font-weight: 700;
  }

  .service-link {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--awc-navy);
    text-decoration: none;
  }

  .service-link:hover {
    color: var(--awc-jade-deep);
    text-decoration: underline;
  }

  /* 4. CLIENT EXPERIENCES (TESTIMONIALS) */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .review-card {
    background: var(--primitive-white);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-subtle);
  }

  .review-text {
    margin: 0 0 18px;
