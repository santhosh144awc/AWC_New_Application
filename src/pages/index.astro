---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { BUSINESS_PROFILE } from '../config/businessProfile';
import { JOURNEY_STAGES } from '../config/journey';
import { HEALTH_PILLARS } from '../domain/finance/financialHealth';

const pillarIcons = ['◉', '◈', '⇣', '⬡', '↗', '◎', '⟳'];

// Approved guides only (same rule as /learn/); never link to withheld articles.
const approved = await getCollection('articles', ({ data }) => data.publicationStatus === 'APPROVED');
approved.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});
const guides = approved.slice(0, 3);

const orbitNodes = [
  { cls: 'one', icon: '◉', label: 'Cash flow', sub: 'Today', href: '/tools/personal-finance-statement/' },
  { cls: 'two', icon: '⬡', label: 'Protection', sub: 'Safety', href: '/tools/life-insurance/' },
  { cls: 'three', icon: '◎', label: 'Goals', sub: 'Tomorrow', href: '/plan/' },
  { cls: 'four', icon: '↗', label: 'Investing', sub: 'Growth', href: '/tools/sip/' },
  { cls: 'five', icon: '◈', label: 'Resilience', sub: 'Reserve', href: '/health-check/' },
];

const goalTiles = [
  { icon: '🎓', title: 'Children’s future', text: 'Separate milestones, future costs and existing savings.', href: '/plan/children/', cta: 'Plan this goal →' },
  { icon: '⌂', title: 'Buy a home', text: 'Explore upfront cash, purchase costs and EMI comfort.', href: '/plan/home-purchase/', cta: 'Plan this goal →' },
  { icon: '↗', title: 'Grow investments', text: 'Try a monthly investment and a yearly step-up scenario.', href: '/tools/sip/', cta: 'Try an SIP →' },
  { icon: '⟳', title: 'Retirement', text: 'Explore retirement targets, living costs and accumulation scenarios.', href: '/plan/retirement/', cta: 'Plan retirement →' },
];

---

<BaseLayout
  title="Ant Wealth Creation — Know Where You Stand. Choose Your Next Move."
  description="A practical place to understand your family's money, plan life's milestones and learn what each financial choice could mean. Plain-language tools with no forced lead collection."
  currentPath="/"
>
  <!-- 1. HERO -->
  <section class="hero surface-dark" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">FAMILY FINANCE, MADE CLEARER</span>
        <h1 id="hero-title" class="hero__title">
          Know where you stand. <span class="hero__accent">Choose your next move.</span>
        </h1>
        <p class="hero__lead">
          A practical place to understand your finances and find useful next steps for your family.
        </p>

        <div class="hero__actions">
          <Button variant="gold" href="/health-check/">Start your health check →</Button>
          <Button variant="light" href="/tools/">View all tools →</Button>
        </div>

        <ul class="hero__meta" role="list">
          <li><span class="tiny-dot" aria-hidden="true"></span>No forced lead collection</li>
          <li><span class="tiny-dot" aria-hidden="true"></span>Plain-language guidance</li>
          <li><span class="tiny-dot" aria-hidden="true"></span>Your inputs stay in your browser</li>
        </ul>
      </div>

      <div class="hero__art">
        <p class="hero__sticker">One family. Many milestones.</p>
        <nav class="money-map" aria-label="Your money map: where to start">
          <div class="money-map__center">
            <span class="money-map__house" aria-hidden="true">⌂</span>
            <strong>Your money map</strong>
            <small>Understand · Plan · Adjust</small>
          </div>
          {orbitNodes.map((node) => (
            <a href={node.href} class={`orbit-node orbit-node--${node.cls}`}>
              <span class="orbit-node__icon" aria-hidden="true">{node.icon}</span>
              <b>{node.label}</b>
              <small>{node.sub}</small>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- 2. STARTING POINTS -->
  <section class="section" aria-labelledby="start-heading">
    <div class="container">
      <SectionHeader
        id="start-heading"
        eyebrow="Choose a starting point"
        title="One clear next step is enough."
        subtitle="You do not need to solve everything today. Start with the question that matters most to you right now."
      />

      <div class="start-grid">
        <a href="/health-check/" class="start-card start-card--mint">
          <span class="start-card__top">
            <span class="num-chip">01 · Understand</span>
            <span class="big-icon" aria-hidden="true">◉</span>
          </span>
          <span class="start-card__text">
            <h3>How healthy are our finances?</h3>
            <p>A quick, ungated check across seven parts of family financial wellbeing.</p>
          </span>
          <span class="start-card__action"><span>Start the health check</span><span class="arrow" aria-hidden="true">↗</span></span>
        </a>

        <a href="/plan/" class="start-card start-card--mist">
          <span class="start-card__top">
            <span class="num-chip">02 · Plan</span>
            <span class="big-icon" aria-hidden="true">◎</span>
          </span>
          <span class="start-card__text">
            <h3>We have a goal to plan for.</h3>
            <p>Follow the six-stage journey, or go straight to education, a home or another milestone.</p>
          </span>
          <span class="start-card__action"><span>Open the journey &amp; goals</span><span class="arrow" aria-hidden="true">↗</span></span>
        </a>

        <a href="/tools/" class="start-card start-card--sand">
          <span class="start-card__top">
            <span class="num-chip">03 · Explore</span>
            <span class="big-icon" aria-hidden="true">⌘</span>
          </span>
          <span class="start-card__text">
            <h3>I have a money question.</h3>
            <p>Find a calculator by the situation you are trying to understand.</p>
          </span>
          <span class="start-card__action"><span>Find the right tool</span><span class="arrow" aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. JOURNEY STRIP -->
  <section class="section section--navy surface-dark" aria-labelledby="journey-heading">
    <div class="container">
      <SectionHeader
        id="journey-heading"
        dark
        eyebrow="A journey, not a checklist"
        title="Move one stage at a time."
        subtitle="Choose a stage to see what it means and which tools can help you take the next small step."
      />

      <ol class="journey-strip" role="list">
        {JOURNEY_STAGES.map((stage, index) => (
          <li>
            <a href={`/plan/#stage-${stage.id}`} class="journey-mini">
              <span class="journey-mini__bubble" aria-hidden="true">{index + 1}</span>
              <b>{stage.label}</b>
              <small>{stage.title}</small>
            </a>
          </li>
        ))}
      </ol>

      <div class="section__cta">
        <Button variant="gold" href="/plan/" icon="→">Explore the full journey</Button>
      </div>
    </div>
  </section>

  <!-- 4. SEVEN PILLARS -->
  <section class="section section--white" aria-labelledby="pillars-heading">
    <div class="container pillars">
      <div class="pillars__intro">
        <span class="eyebrow">The bigger picture</span>
        <h2 id="pillars-heading" class="pillars__title">Financial wellbeing has more than one number.</h2>
        <p>
          Income and net worth matter, but so do resilience, protection, goals and the confidence to make
          choices. The health check looks at seven areas, one at a time.
        </p>
        <Button variant="primary" href="/health-check/" icon="→">Check the seven pillars</Button>
      </div>

      <ol class="pillars__grid" role="list">
        {HEALTH_PILLARS.map((pillar, index) => (
          <li class="pillar">
            <span class="pillar__icon" aria-hidden="true">{pillarIcons[index]}</span>
            <b>{pillar.shortTitle}</b>
            <small>Pillar {index + 1}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. GOALS -->
  <section class="section section--mist" aria-labelledby="goals-heading">
    <div class="container">
      <SectionHeader
        id="goals-heading"
        eyebrow="Goals that make it personal"
        title="What are you planning for?"
        subtitle="Start with a life milestone. Each planner helps you explore costs, timing and funding under assumptions you choose."
      />

      <ul class="goal-grid" role="list">
        {goalTiles.map((tile) => (
          <li>
            <a href={tile.href} class="goal-tile">
              <span class="goal-tile__symbol" aria-hidden="true">{tile.icon}</span>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
              <span class="goal-tile__cta">{tile.cta}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. LEARN -->
  <section class="section section--white" aria-labelledby="learn-heading">
    <div class="container">
      <SectionHeader
        id="learn-heading"
        eyebrow="Learn without the jargon"
        title="Good money decisions start with understanding."
      />

      <ul class="guide-grid" role="list">
        {guides.map((guide, index) => (
          <li>
            <a href={`/learn/${guide.id}/`} class={`guide-card guide-card--${index}`}>
              <span class="guide-card__meta">{guide.data.category} · {guide.data.readingTime}</span>
              <h3>{guide.data.title}</h3>
              <p>{guide.data.description}</p>
              <span class="guide-card__cta">Read this guide →</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="section__cta">
        <Button variant="light" href="/learn/" icon="→">Browse all guides</Button>
      </div>
    </div>
  </section>

  <!-- 7. ABOUT -->
  <section class="section" aria-labelledby="about-heading">
    <div class="container about">
      <div class="about__photo">
        <img
          src={BUSINESS_PROFILE.founder.photoPath}
          alt={`${BUSINESS_PROFILE.founder.fullName}, founder of ${BUSINESS_PROFILE.firm.name}`}
          width="360"
          height="450"
          loading="lazy"
        />
        <p class="about__stamp">Family goals.<br />Practical planning.<br />Informed decisions.</p>
      </div>

      <div class="about__copy">
        <span class="eyebrow">A little about the practice</span>
        <h2 id="about-heading" class="about__title">
          Financial planning should help you feel clearer — not more confused.
        </h2>
        <p>{BUSINESS_PROFILE.founder.bio}</p>

        <ul class="about__facts" role="list">
          <li>{BUSINESS_PROFILE.founder.fullName}</li>
          <li>{BUSINESS_PROFILE.founder.credentials}</li>
          <li>Markets since {BUSINESS_PROFILE.firm.experienceSince}</li>
        </ul>

        <p class="about__note">
          {BUSINESS_PROFILE.regulatory.distributorRoleText}. {BUSINESS_PROFILE.regulatory.sebiRIAStatusNotice}
          <a href="/disclaimer/">Read the full disclosures</a>.
        </p>

        <Button variant="primary" href="/about/" icon="→">Meet the practice</Button>
      </div>
    </div>
  </section>

  <!-- 8. CONTACT -->
  <section class="section section--tight" aria-labelledby="contact-heading">
    <div class="container">
      <div class="contact-band">
        <div>
          <span class="eyebrow">Prefer to talk it through?</span>
          <h2 id="contact-heading" class="contact-band__title">
            Start with a short, no-pressure conversation with {BUSINESS_PROFILE.founder.shortName}.
          </h2>
          <p><a href="/contact/">See what to expect from a consultation</a></p>
        </div>
        <div class="contact-band__actions">
          <Button
            variant="primary"
            href={BUSINESS_PROFILE.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            icon="↗"
          >
            Chat on WhatsApp<span class="sr-only"> (opens in a new window)</span>
          </Button>
          <Button variant="light" href={`tel:${BUSINESS_PROFILE.contact.phone}`}>
            Call {BUSINESS_PROFILE.contact.phoneDisplay}
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: var(--space-20) 0;
  }

  .section--tight {
    padding: var(--space-8) 0 var(--space-20);
  }

  .section--white {
    background: var(--primitive-white);
  }

  .section--mist {
    background: #e7f2ef;
  }

  .section--navy {
    background: var(--awc-navy);
    color: var(--color-text-on-dark);
  }

  .section__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--awc-navy);
    color: var(--color-text-on-dark);
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
  }

  .hero::before {
    top: -300px;
    right: -120px;
    width: 680px;
    height: 680px;
  }

  .hero::after {
    top: -190px;
    right: 30px;
    width: 460px;
    height: 460px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.03fr 0.97fr;
    gap: var(--space-12);
    align-items: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .hero__title {
    margin: var(--space-5) 0 var(--space-5);
    max-width: 650px;
    font-size: clamp(2.6rem, 4.8vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
    font-weight: 900;
    color: var(--primitive-white);
  }

  .hero__accent {
    color: var(--awc-gold);
  }

  .hero__lead {
    max-width: 560px;
    margin-bottom: var(--space-6);
    font-size: 1.05rem;
    line-height: 1.7;
    color: #ddebe7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    font-weight: 700;
    color: #b7cbc6;
  }

  .hero__meta li {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .tiny-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--awc-gold);
  }

  /* Money map */
  .hero__art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
  }

  .hero__sticker {
    position: absolute;
    top: 6%;
    left: 4%;
    z-index: 4;
    margin: 0;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--awc-sand);
    color: var(--awc-navy);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transform: rotate(-6deg);
    box-shadow: 0 12px 22px rgba(0, 0, 0, 0.18);
  }

  .money-map {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 450px);
    aspect-ratio: 1;
    border: 1px dashed rgba(218, 229, 255, 0.32);
    border-radius: 50%;
  }

  .money-map::before,
  .money-map::after {
    content: '';
    position: absolute;
    border: 1px solid rgba(218, 229, 255, 0.17);
    border-radius: 50%;
    inset: 10%;
  }

  .money-map::after {
    inset: 22%;
  }

  .money-map__center {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: var(--awc-gold);
    color: var(--awc-navy);
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
  }

  .money-map__house {
    font-size: 2.6rem;
    line-height: 1;
  }

  .money-map__center strong {
    margin-top: 5px;
    font-size: 0.95rem;
  }

  .money-map__center small {
    max-width: 120px;
    margin-top: 2px;
    font-size: 0.65rem;
  }

  .orbit-node {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 104px;
    min-height: 94px;
    padding: 12px 10px;
    border-radius: 20px;
    background: var(--primitive-white);
    color: var(--awc-navy);
    text-align: center;
    text-decoration: none;
    box-shadow: 0 15px 36px rgba(0, 0, 0, 0.22);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .orbit-node:hover {
    color: var(--awc-navy);
    transform: translateY(-4px) scale(1.04);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.3);
  }

  .orbit-node__icon {
    margin-bottom: 4px;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .orbit-node b {
    font-size: 0.72rem;
  }

  .orbit-node small {
    font-size: 0.62rem;
    color: var(--color-text-muted);
  }

  .orbit-node--one { top: 3%; left: 39%; }
  .orbit-node--two { top: 31%; right: -2%; background: var(--awc-sand); }
  .orbit-node--three { bottom: 7%; right: 12%; background: var(--awc-mint); }
  .orbit-node--four { bottom: 8%; left: 5%; background: var(--awc-mist); }
  .orbit-node--five { top: 30%; left: -3%; background: var(--awc-mist); }

  /* ---------- Starting points ---------- */
  .start-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .start-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 228px;
    padding: var(--space-6);
    border-radius: 26px;
    color: var(--awc-navy);
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .start-card:hover {
    color: var(--awc-navy);
    transform: translateY(-4px);
    box-shadow: var(--shadow-elevated);
  }

  .start-card--mint { background: var(--awc-mint); }
  .start-card--mist { background: var(--awc-mist); }
  .start-card--sand { background: var(--awc-sand); }

  .start-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .num-chip {
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.75);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .big-icon {
    display: grid;
    place-items: center;
    width: 53px;
    height: 53px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.7);
    font-size: 1.6rem;
  }

  .start-card__text h3 {
    max-width: 260px;
    margin: var(--space-5) 0 var(--space-2);
    font-size: 1.6rem;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  .start-card__text p {
    max-width: 300px;
    margin: 0;
    font-size: var(--text-body-sm);
    color: var(--primitive-slate-700);
  }

  .start-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-5);
    font-size: var(--text-body-sm);
    font-weight: 900;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.75);
  }

  /* ---------- Journey strip ---------- */
  .journey-strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .journey-strip::before {
    content: '';
    position: absolute;
    top: 29px;
    left: 8%;
    right: 8%;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--awc-gold), var(--awc-jade));
  }

  .journey-mini {
    position: relative;
    display: block;
    padding: 0 var(--space-2);
    color: var(--primitive-white);
    text-align: center;
    text-decoration: none;
  }

  .journey-mini:hover {
    color: var(--primitive-white);
  }

  .journey-mini__bubble {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    margin: 0 auto var(--space-3);
    border: 4px solid var(--awc-navy);
    border-radius: 50%;
    background: var(--primitive-white);
    color: var(--awc-navy);
    font-weight: 900;
    box-shadow: 0 0 0 6px var(--awc-navy);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .journey-mini:hover .journey-mini__bubble,
  .journey-mini:focus-visible .journey-mini__bubble {
    transform: scale(1.08);
    background: var(--awc-gold);
  }

  .journey-mini b {
    display: block;
    margin-bottom: 4px;
    font-size: 0.8rem;
  }

  .journey-mini small {
    display: block;
    margin: 0 auto;
    max-width: 150px;
    font-size: 0.7rem;
    line-height: 1.4;
    color: #c5d7d2;
  }

  /* ---------- Pillars ---------- */
  .pillars {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: var(--space-12);
    align-items: center;
  }

  .pillars__title {
    margin: var(--space-3) 0;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .pillars__intro p {
    max-width: 420px;
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 130px;
    padding: var(--space-4);
    border: 1px solid var(--awc-line);
    border-radius: 19px;
    background: var(--primitive-white);
  }

  .pillar:nth-child(2),
  .pillar:nth-child(6) { background: var(--awc-mist); }
  .pillar:nth-child(3),
