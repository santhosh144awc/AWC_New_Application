---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS_PROFILE } from '../config/businessProfile';
import { CLIENT_TESTIMONIALS } from '../config/testimonials';

const approvedArticles = await getCollection('articles', ({ data }) => {
  return data.publicationStatus === 'APPROVED';
});

approvedArticles.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const featuredArticles = approvedArticles.slice(0, 3);

const pfsHighlights = [
  { step: 'Stage 1–2', name: 'Income & Living Costs', detail: 'Map household take-home inflows and monthly expenses.' },
  { step: 'Stage 3', name: 'Savings & Surplus', detail: 'Calculate savings rate and ongoing SIP/PPF commitments.' },
  { step: 'Stage 4–5', name: '6-Class Assets & Debts', detail: 'Separate productive investments from personal residence.' },
  { step: 'Stage 6', name: 'Net Worth & 5-Page PDF', detail: 'Generate a client-ready statement 100% in your browser.' },
];

const diagnosticTools = [
  {
    badge: 'Flagship 6-Stage Workbench',
    title: 'Personal Finance Statement',
    question: 'Where does our money go, and what is our true productive net worth?',
    desc: 'Complete 6-stage household financial review covering cash flows, savings rate, 6 asset classes, liabilities, and a downloadable 5-page client PDF.',
    href: '/tools/personal-finance-statement/',
    cta: 'Open Personal Finance Statement →',
    featured: true,
  },
  {
    badge: '2-Minute Checkup',
    title: '7-Pillar Financial Health Check',
    question: 'How resilient are our family finances across 7 core areas?',
    desc: 'Answer seven quick questions on cash flow, emergency reserves, debt load, insurance cover, and goal readiness.',
    href: '/health-check/',
    cta: 'Start 2-Minute Checkup →',
    featured: false,
  },
  {
    badge: 'Quick Snapshot',
    title: 'Quick Net Worth Balance Sheet',
    question: 'What do we own and owe right now?',
    desc: 'Consolidate family assets and liabilities in two minutes with personal-use property separated from financial assets.',
    href: '/tools/net-worth/',
    cta: 'Open Net Worth Snapshot →',
    featured: false,
  },
];

const workbenchCalculators = [
  {
    category: 'Wealth & SIP Compounding',
    title: 'SIP Wealth Simulator',
    question: 'What could a monthly SIP grow to with annual step-ups?',
    href: '/tools/sip/',
    cta: 'Open SIP Calculator →',
    tint: 'mint',
  },
  {
    category: 'One-Time Capital',
    title: 'Lump Sum Growth Calculator',
    question: 'What could a one-time investment or bonus become over time?',
    href: '/tools/lumpsum/',
    cta: 'Open Lump Sum Tool →',
    tint: 'mist',
  },
  {
    category: 'Multi-Cashflow Investing',
    title: 'Advanced Step-Up SIP',
    question: 'What if I combine yearly SIP step-ups with extra lump sums?',
    href: '/tools/sip-growth/',
    cta: 'Open Advanced SIP →',
    tint: 'mint',
  },
  {
    category: 'Loan vs Investment',
    title: 'Home Loan Foreclosure vs SIP',
    question: 'Should I prepay my home loan early or invest in a parallel SIP?',
    href: '/tools/home-loan-foreclosure/',
    cta: 'Compare Prepay vs SIP →',
    tint: 'sand',
  },
  {
    category: 'Borrowing Cost Offset',
    title: 'Loan Interest Recovery SIP',
    question: 'Could a parallel monthly SIP offset the interest paid on my loan?',
    href: '/tools/loan-sip-recovery/',
    cta: 'Calculate Recovery SIP →',
    tint: 'mist',
  },
  {
    category: 'Monthly Cash Flow',
    title: 'SWP Longevity Simulator',
    question: 'How long will my corpus last if I withdraw a monthly income?',
    href: '/tools/swp/',
    cta: 'Simulate SWP →',
    tint: 'sand',
  },
  {
    category: 'Education & Marriage',
    title: "Children's Future Planner",
    question: "How much should we invest monthly for our children's higher education?",
    href: '/plan/children/',
    cta: "Plan Children's Goals →",
    tint: 'mint',
  },
  {
    category: 'Property Acquisition',
    title: 'Home Purchase Planner',
    question: 'How much upfront cash, down payment, and EMI budget do we need?',
    href: '/plan/home-purchase/',
    cta: 'Plan Home Purchase →',
    tint: 'mist',
  },
  {
    category: 'Lifelong Corpus',
    title: 'Retirement Accumulation',
    question: 'What corpus and monthly SIP do we need to retire comfortably?',
    href: '/plan/retirement/',
    cta: 'Plan Retirement Corpus →',
    tint: 'sand',
  },
  {
    category: 'Post-Retirement Buckets',
    title: '3-Bucket Retirement Income',
    question: 'How should we split retirement savings across Liquidity, Safety, and Growth?',
    href: '/plan/retirement-income/',
    cta: 'Model 3-Bucket Income →',
    tint: 'mint',
  },
  {
    category: 'Family Protection',
    title: 'Life Insurance Needs Audit',
    question: 'How much pure term life cover does our family actually need?',
    href: '/tools/life-insurance/',
    cta: 'Calculate Cover Gap →',
    tint: 'mist',
  },
];
---

<BaseLayout
  title={`${BUSINESS_PROFILE.firm.name} — Personal Finance Statement & Financial Calculators`}
  description="Build your 6-stage Personal Finance Statement with client-ready PDF output, or run independent mutual fund SIP, loan prepayment, retirement, and family goal calculators."
  currentPath="/"
>
  <div class="container home-page">
    <!-- 1. HERO: PERSONAL FINANCE STATEMENT & CLIENT WORKBENCH -->
    <section class="hero surface-dark" aria-labelledby="hero-heading">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow-light">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            Personal Finance Statement &amp; Interactive Calculators
          </div>

          <h1 id="hero-heading">
            Map your family’s complete financial picture in one place.
          </h1>

          <p class="hero-lead">
            Build a structured 6-stage <strong>Personal Finance Statement</strong>—reconciling income, living costs, savings rate, 6-class assets, debts, and productive net worth—or open any calculator independently in seconds.
          </p>

          <div class="hero-cta-row">
            <a class="btn-hero-gold" href="/tools/personal-finance-statement/">
              Open Personal Finance Statement →
            </a>
            <a class="btn-hero-ghost" href="#interactive-tools-workbench">
              Explore All Calculators ↓
            </a>
          </div>

          <div class="hero-trust" role="list" aria-label="Core capabilities">
            <div class="trust-item" role="listitem">
              <strong>6-Stage Statement + 5-Page PDF</strong>
              <span>Client-ready financial balance sheet &amp; cash flow report</span>
            </div>
            <div class="trust-item" role="listitem">
              <strong>12 Independent Calculators</strong>
              <span>Built for fast scenario checks &amp; live client meetings</span>
            </div>
            <div class="trust-item" role="listitem">
              <strong>100% Browser-Local Privacy</strong>
              <span>Your numbers stay on your device—zero forced sign-ups</span>
            </div>
          </div>
        </div>

        <!-- Flagship Personal Finance Statement Spotlight Card -->
        <aside class="hero-spotlight-card" aria-label="Personal Finance Statement overview">
          <div class="spotlight-top">
            <span class="spotlight-badge">Flagship Diagnostic Tool</span>
            <span class="spotlight-privacy">PDF Report Included</span>
          </div>

          <h2 class="spotlight-title">6-Stage Personal Finance Statement</h2>
          <p class="spotlight-sub">
            Separates personal residence utility from productive investments to show your true milestone-funding net worth.
          </p>

          <div class="spotlight-stages">
            {pfsHighlights.map((item) => (
              <div class="spotlight-stage-row">
                <span class="stage-pill">{item.step}</span>
                <div class="stage-info">
                  <strong>{item.name}</strong>
                  <span>{item.detail}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="spotlight-actions">
            <a href="/tools/personal-finance-statement/" class="btn-spotlight-launch">
              Launch Personal Finance Statement →
            </a>
          </div>

          <div class="spotlight-quick-links">
            <span class="quick-links-label">Quick Calculators:</span>
            <a href="/tools/sip/">SIP</a>
            <a href="/tools/home-loan-foreclosure/">Loan Prepay vs SIP</a>
            <a href="/tools/loan-sip-recovery/">Loan Recovery</a>
            <a href="/plan/children/">Children</a>
            <a href="/plan/retirement/">Retirement</a>
          </div>
        </aside>
      </div>
    </section>

    <!-- 2. UNIFIED PERSONAL FINANCE & CALCULATORS WORKBENCH -->
    <section class="section" id="interactive-tools-workbench" aria-labelledby="workbench-heading">
      <div class="section-head">
        <div>
          <div class="eyebrow">Independent Financial Tools</div>
          <h2 id="workbench-heading">Personal Finance Diagnostics &amp; Scenario Calculators</h2>
        </div>
        <p>
          Open any tool directly to test numbers on the spot, compare options in a client meeting, or share a scenario on WhatsApp.
        </p>
      </div>

      <!-- Top Row: 3 Core Household Diagnostics -->
      <div class="diagnostics-grid">
        {diagnosticTools.map((tool) => (
          <a href={tool.href} class={`diag-card ${tool.featured ? 'is-featured' : ''}`}>
            <div class="diag-top">
              <span class="diag-badge">{tool.badge}</span>
            </div>
            <h3 class="diag-title">{tool.title}</h3>
            <p class="diag-question">“{tool.question}”</p>
            <p class="diag-desc">{tool.desc}</p>
            <span class="diag-cta">{tool.cta}</span>
          </a>
        ))}
      </div>

      <!-- Second Grid: All 11 Independent Scenario Calculators & Goal Planners -->
      <div class="calculators-subhead">
        <h3>Investment, Loan &amp; Family Goal Calculators</h3>
        <a href="/tools/" class="view-all-link">Search &amp; Filter All Tools →</a>
      </div>

      <div class="workbench-grid">
        {workbenchCalculators.map((calc) => (
          <a href={calc.href} class={`workbench-card tint-${calc.tint}`}>
            <span class="workbench-cat">{calc.category}</span>
            <h4 class="workbench-title">{calc.title}</h4>
            <p class="workbench-question">{calc.question}</p>
            <span class="workbench-cta">{calc.cta}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 3. ABOUT SANTHOSH -->
    <section class="section" id="about" aria-labelledby="about-heading">
      <div class="about-card">
        <div class="about-photo-col">
          <img
            src={BUSINESS_PROFILE.founder.photoPath}
            alt={BUSINESS_PROFILE.founder.fullName}
            width="280"
            height="340"
            loading="lazy"
            class="founder-photo"
          />
        </div>
        <div class="about-copy-col">
          <div class="eyebrow">About the Founder</div>
          <h2 id="about-heading">Meet {BUSINESS_PROFILE.founder.fullName}</h2>
          <p class="founder-role">
            {BUSINESS_PROFILE.founder.designation} · {BUSINESS_PROFILE.founder.credentials}
          </p>
          <blockquote class="founder-quote">
            “{BUSINESS_PROFILE.founder.quote}”
          </blockquote>
          <p class="founder-bio">{BUSINESS_PROFILE.founder.bio}</p>

          <div class="credentials-strip">
            <span class="cred-chip">{BUSINESS_PROFILE.regulatory.distributorRoleText}</span>
            <span class="cred-chip">QPFP Certified</span>
            <span class="cred-chip">Markets Experience Since {BUSINESS_PROFILE.firm.experienceSince}</span>
            <span class="cred-chip">{BUSINESS_PROFILE.firm.headquarters}</span>
          </div>

          <div class="about-actions">
            <a class="btn-primary" href="/about/">Read full profile &amp; credentials →</a>
            <a class="btn-secondary" href="/commission-disclosure/">How we are compensated →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. REAL CLIENT EXPERIENCES (TESTIMONIALS) -->
    <section class="section" id="testimonials" aria-labelledby="testimonials-heading">
      <div class="section-head">
        <div>
          <div class="eyebrow">Client Stories &amp; Trust</div>
          <h2 id="testimonials-heading">What Families &amp; Professionals Say</h2>
        </div>
        <p>
          Real experiences shared by clients across mutual fund planning, stock market mentoring, and family protection.
        </p>
      </div>

      <div class="testimonials-grid">
        {CLIENT_TESTIMONIALS.map((item) => (
          <article class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar" aria-hidden="true">
                {item.photoPath ? (
                  <img src={item.photoPath} alt={item.name} width="48" height="48" loading="lazy" />
                ) : (
                  <span class="avatar-initials">{item.initials}</span>
                )}
              </div>
              <div class="testimonial-author">
                <h3 class="author-name">{item.name}</h3>
                <p class="author-role">{item.companyOrOrg ? `${item.role} · ${item.companyOrOrg}` : item.role}</p>
              </div>
            </div>

            <span class="testimonial-highlight">Verified Client Experience</span>

            <blockquote class="testimonial-quote">
              “{item.quote}”
            </blockquote>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. LEARNING LIBRARY PREVIEW -->
    <section class="section" id="learn" aria-labelledby="learn-heading">
      <div class="section-head">
        <div>
          <div class="eyebrow">Plain-Language Guides</div>
          <h2 id="learn-heading">Read a short guide when you want deeper context</h2>
        </div>
        <p>
          Clear, jargon-free articles on compounding, risk protection, and family financial planning.
        </p>
      </div>

      <div class="learn-grid">
        {featuredArticles.map((article) => (
          <article class="article-card">
            <div class="article-meta">
              <span>{article.data.category}</span>
              <span>{article.data.readingTime}</span>
            </div>
            <h3>
              <a href={`/learn/${article.id}/`}>{article.data.title}</a>
            </h3>
            <p>{article.data.description}</p>
            <a class="card-cta" href={`/learn/${article.id}/`}>
              Read guide →
            </a>
          </article>
        ))}
      </div>

      <div class="section-foot">
        <a class="btn-secondary" href="/learn/">Browse all {approvedArticles.length} guides →</a>
      </div>
    </section>

    <!-- 6. CONTACT & WHATSAPP -->
    <section class="section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-band surface-dark">
        <div class="contact-copy">
          <div class="eyebrow-light">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            Talk to {BUSINESS_PROFILE.founder.shortName}
          </div>
          <h2 id="contact-heading">Want to walk through your numbers together?</h2>
          <p>
            Complete your <strong>Personal Finance Statement</strong> or try a calculator first, then reach out on WhatsApp or phone for a calm, practical conversation.
          </p>
          <div class="contact-cta-row">
            <a
              class="btn-hero-gold"
              href={BUSINESS_PROFILE.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Chat with {BUSINESS_PROFILE.founder.shortName} on WhatsApp ↗
            </a>
            <a class="btn-hero-ghost" href="/contact/">
              Contact details &amp; office info →
            </a>
          </div>
        </div>
        <div class="contact-details">
          <div class="contact-detail-card">
            <span>Direct Phone</span>
            <strong><a href={`tel:${BUSINESS_PROFILE.contact.phone}`}>{BUSINESS_PROFILE.contact.phoneDisplay}</a></strong>
          </div>
          <div class="contact-detail-card">
            <span>Email</span>
            <strong><a href={`mailto:${BUSINESS_PROFILE.contact.email}`}>{BUSINESS_PROFILE.contact.email}</a></strong>
          </div>
          <div class="contact-detail-card">
            <span>Location</span>
            <strong>{BUSINESS_PROFILE.firm.headquarters}</strong>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    padding-top: 22px;
    padding-bottom: 48px;
  }

  /* Eyebrows */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--awc-jade-deep);
  }

  .eyebrow-light {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--primitive-teal-100);
    font-size: 12px;
    font-weight: 700;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--awc-gold);
  }

  /* 1. HERO */
  .hero {
    padding: 36px;
    border-radius: 32px;
    background:
      radial-gradient(circle at 86% 18%, rgba(242, 198, 93, 0.2), transparent 26%),
      radial-gradient(circle at 70% 80%, rgba(22, 135, 126, 0.28), transparent 34%),
      linear-gradient(135deg, var(--awc-navy) 0%, var(--primitive-navy-800) 58%, var(--primitive-teal-700) 100%);
    color: var(--primitive-white);
    box-shadow: var(--shadow-elevated);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 28px;
    align-items: center;
  }

  .hero h1 {
    margin: 16px 0 14px;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 850;
    color: var(--primitive-white);
  }

  .hero-lead {
    margin: 0;
    max-width: 58ch;
    color: var(--color-text-on-dark);
    font-size: 16.5px;
    line-height: 1.65;
  }

  .hero-lead strong {
    color: var(--primitive-white);
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .btn-hero-gold,
  .btn-hero-ghost,
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease, filter 0.15s ease;
  }

  .btn-hero-gold {
    background: var(--awc-gold);
    color: var(--awc-navy);
  }

  .btn-hero-gold:hover {
    filter: brightness(1.04);
    transform: translateY(-1px);
  }

  .btn-hero-ghost {
    background: rgba(255, 255, 255, 0.1);
    color: var(--primitive-white);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .btn-hero-ghost:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .btn-primary {
    background: var(--awc-jade-action);
    color: var(--primitive-white);
  }

  .btn-primary:hover {
    background: var(--awc-jade-deep);
  }

  .btn-secondary {
    background: var(--primitive-white);
    color: var(--awc-navy);
    border: 1px solid var(--awc-line);
  }

  .btn-secondary:hover {
    border-color: var(--awc-jade);
    color: var(--awc-jade-deep);
  }

  .hero-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .trust-item strong {
    display: block;
    font-size: 13.5px;
    color: var(--primitive-white);
  }

  .trust-item span {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-text-on-dark);
  }

  /* Hero Right Column: Flagship Spotlight Card */
  .hero-spotlight-card {
    padding: 24px;
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .spotlight-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .spotlight-badge {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--awc-gold);
    color: var(--awc-navy);
    font-size: 11px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .spotlight-privacy {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--primitive-teal-100);
  }

  .spotlight-title {
    margin: 0;
    font-size: 22px;
    font-weight: 850;
    letter-spacing: -0.03em;
    color: var(--primitive-white);
  }

  .spotlight-sub {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-on-dark);
  }

  .spotlight-stages {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spotlight-stage-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 14px;
    background: rgba(15, 34, 51, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stage-pill {
    flex-shrink: 0;
    padding: 3px 8px;
    border-radius: 8px;
    background: rgba(207, 239, 227, 0.16);
    color: var(--primitive-teal-100);
    font-size: 11px;
    font-weight: 800;
  }

  .stage-info strong {
    display: block;
    font-size: 13px;
    color: var(--primitive-white);
  }

  .stage-info span {
    display: block;
    font-size: 11.5px;
    color: var(--color-text-on-dark);
    margin-top: 2px;
  }

  .btn-spotlight-launch {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 14px;
    background: var(--primitive-white);
    color: var(--awc-navy);
    font-size: 13.5px;
    font-weight: 850;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .btn-spotlight-launch:hover {
    background: var(--awc-mint);
    transform: translateY(-1px);
  }

  .spotlight-quick-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .quick-links-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-text-on-dark);
    margin-right: 2px;
  }

  .spotlight-quick-links a {
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--primitive-white);
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }

  .spotlight-quick-links a:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  /* 2. WORKBENCH SECTION */
  .section {
    padding: 34px 0;
  }

  .section-head {
