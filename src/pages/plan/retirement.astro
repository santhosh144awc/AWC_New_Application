---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import RetirementAccumulationIsland from '../../features/calculators/RetirementAccumulationIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/plan/retirement/');
const { regulatory, disclosures } = BUSINESS_PROFILE;
---

<BaseLayout
  title="Retirement Wealth Accumulation Roadmap — Ant Wealth Creation"
  description="Plan your retirement accumulation with inflation-adjusted living expenses, longevity protection, and disciplined milestone compounding."
  currentPath="/plan/retirement/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/plan/retirement/" />

    <PageIntro
      eyebrow="Milestone Roadmap"
      title="Retirement Wealth Accumulation Roadmap"
      description="Model your inflation-adjusted retirement corpus target, progress from existing savings, and the monthly SIP required to close the gap."
      statusBadge="Interactive Planner Active • 5-Step Accumulation Roadmap"
    />

    <RetirementAccumulationIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Retirement Accumulation Planner"
      promptQuestion="Want to build a disciplined retirement accumulation portfolio?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {regulatory.registrationStatusText}. {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer}
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
