---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import RetirementDistributionIsland from '../../features/calculators/RetirementDistributionIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/plan/retirement-income/');
const { regulatory, disclosures } = BUSINESS_PROFILE;
---

<BaseLayout
  title="Retirement Distribution & Three-Bucket Cash Flow — Ant Wealth Creation"
  description="Examine the three-bucket decumulation framework (Liquidity, Safety, Growth) designed to manage sequence-of-returns risk during retirement."
  currentPath="/plan/retirement-income/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/plan/retirement-income/" />

    <PageIntro
      eyebrow="Milestone Roadmap"
      title="Retirement Distribution & Three-Bucket Cash Flow"
      description="Partition your retirement corpus across Immediate Liquidity (Years 1–3), Conservative Yield (Years 4–7), and Long-Term Growth (Years 8+)."
      statusBadge="Interactive Planner Active • 3-Bucket Cash Flow"
    />

    <RetirementDistributionIsland client:load />

    <WhatsAppToolLeadBar
      toolName="3-Bucket Retirement Income Planner"
      promptQuestion="Transitioning into retirement and want to structure your monthly cash flows?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {regulatory.registrationStatusText}. {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer}
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
