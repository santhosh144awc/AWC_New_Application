---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import HomePurchasePlannerIsland from '../../features/calculators/HomePurchasePlannerIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/plan/home-purchase/');
const { regulatory, disclosures } = BUSINESS_PROFILE;
const registrationNotice = regulatory.registrationStatusText;
---

<BaseLayout
  title="Home Purchase & Acquisition Cost Planner — Ant Wealth Creation"
  description="Explore a home's possible future price, upfront cash requirement, estimated loan EMI and the savings you may need under your own assumptions."
  currentPath="/plan/home-purchase/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/plan/home-purchase/" />

    <PageIntro
      eyebrow="Milestone Roadmap · Family Home Purchase"
      title="Plan the cash your family may need to buy a home."
      description="Explore a home's possible future price, upfront down payment and registration cash requirement, estimated loan EMI, and monthly savings needed."
      statusBadge="Interactive Family Planner • Tax Relief Excluded"
      icon="🏡"
    />

    <HomePurchasePlannerIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Home Purchase Planner"
      promptQuestion="Planning a down payment or comparing home loan EMI options?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory &amp; Educational Notice:</strong> {registrationNotice}. {disclosures.simulationDisclaimer} Home purchase planning calculations are educational estimates based on user-entered property prices, timelines, and financing assumptions. Tax treatment is not included in this estimate.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
