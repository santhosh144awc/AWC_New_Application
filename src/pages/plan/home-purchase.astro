---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import HomePurchasePlannerIsland from '../../features/calculators/HomePurchasePlannerIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/plan/home-purchase/');
const { regulatory, disclosures } = BUSINESS_PROFILE;
const registrationNotice = regulatory.registrationStatusText;
---

<BaseLayout
  title="Home Purchase & Acquisition Cost Planner — Ant Wealth Creation"
  description="Explore a home's possible future price, upfront cash requirement, estimated loan EMI and the savings you may need under your own assumptions."
  currentPath="/plan/home-purchase/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Milestone Roadmap · Family Home Purchase"
      title="Plan the cash your family may need to buy a home."
      description="Explore a home's possible future price, upfront cash requirement, estimated loan EMI and the savings you may need under your own assumptions."
      statusBadge="Interactive Family Planner • Tax Relief Excluded"
      icon="🏡"
    />

    <HomePurchasePlannerIsland client:load />

    {/* Important Upfront Cost Realities Editorial Section */}
    <section class="acquisition-rules-box" aria-labelledby="rules-heading">
      <div class="rules-header">
        <span class="rules-eyebrow">Practical Reality</span>
        <h2 id="rules-heading" class="section-title">Important Upfront Cost Realities</h2>
        <p class="section-desc">
          Buying a home involves significantly more than the agreement price. Planning for upfront cash outlays, lender funding limits, and reserve preservation protects family stability.
        </p>
      </div>

      <div class="rules-grid">
        <div class="rule-card">
          <span class="rule-tag">Illustrative Outlay 01</span>
          <h3 class="rule-title">Stamp Duty & Registration (State-Specific)</h3>
          <p class="rule-desc">
            State registration fees and stamp duty typically cannot be financed through home loans and vary widely by state and municipality; they must be funded upfront from family cash reserves.
          </p>
        </div>

        <div class="rule-card">
          <span class="rule-tag">Illustrative Outlay 02</span>
          <h3 class="rule-title">Interior & Movement Buffer (Variable)</h3>
          <p class="rule-desc">
            Electricals, woodwork, modular kitchen, and moving costs vary widely based on property condition and personal choices, often adding significant upfront out-of-pocket expenses.
          </p>
        </div>

        <div class="rule-card">
          <span class="rule-tag">Planning Caution 03</span>
          <h3 class="rule-title">Emergency Reserve Consideration</h3>
          <p class="rule-desc">
            Consider how much readily accessible money would remain after purchase. This planner does not assess whether your remaining emergency reserve is adequate for your household.
          </p>
        </div>
      </div>
    </section>

    {/* Canonical Connected Navigation */}
    <section class="related-nav" aria-labelledby="related-nav-heading">
      <div class="related-header">
        <span class="related-eyebrow">Connected Tools & Roadmaps</span>
        <h2 id="related-nav-heading" class="related-title">Explore Related Goal & Financing Tools</h2>
        <p class="related-desc">
          Plan family milestones across borrowing decisions, investment compounding, and wealth allocation roadmaps.
        </p>
      </div>

      <div class="related-grid">
        <a href="/plan/" class="related-card">
          <div class="card-top">
            <span class="card-icon">🎯</span>
            <span class="card-tag">Milestone Roadmaps</span>
          </div>
          <h3 class="card-title">All Goal Roadmaps</h3>
          <p class="card-desc">Review connected financial goal blueprints for retirement, education, and long-term family wealth building.</p>
          <span class="card-action">View all roadmaps →</span>
        </a>

        <a href="/plan/children/" class="related-card">
          <div class="card-top">
            <span class="card-icon">🎒</span>
            <span class="card-tag">Family Milestone</span>
          </div>
          <h3 class="card-title">Children's Future Planner</h3>
          <p class="card-desc">Estimate college education outlays with multi-child compounding models and dedicated asset earmarking.</p>
          <span class="card-action">Plan children's milestones →</span>
        </a>

        <a href="/tools/home-loan-foreclosure/" class="related-card">
          <div class="card-top">
            <span class="card-icon">⚖️</span>
            <span class="card-tag">Debt vs Investment</span>
          </div>
          <h3 class="card-title">Prepayment vs Investment</h3>
          <p class="card-desc">Simulate whether prepaying your mortgage or investing parallel household surplus produces stronger net worth.</p>
          <span class="card-action">Compare loan strategies →</span>
        </a>

        <a href="/tools/lumpsum/" class="related-card">
          <div class="card-top">
            <span class="card-icon">💎</span>
            <span class="card-tag">Capital Growth</span>
          </div>
          <h3 class="card-title">Lump Sum Calculator</h3>
          <p class="card-desc">Evaluate the long-term compounding growth of one-time savings earmarked for your family goals.</p>
          <span class="card-action">Calculate lump sum →</span>
        </a>
      </div>
    </section>

    {/* Centralized Regulatory & Educational Notice */}
    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory & Educational Notice:</strong> {registrationNotice} {disclosures.simulationDisclaimer}
        Home purchase planning calculations are educational estimates based on user-entered property prices, timelines, and financing assumptions. Ant Wealth Creation is not a bank, housing finance company, or lending institution and does not issue loan sanctions, interest rate commitments, or credit approvals. Stamp duty, registration fees, GST, and lending eligibility criteria vary by jurisdiction, property type, and lender policies. Tax treatment is not included in this estimate. This planner does not calculate tax deductions, tax-regime effects, or tax savings. Rules can depend on the tax year and individual circumstances; obtain qualified tax advice for your situation.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .acquisition-rules-box {
    margin: var(--space-12) 0;
  }

  .rules-header {
    margin-bottom: var(--space-6);
  }

  .rules-eyebrow {
    display: inline-block;
    font-size: var(--text-caption);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-brand);
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-h2);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--awc-navy, #173047);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.025em;
  }

  .section-desc {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0;
    line-height: 1.6;
  }

  .rules-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .rules-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rule-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 2px 10px rgba(23, 48, 71, 0.04);
    display: flex;
    flex-direction: column;
  }

  .rule-tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--color-text-brand);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .rule-title {
    font-size: var(--text-h4);
    font-family: var(--font-family-heading);
    font-weight: 750;
    color: var(--awc-navy, #173047);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.3;
  }

  .rule-desc {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* Canonical Related Navigation Grid */
  .related-nav {
    margin: var(--space-12) 0;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-10);
  }

  .related-header {
    margin-bottom: var(--space-6);
  }

  .related-eyebrow {
    display: inline-block;
    font-size: var(--text-caption);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-brand);
    margin-bottom: var(--space-2);
  }

  .related-title {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--awc-navy, #173047);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.02em;
  }

  .related-desc {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 640px;
    line-height: 1.55;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .related-card {
    background: #ffffff;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-fast);
  }

  .related-card:hover {
    border-color: var(--color-border-interactive);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(22, 135, 126, 0.08);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .card-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .card-tag {
    font-size: 11px;
    font-weight: 750;
    color: var(--color-text-brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: var(--text-body);
    font-family: var(--font-family-heading);
    font-weight: 750;
    color: var(--awc-navy, #173047);
    margin: 0 0 var(--space-2) 0;
  }

  .card-desc {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0 0 var(--space-4) 0;
    flex-grow: 1;
  }

  .card-action {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    align-self: flex-start;
  }

  /* Centralized Regulatory Disclosure Notice */
  .regulatory-disclosure-note {
    background: var(--awc-sand, #F8EEE4);
    border: 1px solid var(--primitive-gold-100, #F7E4BE);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    margin-top: var(--space-10);
  }

  .regulatory-disclosure-note p {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy, #173047);
  }
</style>
