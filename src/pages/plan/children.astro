---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import ChildrenFuturePlannerIsland from '../../features/calculators/ChildrenFuturePlannerIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/plan/children/');
const { regulatory, disclosures } = BUSINESS_PROFILE;
const registrationNotice = regulatory.registrationStatusText;
---

<BaseLayout
  title="Children's Education & Milestone Planner — Ant Wealth Creation"
  description="Plan for your children's higher education, post-graduation, and marriage milestones with inflation-adjusted targets and SIP calculations."
  currentPath="/plan/children/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/plan/children/" />

    <PageIntro
      eyebrow="Milestone Roadmap · Multi-Child Family Planner"
      title="Plan ahead for your child's education and milestones."
      description="Estimate future costs with education inflation, account for savings you have already earmarked, and calculate the monthly SIP required for each child."
      statusBadge="Interactive Family Planner • Multi-Milestone Aggregation"
      icon="🎒"
    />

    <ChildrenFuturePlannerIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Children's Future Planner"
      promptQuestion="Want to set up a dedicated mutual fund portfolio for your children's education?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory &amp; Educational Notice:</strong> {registrationNotice}. {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} Projected education and milestone corpora depend on user-selected cost inflation and assumed rate-of-return inputs.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
