---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import { getBreadcrumbsForPath } from '../config/routes';
import { BUSINESS_PROFILE } from '../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/contact/');
const { contact } = BUSINESS_PROFILE;
---

<BaseLayout
  title="Contact Us & Direct Consultation — Ant Wealth Creation"
  description="Connect directly with founder C. Santhosh Sathriyan at Ant Wealth Creation via phone, WhatsApp, or email to discuss your family wealth roadmap."
  currentPath="/contact/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Direct Connection"
      title="Contact Ant Wealth Creation"
      description="No call centres, no sales bots. Reach out directly to founder C. Santhosh Sathriyan to discuss your family's personal finance milestones."
      icon="💬"
    />

    <div class="contact-layout-grid">
      <div class="contact-channels-col">
        <h2 class="col-heading">Direct Contact Channels</h2>

        <div class="channel-cards">
          <div class="channel-card primary-channel">
            <span class="channel-type">Instant Messaging</span>
            <h3 class="channel-title">WhatsApp Discussion</h3>
            <p class="channel-desc">Direct messaging for preliminary questions or to schedule a 1-on-1 discovery call.</p>
            <a
              href={contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-channel btn-whatsapp"
            >
              Chat on WhatsApp ({contact.phoneDisplay}) →
            </a>
          </div>

          <div class="channel-card">
            <span class="channel-type">Direct Phone</span>
            <h3 class="channel-title">Telephone Consultation</h3>
            <p class="channel-desc">Available for planned consultation calls and active client inquiries.</p>
            <a href={`tel:${contact.phone}`} class="channel-link">
              {contact.phoneDisplay}
            </a>
          </div>

          <div class="channel-card">
            <span class="channel-type">Email Communication</span>
            <h3 class="channel-title">Email Inquiries</h3>
            <p class="channel-desc">Send milestone planning questions, consultation requests, or general inquiries.</p>
            <a href={`mailto:${contact.email}`} class="channel-link">
              {contact.email}
            </a>
          </div>

          <div class="channel-card">
            <span class="channel-type">Office Location</span>
            <h3 class="channel-title">Headquarters</h3>
            <p class="channel-desc">{contact.locationDisplay}</p>
          </div>
        </div>

        <div class="portal-box">
          <h3 class="portal-heading">Client Portal</h3>
          <p class="portal-text">Existing clients can access their distributor portal account (TheMFBox) via secure login:</p>
          <a
            href={contact.portfolioLoginUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-portal"
          >
            Launch Client Portal (TheMFBox) →
          </a>
          <p class="portal-subtext">Note: The external portal requires individual login credentials. Its authenticated features are operated by the third-party provider and are not verified by this informational website.</p>
        </div>
      </div>

      <div class="consultation-guidelines-col">
        <div class="guidelines-card">
          <h2 class="col-heading">What to Expect During a Consultation</h2>
          <p class="guidelines-intro">
            We value your time and confidentiality. Here is how we conduct our initial financial discussions:
          </p>

          <ol class="guidelines-steps">
            <li>
              <strong>Goal Discovery First:</strong> We understand your family priorities—children's college horizons, retirement dreams, or home debt—before discussing any investment product.
            </li>
            <li>
              <strong>Protection Review:</strong> We verify that your emergency fund and health/life insurance shields are adequate to protect your dependents.
            </li>
            <li>
              <strong>No High-Pressure Sales:</strong> We never push high-commission insurance endowments, complex ULIPs, or speculative trading tips.
            </li>
            <li>
              <strong>Transparent Intermediation:</strong> All mutual fund distributor commissions, intermediary status, and regulatory disclosures are stated upfront. Read our <a href="/commission-disclosure/" class="consultation-link">Commission Disclosure</a> for full details.
            </li>
          </ol>

          <div class="security-notice-box">
            <div class="notice-icon-wrap" aria-hidden="true">🛡️</div>
            <div class="notice-content">
              <strong class="notice-title">Protect Your Sensitive Information</strong>
              <p class="notice-text">
                Please do not send passwords, OTPs, full bank account numbers, login credentials, or unencrypted financial statements over ordinary email or WhatsApp. We will never ask you for passwords, OTPs, or bank credentials. When document review is required, a secure sharing method will be coordinated directly.
              </p>
            </div>
          </div>

          <div class="confidentiality-notice">
            <div class="notice-icon-wrap" aria-hidden="true">🔒</div>
            <div class="notice-content">
              <strong class="notice-title">Client Privacy &amp; Confidentiality</strong>
              <p class="notice-text">
                Your personal details and milestone plans are held in strict confidence and handled in accordance with our <a href="/privacy/" class="notice-link">Privacy Policy</a> and enquiry retention schedule. We never sell your personal information to third-party marketers.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-bottom: var(--space-16);
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .contact-layout-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
    }
  }

  .col-heading {
    font-size: var(--text-h2);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-6);
  }

  .channel-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .channel-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
  }

  .primary-channel {
    border-color: var(--color-border-interactive);
    border-width: 2px;
    background-color: var(--awc-jade-soft);
  }

  .channel-type {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-1);
  }

  .channel-title {
    font-size: var(--text-h4);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-1);
  }

  .channel-desc {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .channel-link {
    display: inline-block;
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-brand-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .channel-link:hover {
    color: var(--color-text-brand);
    text-decoration: underline;
  }

  .channel-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .btn-channel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-body-sm);
    font-weight: 700;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    text-decoration: none;
    min-height: 44px;
    transition: background-color var(--transition-fast);
  }

  .btn-whatsapp {
    background-color: #128C7E;
    color: var(--primitive-white);
  }

  .btn-whatsapp:hover {
    background-color: #0b685d;
  }

  .btn-whatsapp:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .portal-box {
    background-color: var(--awc-mist);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .portal-heading {
    font-size: var(--text-h4);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .portal-text {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .btn-portal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text-brand);
    background-color: var(--color-bg-surface);
    text-decoration: none;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    min-height: 44px;
    transition: all var(--transition-fast);
  }

  .btn-portal:hover {
    background-color: var(--awc-jade-soft);
    border-color: var(--awc-mint);
    color: var(--color-action-hover);
  }

  .btn-portal:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .portal-subtext {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-top: var(--space-3);
    margin-bottom: 0;
  }

  .guidelines-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-subtle);
  }

  .guidelines-intro {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .guidelines-steps {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .guidelines-steps li strong {
    color: var(--color-brand-primary);
  }

  .security-notice-box {
    background-color: var(--awc-sand);
    border: 1px solid var(--awc-line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    margin-bottom: var(--space-4);
  }

  .confidentiality-notice {
    background-color: var(--awc-paper);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .notice-icon-wrap {
    font-size: 1.35rem;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .notice-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .notice-title {
    font-size: var(--text-body-sm);
    font-weight: 700;
    color: var(--color-brand-primary);
  }

  .notice-text {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .notice-link,
  .consultation-link {
    color: var(--color-text-brand);
    text-decoration: underline;
    font-weight: 600;
  }

  .notice-link:hover,
  .consultation-link:hover {
    color: var(--color-action-hover);
  }

  .notice-link:focus-visible,
  .consultation-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
</style>
