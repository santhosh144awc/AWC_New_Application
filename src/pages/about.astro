---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import { getBreadcrumbsForPath } from '../config/routes';
import { BUSINESS_PROFILE } from '../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/about/');
const { founder, firm, regulatory, disclosures } = BUSINESS_PROFILE;
---

<BaseLayout
  title="About Us & Founder Story — Ant Wealth Creation"
  description="Learn about Ant Wealth Creation, our founder C. Santhosh Sathriyan, our insurance heritage, and our mission to simplify wealth creation for Indian families."
  currentPath="/about/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Our Mission & Heritage"
      title="About Ant Wealth Creation"
      description="Guiding Indian families toward financial confidence through disciplined, transparent, and goal-oriented wealth planning."
      icon="🧭"
    />

    <section class="founder-section" aria-labelledby="founder-heading">
      <div class="founder-grid">
        <div class="founder-image-col">
          <div class="founder-photo-wrapper">
            <img
              src={founder.photoPath}
              alt={`Photograph of ${founder.fullName}, Founder of Ant Wealth Creation`}
              class="founder-photo"
              loading="lazy"
              width="200"
              height="200"
            />
          </div>
          <div class="founder-badge-card">
            <div class="founder-name">{founder.fullName}</div>
            <div class="founder-creds">{founder.credentials}</div>
            <div class="founder-role">{founder.designation}</div>
            <div class="founder-loc">{firm.headquarters}</div>
          </div>
        </div>

        <div class="founder-content-col">
          <span class="eyebrow-accent">Meet the Founder</span>
          <h2 id="founder-heading" class="founder-title">
            "{founder.quote}"
          </h2>

          <div class="founder-narrative">
            <p>
              {founder.bio}
            </p>
            <p>
              {founder.heritage}
            </p>
            <p>
              {founder.foundingStory}
            </p>
          </div>

          <div class="milestones-row">
            <div class="milestone-box">
              <span class="milestone-num">{firm.experienceSince}</span>
              <span class="milestone-label">Market Experience Since</span>
            </div>
            <div class="milestone-box">
              <span class="milestone-num">{firm.foundingYear}</span>
              <span class="milestone-label">Firm Established</span>
            </div>
            <div class="milestone-box">
              <span class="milestone-num">Dharmapuri, TN</span>
              <span class="milestone-label">Headquarters Location</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="principles-section" aria-labelledby="principles-heading">
      <h2 id="principles-heading" class="section-title">The Four Core Pillars of Our Practice</h2>
      <p class="section-desc">
        These four non-negotiable principles guide our client conversations, planning frameworks, and educational resources:
      </p>

      <div class="principles-grid">
        <div class="principle-card">
          <div class="principle-number">01</div>
          <h3 class="principle-title">Family Protection First</h3>
          <p class="principle-text">
            Wealth creation begins with risk resilience. We prioritize maintaining an adequate emergency cushion, pure term life cover, and comprehensive health insurance before committing surplus capital to market-linked investments.
          </p>
        </div>

        <div class="principle-card">
          <div class="principle-number">02</div>
          <h3 class="principle-title">Clarity Over Jargon</h3>
          <p class="principle-text">
            Financial planning should be approachable and understandable. We explain compounding dynamics, asset allocation, and tax treatment using clear, practical frameworks tailored to everyday family decisions.
          </p>
        </div>

        <div class="principle-card">
          <div class="principle-number">03</div>
          <h3 class="principle-title">Goal-Centric Planning</h3>
          <p class="principle-text">
            We avoid speculative stock tips and short-term market timing. Investments are mapped to specific family milestones—such as children's higher education, home acquisition, or retirement living.
          </p>
        </div>

        <div class="principle-card">
          <div class="principle-number">04</div>
          <h3 class="principle-title">Transparent Intermediation</h3>
          <p class="principle-text">
            We provide mutual fund distribution services with complete transparency regarding distributor commissions, intermediary status, and investment risk.
          </p>
        </div>
      </div>
    </section>

    <section class="regulatory-disclosure-box" aria-labelledby="reg-heading">
      <h2 id="reg-heading" class="reg-title">Regulatory Standing &amp; Professional Roles</h2>
      <p class="reg-text">
        <strong>{regulatory.registrationStatusText}:</strong> {regulatory.sebiRIAStatusNotice}
      </p>
      <p class="reg-text">
        <strong>Professional Roles of C. Santhosh Sathriyan:</strong>
      </p>
      <ul class="reg-roles-list">
        {founder.professionalRoles.map((role: string) => <li>{role}</li>)}
      </ul>
      <p class="reg-text">
        <strong>Business Structure:</strong> {regulatory.soleProprietorStatement}
      </p>
      <p class="reg-text">
        {disclosures.mutualFundRisk} For formal verification, visit the <a href={regulatory.arnVerificationSourceUrl} target="_blank" rel="noopener noreferrer" class="reg-link">AMFI Official Distributor Portal</a>.
      </p>
    </section>

    <section class="next-steps-section" aria-labelledby="next-steps-heading">
      <div class="next-steps-card">
        <div class="next-steps-content">
          <h2 id="next-steps-heading" class="next-steps-title">Start Your Family Financial Journey</h2>
          <p class="next-steps-desc">
            Diagnose your household financial health or reach out directly to begin a structured personal finance roadmap.
          </p>
        </div>
        <div class="next-steps-actions">
          <a href="/health-check/" class="btn-primary">Take 7-Pillars Health Check →</a>
          <a href="/contact/" class="btn-secondary">Contact & Consultation →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-bottom: var(--space-16);
  }

  .founder-section {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    margin-bottom: var(--space-16);
    box-shadow: var(--shadow-subtle);
  }

  @media (min-width: 1024px) {
    .founder-section {
      padding: var(--space-12);
    }
  }

  .founder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 768px) {
    .founder-grid {
      grid-template-columns: 280px 1fr;
      gap: var(--space-12);
    }
  }

  .founder-image-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .founder-photo-wrapper {
    width: 200px;
    height: 200px;
    border-radius: var(--radius-pill);
    overflow: hidden;
    border: 4px solid var(--color-border-interactive);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-4);
    background-color: var(--awc-mist);
  }

  .founder-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .founder-badge-card {
    background-color: var(--awc-paper);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-4);
    width: 100%;
    max-width: 260px;
  }

  .founder-name {
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-brand-primary);
  }

  .founder-creds {
    font-size: var(--text-caption);
    color: var(--color-text-brand);
    font-weight: 600;
    margin: var(--space-1) 0;
  }

  .founder-role {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-1);
  }

  .founder-loc {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .eyebrow-accent {
    font-size: var(--text-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-brand);
    display: block;
    margin-bottom: var(--space-2);
  }

  .founder-title {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    line-height: 1.35;
    margin-bottom: var(--space-6);
  }

  .founder-narrative {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .milestones-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-6);
  }

  @media (max-width: 480px) {
    .milestones-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  .milestone-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .milestone-num {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--color-brand-primary);
    line-height: 1.2;
  }

  .milestone-label {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .principles-section {
    margin-bottom: var(--space-16);
  }

  .section-title {
    font-size: var(--text-h2);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .section-desc {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    max-width: 720px;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .principle-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
  }

  .principle-number {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--awc-jade);
    margin-bottom: var(--space-2);
  }

  .principle-title {
    font-size: var(--text-h4);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .principle-text {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .regulatory-disclosure-box {
    background-color: var(--awc-mist);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .reg-title {
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .reg-text {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }

  .reg-text:last-child {
    margin-bottom: 0;
  }

  .reg-roles-list {
    margin: 0 0 var(--space-3) 0;
    padding-left: var(--space-5);
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .reg-link {
    color: var(--color-text-brand);
    text-decoration: underline;
    font-weight: 600;
  }

  .reg-link:hover {
    color: var(--color-action-hover);
  }

  .reg-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .next-steps-section {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-10);
  }

  .next-steps-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    box-shadow: var(--shadow-subtle);
  }

  @media (min-width: 768px) {
    .next-steps-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .next-steps-content {
    max-width: 600px;
  }

  .next-steps-title {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .next-steps-desc {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .next-steps-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 480px) {
    .next-steps-actions {
      flex-direction: row;
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--primitive-white);
    background-color: var(--color-action);
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    min-height: 44px;
    transition: background-color var(--transition-fast);
  }

  .btn-primary:hover {
    background-color: var(--color-action-hover);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text-brand);
    background-color: var(--color-bg-surface);
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    min-height: 44px;
    transition: all var(--transition-fast);
  }

  .btn-secondary:hover {
    background-color: var(--awc-jade-soft);
    border-color: var(--awc-mint);
    color: var(--color-action-hover);
  }

  .btn-secondary:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
</style>
