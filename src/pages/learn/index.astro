---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import { getBreadcrumbsForPath } from '../../config/routes';

const crumbs = getBreadcrumbsForPath('/learn/');

// Retrieve all approved educational guides from the articles content collection
const approvedArticles = await getCollection('articles', ({ data }) => {
  return data.publicationStatus === 'APPROVED';
});

// Sort by featured first, then by date descending
approvedArticles.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

// Distinct categories for quick reference
const categories = Array.from(new Set(approvedArticles.map((a) => a.data.category)));
---

<BaseLayout
  title="Financial Learning Library | Ant Wealth Creation"
  description="Practical, fluff-free financial guides designed for Indian families. Learn how compounding works, how to choose mutual funds, and how to protect what you build."
  canonicalUrl="https://antwealth.in/learn/"
>
  <div class="learn-page">
    <div class="container">
      <Breadcrumbs items={crumbs} />

      <PageIntro
        eyebrow="Financial Education & Insights"
        title="Knowledge That Protects and Grows Family Wealth"
        description="Clear, honest, and practical financial guides tailored for Indian families. No financial jargon, no product pitching—just timeless principles for disciplined compounding."
      />

      <!-- Categories Summary Bar -->
      <div class="categories-bar" aria-label="Article categories">
        <span class="categories-label">Browse Topics:</span>
        <div class="categories-tags">
          {categories.map((cat) => (
            <span class="cat-pill">{cat}</span>
          ))}
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="articles-grid" role="feed" aria-label="Published learning guides">
        {approvedArticles.map((article) => (
          <article class={`article-card ${article.data.featured ? 'featured' : ''}`}>
            <div class="card-meta">
              <span class="card-category">{article.data.category}</span>
              <span class="card-time">{article.data.readingTime}</span>
            </div>

            <h2 class="card-title">
              <a href={`/learn/${article.id}/`} class="card-title-link">
                {article.data.title}
              </a>
            </h2>

            <p class="card-summary">{article.data.description}</p>

            <div class="card-footer">
              <div class="card-tags">
                {article.data.tags.slice(0, 3).map((tag) => (
                  <span class="card-tag">#{tag}</span>
                ))}
              </div>

              <a href={`/learn/${article.id}/`} class="read-more-link" aria-label={`Read full guide: ${article.data.title}`}>
                Read Guide &rarr;
              </a>
            </div>

            {article.data.calculatorCTA && (
              <div class="card-tool-strip">
                <span class="tool-strip-label">Related Tool:</span>
                <a href={article.data.calculatorCTA.href} class="tool-strip-link">
                  {article.data.calculatorCTA.buttonLabel}
                </a>
              </div>
            )}
          </article>
        ))}
      </div>

      <!-- Review Transparency Notice -->
      <aside class="review-notice" aria-labelledby="review-notice-title">
        <div class="notice-icon" aria-hidden="true">&#9432;</div>
        <div class="notice-content">
          <h3 id="review-notice-title" class="notice-title">Editorial Standards & Ongoing Review</h3>
          <p class="notice-text">
            Ant Wealth Creation adheres to strict factual verification. Two advanced roadmap guides covering post-retirement cash flow distributions and home loan prepayment vs mutual fund investing are currently withheld under qualified professional review (GATE-A & GATE-C) to ensure 100% statutory alignment with the Income-tax Act, 2025.
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .learn-page {
    padding: var(--space-6) 0 var(--space-16);
    background-color: var(--color-surface-sunken);
    overflow-x: hidden;
  }

  .container {
    max-width: var(--container-width-desktop);
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .categories-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-8);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    max-width: 100%;
    box-sizing: border-box;
  }

  .categories-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .categories-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cat-pill {
    display: inline-block;
    padding: 2px 10px;
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .article-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .article-card {
      padding: var(--space-6);
    }
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .article-card.featured {
    border-top: 4px solid var(--color-primary);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .card-category {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-time {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
  }

  .card-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    line-height: var(--line-height-tight);
    margin: 0 0 var(--space-3);
    color: var(--color-text-primary);
    word-break: break-word;
  }

  .card-title-link {
    color: inherit;
    text-decoration: none;
  }

  .card-title-link:hover, .card-title-link:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .card-summary {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--space-4);
    flex-grow: 1;
    word-break: break-word;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card-tag {
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  .read-more-link {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .read-more-link:hover {
    text-decoration: underline;
  }

  .card-tool-strip {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-sm);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    font-size: var(--font-size-xs);
  }

  .tool-strip-label {
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .tool-strip-link {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
    word-break: break-word;
  }

  .tool-strip-link:hover {
    text-decoration: underline;
  }

  .review-notice {
    margin-top: var(--space-12);
    padding: var(--space-5) var(--space-6);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .notice-icon {
    font-size: var(--font-size-xl);
    color: var(--color-accent);
    line-height: 1;
  }

  .notice-title {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .notice-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }
</style>
