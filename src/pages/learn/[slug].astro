---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => {
    return data.publicationStatus === 'APPROVED';
  });

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const canonicalUrl = `https://antwealth.in/learn/${article.id}/`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn/' },
  { label: article.data.title },
];

// Filter h2 and h3 headings for Table of Contents
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Fetch only other approved articles for related reading (exclude current article)
// Prioritize approved articles from the same category first, followed by others, deterministically
const allApprovedOther = await getCollection('articles', ({ data, id }) => {
  return data.publicationStatus === 'APPROVED' && id !== article.id;
});

const sameCategory = allApprovedOther.filter((a) => a.data.category === article.data.category);
const otherCategories = allApprovedOther.filter((a) => a.data.category !== article.data.category);

sameCategory.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime() || a.id.localeCompare(b.id));
otherCategories.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime() || a.id.localeCompare(b.id));

const relatedArticles = [...sameCategory, ...otherCategories].slice(0, 3);
---

<BaseLayout
  title={`${article.data.title} | Ant Wealth Creation`}
  description={article.data.description}
  canonicalUrl={canonicalUrl}
>
  <div class="article-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-header">
        <div class="article-meta-top">
          <span class="category-badge">{article.data.category}</span>
          <span class="reading-time">{article.data.readingTime}</span>
          <time datetime={article.data.publishDate} class="publish-date">
            Published {new Date(article.data.publishDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
        </div>

        <h1 class="article-title">{article.data.title}</h1>
        <p class="article-lead">{article.data.description}</p>

        <div class="author-card">
          <div class="author-avatar" aria-hidden="true">SS</div>
          <div class="author-details">
            <span class="author-name">{article.data.author}</span>
            <span class="author-title">{article.data.authorTitle || "Mutual Fund Distributor"}</span>
          </div>
        </div>
      </header>

      <div class="article-layout">
        <!-- Main Article Content -->
        <main class="article-body" id="article-content">
          <div class="prose-content">
            <Content />
          </div>

          {article.data.calculatorCTA && (
            <aside class="article-cta-box" aria-labelledby="cta-title">
              <div class="cta-content">
                <span class="cta-eyebrow">Interactive Financial Tool</span>
                <h2 id="cta-title" class="cta-heading">{article.data.calculatorCTA.title}</h2>
                <p class="cta-description">{article.data.calculatorCTA.description}</p>
              </div>
              <a href={article.data.calculatorCTA.href} class="cta-btn">
                {article.data.calculatorCTA.buttonLabel} &rarr;
              </a>
            </aside>
          )}

          <div class="article-footer-nav">
            <a href="/learn/" class="back-link">&larr; Back to all learning guides</a>
          </div>
        </main>

        <!-- Sidebar / Table of Contents & Related Topics -->
        <aside class="article-sidebar" aria-label="Table of Contents and Related Topics">
          {tocHeadings.length > 0 && (
            <nav class="toc-card" aria-labelledby="toc-heading">
              <h2 id="toc-heading" class="toc-title">In this article</h2>
              <ul class="toc-list">
                {tocHeadings.map((heading) => (
                  <li class={`toc-item depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`} class="toc-link">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {relatedArticles.length > 0 && (
            <div class="related-card" aria-labelledby="related-heading">
              <h2 id="related-heading" class="related-title">More Practical Guides</h2>
              <ul class="related-list">
                {relatedArticles.map((rel) => (
                  <li class="related-item">
                    <span class="related-cat">{rel.data.category}</span>
                    <a href={`/learn/${rel.id}/`} class="related-link">
                      {rel.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="disclaimer-note">
            <p>
              <strong>Investor Note:</strong> All examples are illustrative and not financial guarantees or personalized advice. Mutual fund investments are subject to market risks. Read all scheme-related documents carefully.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page {
    padding: var(--space-6) 0 var(--space-16);
    background-color: var(--color-bg-canvas);
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
    width: 100%;
  }

  .article-header {
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
    max-width: 880px;
  }

  .article-meta-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    background-color: var(--awc-jade-soft);
    color: var(--color-text-brand);
    border: 1px solid var(--color-border-subtle);
    font-size: var(--text-caption);
    font-weight: 700;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .reading-time, .publish-date {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
  }

  .article-title {
    font-size: var(--text-h1);
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4);
    font-weight: 800;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .article-lead {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-6);
    max-width: 72ch;
  }

  .author-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-subtle);
  }

  .author-avatar {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: var(--radius-pill);
    background-color: var(--awc-navy);
    color: var(--color-text-inverse);
    font-size: var(--text-caption);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: var(--text-body-sm);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .author-title {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  /* Two-column Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }

  /* Main Body Prose */
  .article-body {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
    min-width: 0;
    overflow-wrap: break-word;
  }

  @media (min-width: 768px) {
    .article-body {
      padding: var(--space-8) var(--space-10);
    }
  }

  .prose-content {
    color: var(--color-text-primary);
    font-size: var(--text-body);
    line-height: 1.7;
    max-width: 70ch;
  }

  .prose-content :global(h2) {
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: var(--space-10) 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle);
    letter-spacing: -0.01em;
    line-height: 1.25;
    scroll-margin-top: var(--space-8);
  }

  .prose-content :global(h3) {
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: var(--space-8) 0 var(--space-3);
    line-height: 1.3;
    scroll-margin-top: var(--space-8);
  }

  .prose-content :global(p) {
    margin: 0 0 var(--space-5);
    color: var(--color-text-secondary);
  }

  .prose-content :global(ul), .prose-content :global(ol) {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-6);
    color: var(--color-text-secondary);
  }

  .prose-content :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.65;
  }

  .prose-content :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    background-color: var(--awc-paper);
    border-left: 4px solid var(--awc-jade);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .prose-content :global(a) {
    color: var(--color-text-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .prose-content :global(a:hover),
  .prose-content :global(a:focus-visible) {
    color: var(--color-action-hover);
  }

  .prose-content :global(strong) {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .prose-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border-subtle);
    margin: var(--space-8) 0;
  }

  .prose-content :global(em) {
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
    display: block;
    margin-top: var(--space-6);
    line-height: 1.6;
  }

  /* Code-free Responsive Tables */
  .prose-content :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: var(--text-body-sm);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .prose-content :global(th),
  .prose-content :global(td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-subtle);
    text-align: left;
    min-width: 120px;
  }

  .prose-content :global(th) {
    background-color: var(--awc-paper);
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .prose-content :global(td) {
    background-color: var(--color-bg-surface);
    color: var(--color-text-secondary);
  }

  /* Interactive Tool CTA Box */
  .article-cta-box {
    margin-top: var(--space-10);
    padding: var(--space-6);
    background: linear-gradient(135deg, var(--awc-mist) 0%, rgba(207, 239, 227, 0.45) 100%);
    border: 1px solid var(--color-border-subtle);
    border-left: 4px solid var(--awc-jade);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .article-cta-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }

  .cta-content {
    flex: 1;
    min-width: 0;
  }

  .cta-eyebrow {
    display: block;
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-1);
  }

  .cta-heading {
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1);
    line-height: 1.3;
  }

  .cta-description {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-action);
    color: var(--color-text-inverse);
    font-size: var(--text-body-sm);
    font-weight: 600;
    border-radius: var(--radius-md);
    text-decoration: none;
    white-space: nowrap;
    align-self: flex-start;
    transition: background-color var(--transition-fast);
    border: 1px solid transparent;
  }

  .cta-btn:hover {
    background-color: var(--color-action-hover);
  }

  .cta-btn:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .cta-btn {
      align-self: center;
      flex-shrink: 0;
    }
  }

  .article-footer-nav {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text-brand);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-action-hover);
    text-decoration: underline;
  }

  /* Sidebar */
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      position: sticky;
      top: var(--space-6);
      max-height: calc(100vh - var(--space-12));
      overflow-y: auto;
    }
  }

  .toc-card, .related-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-subtle);
    box-sizing: border-box;
    width: 100%;
  }

  .toc-title, .related-title {
    font-size: var(--text-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .toc-list, .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: var(--space-2);
  }

  .toc-item.depth-3 {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-border-subtle);
    margin-left: var(--space-1);
  }

  .toc-link {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    line-height: 1.4;
    display: block;
    transition: color var(--transition-fast);
    overflow-wrap: break-word;
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--color-text-brand);
    text-decoration: underline;
  }

  .related-item {
    margin-bottom: var(--space-4);
  }

  .related-item:last-child {
    margin-bottom: 0;
  }

  .related-cat {
    display: block;
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }

  .related-link {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
    display: block;
    line-height: 1.4;
    transition: color var(--transition-fast);
    overflow-wrap: break-word;
  }

  .related-link:hover,
  .related-link:focus-visible {
    color: var(--color-text-brand);
    text-decoration: underline;
  }

  .disclaimer-note {
    padding: var(--space-4);
    background-color: var(--awc-paper);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .disclaimer-note p {
    margin: 0;
  }

  .disclaimer-note strong {
    color: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-btn,
    .back-link,
    .toc-link,
    .related-link {
      transition: none !important;
    }
  }
</style>
