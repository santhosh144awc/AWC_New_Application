---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import LumpSumCalculatorIsland from '../../features/calculators/LumpSumCalculatorIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/tools/lumpsum/');
const { regulatory, disclosures } = BUSINESS_PROFILE;

const registrationNotice = regulatory.arnStatus === 'CONFIRMED'
  ? 'Ant Wealth Creation is an AMFI-registered mutual fund distributor.'
  : `Ant Wealth Creation provides ${regulatory.registrationStatusText}.`;
---

<BaseLayout
  title="Lump Sum Calculator: See What One Investment Could Become — Ant Wealth Creation"
  description="Model compound growth for a one-time lump-sum investment across custom time horizons and assumed return rates with transparent mathematical assumptions."
  canonicalUrl="https://antwealth.in/tools/lumpsum/"
  currentPath="/tools/lumpsum/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/tools/lumpsum/" />

    <PageIntro
      eyebrow="Money Lab · One-Time Investing"
      title="See what one investment could become."
      description="Adjust the one-time amount, investment horizon, and assumed annual return to evaluate long-term compounding."
    />

    <LumpSumCalculatorIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Lump Sum Growth Calculator"
      promptQuestion="Planning how to deploy a one-time bonus or maturity amount?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {registrationNotice} {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} The Lump Sum calculator generates mathematical projections based on hypothetical user-selected rates of return and does not predict or guarantee fund performance, capital preservation, or actual future returns.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
