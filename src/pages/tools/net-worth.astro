---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import NetWorthCalculatorIsland from '../../features/calculators/NetWorthCalculatorIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/tools/net-worth/');
const { regulatory, disclosures } = BUSINESS_PROFILE;

const registrationNotice = regulatory.arnStatus === 'CONFIRMED'
  ? 'Ant Wealth Creation is an AMFI-registered mutual fund distributor.'
  : `Ant Wealth Creation provides ${regulatory.registrationStatusText}.`;
---

<BaseLayout
  title="Family Net Worth & Balance Sheet Calculator — Ant Wealth Creation"
  description="Consolidate all family financial assets, physical real estate, retirement savings, and outstanding liabilities into a true net worth baseline."
  currentPath="/tools/net-worth/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/tools/net-worth/" />

    <PageIntro
      eyebrow="Money Lab · Solvency Diagnostic"
      title="Family Net Worth & Balance Sheet Calculator"
      description="Add what the household owns and owes to see an instant net worth snapshot separating financial assets from personal-use property."
    />

    <NetWorthCalculatorIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Quick Net Worth Calculator"
      promptQuestion="Want a full 6-stage cash flow and balance sheet statement with a 5-page PDF?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {registrationNotice} {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} The Net Worth Calculator provides an illustrative mathematical aggregation of user-entered assets and liabilities and does not constitute a formal net worth certificate, audit, credit rating, or investment recommendation.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: var(--space-8);
    padding: var(--space-4) var(--space-5);
    background-color: var(--primitive-gold-50);
    border: 1px solid var(--primitive-gold-100);
    border-radius: 12px;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--color-brand-primary);
  }
</style>
