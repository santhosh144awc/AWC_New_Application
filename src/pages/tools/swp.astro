---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import SwpCalculatorIsland from '../../features/calculators/SwpCalculatorIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/tools/swp/');
const { regulatory, disclosures } = BUSINESS_PROFILE;
---

<BaseLayout
  title="SWP Longevity & Systematic Withdrawal Simulator — Ant Wealth Creation"
  description="Simulate monthly systematic withdrawals, inflation-adjusted cash flows, and capital longevity over a 50-year horizon."
  currentPath="/tools/swp/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/tools/swp/" />

    <PageIntro
      eyebrow="Cash Flow & Retirement"
      title="SWP Longevity & Systematic Withdrawal Simulator"
      description="Model how long your investment corpus can sustain regular monthly withdrawals under inflation and assumed return rates."
      statusBadge="Interactive Calculator Active • 50-Year Simulation"
    />

    <SwpCalculatorIsland client:load />

    <WhatsAppToolLeadBar
      toolName="SWP Longevity Simulator"
      promptQuestion="Planning a monthly retirement income or SWP cash flow?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {regulatory.registrationStatusText}. {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} SWP projections are mathematical simulations assuming linear monthly compounding and do not guarantee regular income or protect against sequence-of-returns risk.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
