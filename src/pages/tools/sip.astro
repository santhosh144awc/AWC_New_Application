---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import StatusNotice from '../../components/ui/StatusNotice.astro';
import { getBreadcrumbsForPath } from '../../config/routes';

const crumbs = getBreadcrumbsForPath('/tools/sip/');
---

<BaseLayout
  title="Monthly SIP Wealth Compounding Simulator — Ant Wealth Creation"
  description="Model monthly mutual fund compounding, annual step-up SIP acceleration, and long-term purchasing power with transparent mathematical assumptions."
  currentPath="/tools/sip/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Investment Simulator"
      title="Monthly SIP Wealth Compounding Simulator"
      description="Systematic Investment Plans (SIPs) transform small, disciplined monthly savings into substantial milestone capital. This tool models long-term compounding and illustrates how increasing your SIP annually accelerates goal achievement."
      statusBadge="GATE-B Rate Semantics Review Pending"
    />

    <StatusNotice
      featureName="SIP Mathematical Compounding Engine"
      gateNote="Under GATE-B (Annual Return & Monthly Compounding Semantics), whether the calculator operates on nominal monthly division (r/12) or effective geometric compounding ((1+r)^(1/12)-1) is being formalized into a single shared rate-conversion policy. In this shell, the planning parameters and compounding dynamics are presented without mock calculations."
      expectedInputs={[
        "Monthly investment installment amount (e.g., ₹5,000 to ₹1,00,000)",
        "Assumed annual return rate (illustrative assumption, e.g. 8% to 14%)",
        "Investment tenure in years (e.g. 5, 10, 15, 20+ years)",
        "Optional Annual Step-Up percentage (e.g. 5% to 15% increase per year)",
      ]}
      expectedOutputs={[
        "Total amount invested over the chosen tenure",
        "Estimated final maturity wealth corpus",
        "Estimated compound earnings generated",
        "Year-by-year invested amount vs corpus accumulation breakdown table",
        "Comparison of Fixed SIP vs Annual Step-Up SIP outcome",
      ]}
    />

    <section class="educational-insight-box" aria-labelledby="insight-heading">
      <h2 id="insight-heading" class="section-title">The Power of the Annual Step-Up SIP</h2>
      <p class="section-desc">
        As your career progresses and family income increases, increasing your monthly SIP by just 10% each year can nearly double your final corpus compared to keeping your contribution constant:
      </p>

      <div class="stepup-comparison-grid">
        <div class="stepup-card">
          <span class="stepup-type">Fixed Monthly SIP</span>
          <div class="stepup-metric">₹10,000 / month</div>
          <p class="stepup-desc">Remaining at ₹10,000 every month for 15 years results in ₹18 Lakhs invested capital.</p>
        </div>

        <div class="stepup-card featured-stepup">
          <span class="stepup-type">10% Annual Step-Up SIP</span>
          <div class="stepup-metric">₹10,000 starting (+10%/yr)</div>
          <p class="stepup-desc">Starting at ₹10,000 and stepping up alongside salary raises results in nearly ₹38 Lakhs invested capital with significantly accelerated compounding.</p>
        </div>
      </div>
    </section>

    <div class="nav-links-strip">
      <a href="/tools/" class="btn-subtle">← Back to All Tools</a>
      <a href="/tools/lumpsum/" class="btn-subtle">Explore Lump Sum Growth Calculator →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-bottom: var(--space-16);
  }

  .educational-insight-box {
    margin: var(--space-12) 0;
  }

  .section-title {
    font-size: var(--text-h2);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .section-desc {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    max-width: 720px;
  }

  .stepup-comparison-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .stepup-comparison-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stepup-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
  }

  .featured-stepup {
    border-color: var(--primitive-teal-500);
    border-width: 2px;
    background-color: var(--primitive-teal-50);
  }

  .stepup-type {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .stepup-metric {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-3);
  }

  .stepup-desc {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .nav-links-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-8);
    margin-top: var(--space-12);
  }

  .btn-subtle {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text-brand);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
  }

  .btn-subtle:hover {
    background-color: var(--primitive-teal-50);
    border-color: var(--primitive-teal-100);
  }
</style>
