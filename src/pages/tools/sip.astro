---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import SipCalculatorIsland from '../../features/calculators/SipCalculatorIsland';
import { getBreadcrumbsForPath } from '../../config/routes';

const crumbs = getBreadcrumbsForPath('/tools/sip/');
---

<BaseLayout
  title="Monthly SIP Wealth Compounding Simulator — Ant Wealth Creation"
  description="Model monthly mutual fund compounding, annual step-up SIP acceleration, and long-term purchasing power with transparent mathematical assumptions."
  canonicalUrl="https://antwealth.in/tools/sip/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Interactive Wealth Simulator"
      title="Monthly SIP Wealth Compounding Simulator"
      description="Systematic Investment Plans (SIPs) transform small, disciplined monthly savings into substantial milestone capital. This tool models long-term compounding and illustrates how increasing your SIP annually accelerates goal achievement."
    />

    <!-- Interactive SIP Calculator Island -->
    <SipCalculatorIsland client:load />

    <!-- Educational Deep-Dive Sections -->
    <section class="educational-insight-box" aria-labelledby="insight-heading">
      <h2 id="insight-heading" class="section-title">The Power of the Annual Step-Up SIP</h2>
      <p class="section-desc">
        As your career progresses and family income increases, increasing your monthly SIP by just 10% each year can nearly double your final corpus compared to keeping your contribution constant:
      </p>

      <div class="stepup-comparison-grid">
        <div class="stepup-card">
          <span class="stepup-type">Fixed Monthly SIP</span>
          <div class="stepup-metric">₹10,000 / month</div>
          <p class="stepup-desc">Remaining at ₹10,000 every month for 15 years results in ₹18 Lakhs invested capital.</p>
        </div>

        <div class="stepup-card featured-stepup">
          <span class="stepup-type">10% Annual Step-Up SIP</span>
          <div class="stepup-metric">₹10,000 starting (+10%/yr)</div>
          <p class="stepup-desc">Starting at ₹10,000 and stepping up alongside salary raises results in nearly ₹38 Lakhs invested capital with significantly accelerated compounding.</p>
        </div>
      </div>
    </section>

    <!-- Strategy Pillars -->
    <section class="strategy-section" aria-labelledby="strategy-heading">
      <h2 id="strategy-heading" class="section-title">Four Principles of Disciplined SIP Compounding</h2>
      <div class="strategy-grid">
        <div class="strategy-card">
          <div class="strategy-num">01</div>
          <h3 class="strategy-name">Rupee Cost Averaging</h3>
          <p class="strategy-text">
            When equity markets decline, your fixed monthly installment automatically purchases more mutual fund units. When markets rise, you buy fewer units. This eliminates emotional market timing.
          </p>
        </div>

        <div class="strategy-card">
          <div class="strategy-num">02</div>
          <h3 class="strategy-name">Time Over Market Timing</h3>
          <p class="strategy-text">
            Compounding is back-loaded: the growth generated in years 11 to 20 vastly exceeds the growth of the first decade. Staying invested through volatility is where true family wealth is created.
          </p>
        </div>

        <div class="strategy-card">
          <div class="strategy-num">03</div>
          <h3 class="strategy-name">Step-Up Discipline</h3>
          <p class="strategy-text">
            Commit bonuses and annual salary increments to increasing your SIP. Stepping up your investment rate before lifestyle inflation absorbs raises dramatically cuts your working horizon.
          </p>
        </div>

        <div class="strategy-card">
          <div class="strategy-num">04</div>
          <h3 class="strategy-name">Goal Alignment</h3>
          <p class="strategy-text">
            Do not run an SIP without a name. Earmark every SIP folio for a specific family milestone—children's education, primary home down payment, or self-sustaining retirement.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .educational-insight-box {
    margin-top: var(--space-10);
    padding: var(--space-8);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
    font-weight: 800;
  }

  .section-desc {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    max-width: 70ch;
    margin-bottom: var(--space-6);
  }

  .stepup-comparison-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .stepup-comparison-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .stepup-card {
    padding: var(--space-6);
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .featured-stepup {
    border-color: var(--color-primary-light);
    background: linear-gradient(135deg, rgba(26, 54, 93, 0.05) 0%, rgba(197, 160, 89, 0.08) 100%);
  }

  .stepup-type {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .stepup-metric {
    font-size: var(--font-size-xl);
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .stepup-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
    margin: 0;
  }

  .strategy-section {
    margin-top: var(--space-12);
  }

  .strategy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .strategy-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .strategy-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .strategy-card {
    padding: var(--space-6);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .strategy-num {
    font-size: var(--font-size-xs);
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .strategy-name {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .strategy-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }
</style>
