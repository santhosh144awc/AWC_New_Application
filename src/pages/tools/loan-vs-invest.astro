---
// Compatibility redirect for legacy route: /tools/loan-vs-invest/
// Canonical destination: /tools/home-loan-foreclosure/
const destination = '/tools/home-loan-foreclosure/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={`https://antwealth.in${destination}`} />
    <title>Redirecting to Home Loan Foreclosure vs SIP…</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body style="font-family: system-ui, -apple-system, sans-serif; padding: 2rem; text-align: center; color: #1e293b; background: #f8fafc;">
    <p>Redirecting to <a href={destination} style="color: #0f766e; text-decoration: underline; font-weight: 600;">Home Loan Foreclosure vs SIP</a>…</p>
  </body>
</html>
