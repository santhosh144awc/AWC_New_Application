---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import LifeInsurancePlannerIsland from '../../features/calculators/LifeInsurancePlannerIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/tools/life-insurance/');
const { regulatory, disclosures } = BUSINESS_PROFILE;

const registrationNotice = regulatory.arnStatus === 'CONFIRMED'
  ? 'Ant Wealth Creation is an AMFI-registered mutual fund distributor.'
  : `Ant Wealth Creation provides ${regulatory.registrationStatusText}.`;
---

<BaseLayout
  title="Life Insurance Needs Calculator — Ant Wealth Creation"
  description="Estimate the life cover your family may need using a 4-step needs-based model covering income replacement, debt clearance, and family goals."
  canonicalUrl="https://antwealth.in/tools/life-insurance/"
  currentPath="/tools/life-insurance/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/tools/life-insurance/" />

    <PageIntro
      eyebrow="Money Lab · Family Protection"
      title="How much life cover would your family need?"
      description="Estimate income support, debt payoff, and future goal funding across 4 clear steps to see your net life insurance cover gap."
      statusBadge="4-Step Needs-Based Planner • Educational Estimate"
      icon="🛡️"
    />

    <LifeInsurancePlannerIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Life Insurance Needs Audit"
      promptQuestion="Want to review your family's term life and health protection gap?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {registrationNotice} {disclosures.simulationDisclaimer} Life insurance calculations are illustrative needs-based mathematical estimates and do not constitute insurance underwriting, policy solicitation, or a formal financial guarantee.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
