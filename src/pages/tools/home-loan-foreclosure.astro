---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import LoanPrepaymentVsInvestmentIsland from '../../features/calculators/LoanPrepaymentVsInvestmentIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/tools/home-loan-foreclosure/');
const { regulatory, disclosures } = BUSINESS_PROFILE;

const registrationNotice = regulatory.arnStatus === 'CONFIRMED'
  ? 'Ant Wealth Creation is an AMFI-registered mutual fund distributor.'
  : `Ant Wealth Creation provides ${regulatory.registrationStatusText}.`;
---

<BaseLayout
  title="Home Loan Prepayment vs Parallel Investment Calculator — Ant Wealth Creation"
  description="Compare using extra monthly cash to prepay your home loan early against investing the same surplus in a monthly SIP."
  canonicalUrl="https://antwealth.in/tools/home-loan-foreclosure/"
  currentPath="/tools/home-loan-foreclosure/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/tools/home-loan-foreclosure/" />

    <PageIntro
      eyebrow="Money Lab · Home Loan Decisions"
      title="Should extra money go to your loan or an investment?"
      description="Compare prepaying a reducing-balance home loan early against investing the same monthly surplus into a SIP."
    />

    <LoanPrepaymentVsInvestmentIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Home Loan Prepayment vs SIP Calculator"
      promptQuestion="Deciding whether to prepay your home loan or start a parallel SIP?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {registrationNotice} {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} Loan prepayment and parallel investment comparisons are mathematical illustrations based on user-supplied loan terms and assumed investment returns. Prepayment rules, lender charges, and floating interest rates vary by loan agreement. Tax effects (including any Section 24(b) or 80C deductions) are excluded.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
