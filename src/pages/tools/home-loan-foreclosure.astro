---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import StatusNotice from '../../components/ui/StatusNotice.astro';
import { getBreadcrumbsForPath } from '../../config/routes';

const crumbs = getBreadcrumbsForPath('/tools/home-loan-foreclosure/');
---

<BaseLayout
  title="Home Loan Prepayment & Foreclosure Calculator — Ant Wealth Creation"
  description="Evaluate interest savings, tenure reduction, and prepayment strategies on long-term home mortgages."
  currentPath="/tools/home-loan-foreclosure/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Mortgage Strategy"
      title="Home Loan Prepayment & Foreclosure Calculator"
      description="Model how making regular part-prepayments or stepping up your monthly EMI cuts years off your home loan and saves lakhs in interest."
      statusBadge="Amortization Math Verification Pending"
    />

    <StatusNotice
      featureName="Home Loan Amortization & Prepayment Engine"
      gateNote="Under GATE-B (Amortization & Interest Computation), monthly interest capitalization, partial prepayment fee rules (zero foreclosure penalty on floating rate loans per RBI guidelines), and EMI recalculation policies are undergoing formal test vector validation. This shell provides the strategic framework."
      expectedInputs={[
        "Outstanding loan principal balance (e.g. ₹20 Lakhs to ₹1.5 Crores)",
        "Current annual loan interest rate (e.g. 8.5% to 9.5%)",
        "Remaining loan tenure in months/years (e.g. 15 to 25 years)",
        "Prepayment strategy: One-time lump sum prepayment OR Annual recurring lump sum OR Monthly EMI increase",
      ]}
      expectedOutputs={[
        "Total interest saved over remaining tenure",
        "Tenure reduction in months/years",
        "New revised EMI (if choosing EMI reduction instead of tenure reduction)",
        "Before vs After full amortization comparison schedule",
      ]}
    />

    <section class="educational-insight-box" aria-labelledby="insight-heading">
      <h2 id="insight-heading" class="section-title">The Three High-Impact Prepayment Tactics</h2>
      <p class="section-desc">
        Small, consistent adjustments to your mortgage repayment can dramatically shrink total interest paid to the bank:
      </p>

      <div class="tactics-grid">
        <div class="tactic-card">
          <span class="tactic-badge">Tactic 1</span>
          <h3 class="tactic-title">1 Extra EMI Every Year</h3>
          <p class="tactic-desc">Paying just one additional EMI each year (using an annual bonus or Diwali allowance) can shave 4 to 6 years off a 20-year mortgage.</p>
        </div>

        <div class="tactic-card">
          <span class="tactic-badge">Tactic 2</span>
          <h3 class="tactic-title">5% Annual EMI Step-Up</h3>
          <p class="tactic-desc">Increasing your monthly EMI by 5% every year as your salary rises can cut your total loan duration almost in half.</p>
        </div>

        <div class="tactic-card">
          <span class="tactic-badge">Tactic 3</span>
          <h3 class="tactic-title">Occasional Lump-Sum Paydowns</h3>
          <p class="tactic-desc">Deploying windfalls or maturing fixed deposits directly toward principal reduces interest compounding permanently.</p>
        </div>
      </div>
    </section>

    <div class="nav-links-strip">
      <a href="/tools/loan-vs-invest/" class="btn-subtle">← Compare Loan Prepayment vs Investing</a>
      <a href="/tools/loan-sip-recovery/" class="btn-subtle">Explore Loan + SIP Recovery →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-bottom: var(--space-16);
  }

  .educational-insight-box {
    margin: var(--space-12) 0;
  }

  .section-title {
    font-size: var(--text-h2);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .section-desc {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    max-width: 720px;
  }

  .tactics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .tactics-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tactic-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
  }

  .tactic-badge {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .tactic-title {
    font-size: var(--text-h4);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .tactic-desc {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .nav-links-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-8);
    margin-top: var(--space-12);
  }

  .btn-subtle {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text-brand);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
  }

  .btn-subtle:hover {
    background-color: var(--primitive-teal-50);
    border-color: var(--primitive-teal-100);
  }
</style>
