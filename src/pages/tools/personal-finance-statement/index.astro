---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../../components/ui/WhatsAppToolLeadBar.astro';
import PersonalFinanceStatementApp from '../../../features/statement/PersonalFinanceStatementApp';
import { getBreadcrumbsForPath } from '../../../config/routes';
import { BUSINESS_PROFILE } from '../../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/tools/personal-finance-statement/');
const { regulatory, disclosures } = BUSINESS_PROFILE;

const registrationNotice = regulatory.arnStatus === 'CONFIRMED'
  ? 'Ant Wealth Creation is an AMFI-registered mutual fund distributor.'
  : `Ant Wealth Creation provides ${regulatory.registrationStatusText}.`;
---

<BaseLayout
  title="Personal Finance Statement — Ant Wealth Creation"
  description="Comprehensive 6-stage family cash flow, asset allocation, and productive net worth balance sheet. Reconciles income, living expenses, investments, debts, and generates client-ready PDF reports."
  currentPath="/tools/personal-finance-statement/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/tools/personal-finance-statement/" />

    <PageIntro
      eyebrow="Comprehensive Household Diagnostic"
      title="Personal Finance Statement"
      description="Map family cash flows, itemize assets and liabilities across owners, separate productive investments from personal residence utility, and generate a 5-page client-ready PDF statement."
    />

    <!-- Interactive 6-Stage Personal Finance Statement Application -->
    <PersonalFinanceStatementApp client:load />

    <WhatsAppToolLeadBar
      toolName="Personal Finance Statement"
      promptQuestion="Finished your 6-stage statement and want to walk through your action plan?"
    />

    <!-- Transparent Regulatory Disclosure -->
    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {registrationNotice} {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} The Personal Finance Statement generates diagnostic aggregations based on user-supplied values. It is not an audit, formal net worth certification, tax computation, or personalized investment recommendation.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: var(--space-8);
    padding: var(--space-4) var(--space-5);
    background-color: var(--primitive-gold-50);
    border: 1px solid var(--primitive-gold-100);
    border-radius: 12px;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--color-brand-primary);
  }
</style>
