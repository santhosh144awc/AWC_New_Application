---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import QuickToolSwitcher from '../../components/ui/QuickToolSwitcher.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import WhatsAppToolLeadBar from '../../components/ui/WhatsAppToolLeadBar.astro';
import LoanSipRecoveryIsland from '../../features/calculators/LoanSipRecoveryIsland';
import { getBreadcrumbsForPath } from '../../config/routes';
import { BUSINESS_PROFILE } from '../../config/businessProfile';

const crumbs = getBreadcrumbsForPath('/tools/loan-sip-recovery/');
const { regulatory, disclosures } = BUSINESS_PROFILE;

const registrationNotice = regulatory.arnStatus === 'CONFIRMED'
  ? 'Ant Wealth Creation is an AMFI-registered mutual fund distributor.'
  : `Ant Wealth Creation provides ${regulatory.registrationStatusText}.`;
---

<BaseLayout
  title="Loan Interest Recovery via SIP Calculator — Ant Wealth Creation"
  description="Explore how a parallel monthly SIP could help offset the total interest paid on a home loan or long-term borrowing under your own assumptions."
  canonicalUrl="https://antwealth.in/tools/loan-sip-recovery/"
  currentPath="/tools/loan-sip-recovery/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <QuickToolSwitcher currentPath="/tools/loan-sip-recovery/" />

    <PageIntro
      eyebrow="Money Lab · Borrowing Strategy"
      title="Could a parallel SIP offset the interest you pay on a loan?"
      description="Estimate the monthly SIP needed to build a maturity corpus or net investment gains equal to your total loan interest."
    />

    <LoanSipRecoveryIsland client:load />

    <WhatsAppToolLeadBar
      toolName="Loan Interest Recovery SIP Calculator"
      promptQuestion="Want to set up a parallel SIP alongside your home loan EMI?"
    />

    <aside class="regulatory-disclosure-note" aria-label="Regulatory Notice">
      <p>
        <strong>Regulatory Notice:</strong> {registrationNotice} {disclosures.mutualFundRisk} {disclosures.simulationDisclaimer} Loan EMIs are contractual obligations with fixed or floating interest rates, whereas mutual fund SIP returns fluctuate with market conditions and are never guaranteed to offset loan interest.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
  }

  .regulatory-disclosure-note {
    margin-top: 32px;
    padding: 18px 22px;
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    border-radius: 16px;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .regulatory-disclosure-note p {
    margin: 0;
  }

  .regulatory-disclosure-note strong {
    color: var(--awc-navy);
  }
</style>
