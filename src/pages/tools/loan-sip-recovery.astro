---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import LoanSipRecoveryIsland from '../../features/calculators/LoanSipRecoveryIsland';
import { getBreadcrumbsForPath } from '../../config/routes';

const crumbs = getBreadcrumbsForPath('/tools/loan-sip-recovery/');
---

<BaseLayout
  title="Home Loan Interest Recovery via Parallel SIP Calculator — Ant Wealth Creation"
  description="Calculate how pairing a disciplined parallel mutual fund SIP alongside your home loan EMI can accumulate wealth to offset cumulative mortgage interest costs."
  canonicalUrl="https://antwealth.in/tools/loan-sip-recovery/"
  currentPath="/tools/loan-sip-recovery/"
>
  <div class="container page-container">
    <Breadcrumbs crumbs={crumbs} />

    <PageIntro
      eyebrow="Dual-Engine Borrowing Strategy"
      title="Can a parallel SIP offset your home loan interest?"
      description="Simulate allocating an extra percentage of your EMI into a diversified equity SIP from Day 1. Explore how multi-decade compounding can create a parallel corpus to offset borrowing costs. All projections are illustrative mathematical simulations based on your assumptions."
      statusBadge="Interactive Calculator Active • Dual-Engine Model"
    />

    <!-- Interactive Concept C Home Loan + SIP Recovery Island -->
    <LoanSipRecoveryIsland client:load />

    <!-- Editorial Principles Section -->
    <section class="editorial-principles-section" aria-labelledby="principles-heading">
      <div class="principles-header">
        <span class="eyebrow">Strategic Principles</span>
        <h2 id="principles-heading" class="principles-title">How Parallel Compounding Offsets Borrowing Cost</h2>
        <p class="principles-sub">
          When taking a long-term mortgage, interest paid over 20–25 years often matches or exceeds the original property loan amount. Understanding how parallel compounding works helps you make informed cash allocation decisions:
        </p>
      </div>

      <div class="principles-grid">
        <div class="principle-column">
          <div class="principle-number">01</div>
          <h3 class="principle-heading">The Asymmetry of Compounding</h3>
          <p class="principle-text">
            A home loan is a reducing-balance debt where interest charges shrink as principal amortizes. In contrast, an equity mutual fund SIP is an expanding compounding vehicle where returns generate returns on an ever-growing capital base over 15–20+ years.
          </p>
        </div>

        <div class="principle-column">
          <div class="principle-number">02</div>
          <h3 class="principle-heading">Preserving Financial Liquidity</h3>
          <p class="principle-text">
            Prepaying directly to the bank permanently locks cash into illiquid brick-and-mortar equity. A parallel SIP accumulates liquid financial assets that remain in your family's control, accessible for milestone goals or unexpected emergencies.
          </p>
        </div>

        <div class="principle-column">
          <div class="principle-number">03</div>
          <h3 class="principle-heading">The Risk &amp; Volatility Distinction</h3>
          <p class="principle-text">
            Mortgage interest is a legally binding, fixed contractual liability that must be serviced monthly. Mutual fund equity returns fluctuate across market cycles and are not guaranteed. Never commit emergency reserves to parallel SIPs.
          </p>
        </div>
      </div>
    </section>

    <!-- Related Planners & Explorations -->
    <section class="related-tools-section" aria-labelledby="related-tools-title">
      <div class="section-header-compact">
        <span class="eyebrow">Explore Next</span>
        <h2 id="related-tools-title" class="related-heading">Connect your borrowing plan to your broader family roadmap</h2>
        <p class="related-sub">
          Evaluate related debt strategies, goal roadmaps, and portfolio accumulation tools designed for Indian families.
        </p>
      </div>

      <div class="related-grid">
        <a href="/tools/home-loan-foreclosure/" class="related-card">
          <div class="card-top">
            <span class="card-icon" style="background: var(--awc-jade-soft)">⇣</span>
            <span class="card-tag">Debt Strategy</span>
          </div>
          <h3 class="card-title">Home Loan Prepayment vs Parallel Investment</h3>
          <p class="card-desc">Compare prepaying your mortgage early against investing surplus funds under the exact same cash budget.</p>
          <span class="card-action">Compare prepayment →</span>
        </a>

        <a href="/tools/loan-vs-invest/" class="related-card">
          <div class="card-top">
            <span class="card-icon" style="background: var(--primitive-gold-50)">⚖️</span>
            <span class="card-tag">Decision Framework</span>
          </div>
          <h3 class="card-title">Prepay Loan vs Invest Trade-Off Analysis</h3>
          <p class="card-desc">Strategic decision framework examining peace of mind, liquidity constraints, and tax differentials.</p>
          <span class="card-action">Explore trade-offs →</span>
        </a>

        <a href="/plan/home-purchase/" class="related-card">
          <div class="card-top">
            <span class="card-icon" style="background: var(--awc-mist)">⌂</span>
            <span class="card-tag">Goal Planner</span>
          </div>
          <h3 class="card-title">Family Home Purchase Planner</h3>
          <p class="card-desc">Estimate upfront acquisition cash, stamp duty buffers, and realistic borrowing affordability.</p>
          <span class="card-action">Plan home purchase →</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* ==========================================================================
     Concept C Connected Workbench Styling — Home Loan + SIP Recovery
     ========================================================================== */

  .recovery-workbench {
    margin-top: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .example-banner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
    font-size: var(--text-body-sm);
    line-height: 1.5;
    transition: all var(--transition-fast);
  }

  .example-banner.example-active {
    background-color: var(--primitive-gold-50);
    border: 1px solid var(--primitive-gold-400);
    color: var(--primitive-gold-700);
  }

  .example-banner.custom-active {
    background-color: var(--awc-jade-soft);
    border: 1px solid var(--awc-mint);
    color: var(--awc-navy);
  }

  .banner-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .banner-text {
    flex-grow: 1;
    color: var(--color-text-primary);
  }

  .btn-banner-action {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .btn-banner-action:hover {
    background-color: var(--awc-paper);
    border-color: var(--color-border-interactive);
  }

  /* Mobile Top Summary Card */
  .mobile-recovery-summary {
    display: none;
    background-color: var(--awc-navy);
    color: var(--primitive-white);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 768px) {
    .mobile-recovery-summary {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
  }

  .mobile-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .mobile-summary-row.border-top {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--space-3);
  }

  .mobile-summary-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primitive-teal-300);
    margin-bottom: 2px;
  }

  .mobile-summary-val {
    font-size: 16px;
    font-weight: 800;
    font-family: var(--font-family-heading);
    color: var(--primitive-white);
  }

  .mobile-summary-val.highlight-val {
    color: var(--awc-gold);
  }

  .mobile-summary-badge {
    background-color: var(--awc-jade-action);
    color: var(--primitive-white);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 800;
  }

  /* Two-column workbench layout */
  .workbench-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .workbench-grid {
      grid-template-columns: 460px 1fr;
      align-items: start;
    }
  }

  .card-surface {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
  }

  @media (min-width: 640px) {
    .card-surface {
      padding: var(--space-8);
    }
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .panel-title {
    font-size: var(--text-h4);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin: 0;
  }

  .btn-reset-link {
    background: none;
    border: none;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }

  .btn-reset-link:hover {
    color: var(--color-text-brand);
  }

  .inputs-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .input-control {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .control-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .control-label {
    font-size: var(--text-body-sm);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .control-compact-badge {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    background-color: var(--awc-paper);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
  }

  .input-with-adornment {
    display: flex;
    align-items: center;
    position: relative;
  }

  .input-prefix {
    position: absolute;
    left: var(--space-4);
    font-weight: 700;
    color: var(--color-text-muted);
    font-size: var(--text-body);
    pointer-events: none;
  }

  .input-suffix {
    position: absolute;
    right: var(--space-4);
    font-weight: 700;
    color: var(--color-text-muted);
    font-size: var(--text-body-sm);
    pointer-events: none;
  }

  .form-input {
    width: 100%;
    height: 48px;
    padding: 0 var(--space-4);
    border: 1.5px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-brand-primary);
    background-color: var(--color-bg-surface);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus {
    border-color: var(--color-brand-accent);
    outline: none;
    box-shadow: 0 0 0 3px var(--awc-mint);
  }

  .form-input.text-right {
    text-align: right;
  }

  .range-slider {
    width: 100%;
    margin-top: var(--space-1);
    accent-color: var(--awc-jade);
    cursor: pointer;
  }

  .input-hint {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Mode Pill Selector */
  .mode-pill-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    background-color: var(--awc-paper);
    padding: 4px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-subtle);
  }

  .mode-pill {
    background: none;
    border: none;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-secondary);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
  }

  .mode-pill.active-pill {
    background-color: var(--color-bg-surface);
    color: var(--color-text-brand);
    box-shadow: var(--shadow-subtle);
  }

  /* Validation alert */
  .validation-alert {
    margin-top: var(--space-4);
    background-color: var(--primitive-rose-100);
    border: 1px solid var(--primitive-rose-600);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    color: #991b1b;
    font-size: var(--text-body-sm);
  }

  .validation-alert ul {
    margin: var(--space-2) 0 0 0;
    padding-left: var(--space-5);
  }

  /* Results Panel */
  .results-panel {
    position: relative;
  }

  @media (min-width: 1024px) {
    .results-panel {
      position: sticky;
      top: 96px;
    }
  }

  .results-header {
    margin-bottom: var(--space-6);
  }

  .results-eyebrow {
    font-size: var(--text-caption);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-brand);
    display: block;
    margin-bottom: var(--space-1);
  }

  .results-headline {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin: 0;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .metric-box {
    background-color: var(--awc-paper);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .metric-box.box-offset {
    background-color: var(--awc-mist);
    border-color: var(--awc-mint);
  }

  .metric-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .metric-split-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .sub-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .plus-sign {
    font-size: 20px;
    font-weight: 800;
    color: var(--color-text-muted);
  }

  .metric-number {
    font-size: 20px;
    font-weight: 800;
    font-family: var(--font-family-heading);
    color: var(--color-brand-primary);
  }

  .metric-number-big {
    font-size: 38px;
    font-weight: 850;
    font-family: var(--font-family-heading);
    color: var(--awc-jade-deep);
    line-height: 1.1;
    margin-bottom: var(--space-1);
  }

  .metric-caption {
    font-size: 12px;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* Comparison Visual Section */
  .comparison-visual-section {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .sub-heading {
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-4);
  }

  .bar-comparison-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .bar-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .bar-label-line {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .progress-bar-bg {
    width: 100%;
    height: 14px;
    background-color: var(--awc-line);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    border-radius: var(--radius-pill);
    transition: width 0.4s ease-out;
  }

  .fill-rose {
    background-color: #e11d48;
  }

  .fill-jade {
    background-color: var(--awc-jade);
  }

  .bar-sub-info {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* Net Position Callout */
  .net-position-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .position-positive {
    background-color: var(--primitive-teal-50);
    border: 1px solid var(--primitive-teal-400);
    color: var(--primitive-teal-700);
  }

  .position-neutral {
    background-color: var(--awc-paper);
    border: 1px solid var(--awc-line);
    color: var(--color-text-secondary);
  }

  .position-icon {
    font-size: 22px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .position-content strong {
    color: var(--color-brand-primary);
  }

  /* Breakeven Banner */
  .breakeven-banner {
    background-color: var(--primitive-gold-50);
    border-left: 4px solid var(--color-brand-accent);
    padding: var(--space-3) var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: var(--space-6);
  }

  .breakeven-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primitive-gold-700);
    display: block;
    margin-bottom: 2px;
  }

  .breakeven-text {
    font-size: 13px;
    color: var(--color-text-primary);
    line-height: 1.5;
    margin: 0;
  }

  /* Milestones table */
  .milestones-toggle-section {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .btn-toggle-milestones {
    background: none;
    border: none;
    color: var(--color-text-brand);
    font-weight: 700;
    font-size: var(--text-body-sm);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .btn-toggle-milestones:hover {
    text-decoration: underline;
  }

  .table-responsive {
    overflow-x: auto;
    margin-top: var(--space-4);
    border: 1px solid var(--awc-line);
    border-radius: var(--radius-md);
  }

  .milestone-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    text-align: right;
  }

  .milestone-table th {
    background-color: var(--awc-paper);
    color: var(--awc-navy);
    font-weight: 700;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--awc-line);
    white-space: nowrap;
  }

  .milestone-table td {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--awc-line);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .milestone-table td.year-cell {
    text-align: left;
    font-weight: 700;
    color: var(--awc-navy);
  }

  /* Disclaimers box */
  .disclaimer-callout {
    background-color: var(--awc-mist);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .disclaimer-callout strong {
    color: var(--color-brand-primary);
    display: block;
    margin-bottom: var(--space-1);
  }

  .disclaimer-callout p {
    margin: 0;
  }

  .text-brand {
    color: var(--awc-jade-deep) !important;
  }

  .text-rose {
    color: #e11d48 !important;
  }

  .text-muted {
    color: var(--color-text-muted) !important;
  }

  .font-bold {
    font-weight: 700;
  }

  /* Editorial Principles Section */
  .editorial-principles-section {
    margin: 56px 0;
    padding-top: 48px;
    border-top: 1px solid var(--awc-line);
  }

  .principles-title {
    font-size: clamp(22px, 2.8vw, 30px);
    font-weight: 850;
    letter-spacing: -0.03em;
    color: var(--awc-navy);
    margin: 4px 0 8px;
  }

  .principles-sub {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 800px;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-top: 32px;
  }

  @media (min-width: 850px) {
    .principles-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }

    .principle-column:not(:last-child) {
      border-right: 1px solid var(--awc-line);
      padding-right: 32px;
    }
  }

  .principle-column {
    display: flex;
    flex-direction: column;
  }

  .principle-number {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-text-brand);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .principle-heading {
    font-size: 17px;
    font-weight: 800;
    color: var(--awc-navy);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    line-height: 1.35;
  }

  .principle-text {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Related Tools Grid */
  .related-tools-section {
    margin-top: 56px;
    padding-top: 48px;
    border-top: 1px solid var(--awc-line);
