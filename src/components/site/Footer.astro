---
import { BUSINESS_PROFILE } from '../../config/businessProfile';
import { GOAL_ROUTES, TOOL_ROUTES, LEGAL_ROUTES, CONTACT_ROUTE } from '../../config/routes';
---

<footer class="site-footer" role="contentinfo" id="footer-disclosures">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Identity & Credentials -->
      <div class="footer-col brand-col">
        <h3 class="footer-brand-title">{BUSINESS_PROFILE.firm.name}</h3>
        <p class="footer-tagline">{BUSINESS_PROFILE.firm.tagline}</p>
        <div class="footer-credentials">
          <p><strong>Founder:</strong> {BUSINESS_PROFILE.founder.fullName}</p>
          <p><strong>Registration:</strong> {BUSINESS_PROFILE.regulatory.amfiRegistrationText}</p>
          <p><strong>Credentials:</strong> {BUSINESS_PROFILE.founder.credentials}</p>
          <p><strong>Experience:</strong> Financial Markets Since {BUSINESS_PROFILE.firm.experienceSince}</p>
        </div>
      </div>

      <!-- Col 2: Life Milestones -->
      <div class="footer-col">
        <h4 class="footer-heading">Life Milestones</h4>
        <ul class="footer-links" role="list">
          {GOAL_ROUTES.map((goal) => (
            <li><a href={goal.path}>{goal.label}</a></li>
          ))}
          <li><a href="/health-check/real-statement/">REAL Financial Statement</a></li>
        </ul>
      </div>

      <!-- Col 3: Mathematical Simulators -->
      <div class="footer-col">
        <h4 class="footer-heading">Tools & Simulators</h4>
        <ul class="footer-links" role="list">
          {TOOL_ROUTES.slice(0, 5).map((tool) => (
            <li><a href={tool.path}>{tool.label}</a></li>
          ))}
          <li><a href="/tools/">View All Tools Hub →</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Office -->
      <div class="footer-col">
        <h4 class="footer-heading">Contact & Guidance</h4>
        <p class="footer-contact-item">{BUSINESS_PROFILE.firm.headquarters}</p>
        <p class="footer-contact-item">
          <a href={`tel:${BUSINESS_PROFILE.contact.phone}`}>{BUSINESS_PROFILE.contact.phoneDisplay}</a>
        </p>
        <p class="footer-contact-item">
          <a href={`mailto:${BUSINESS_PROFILE.contact.email}`}>{BUSINESS_PROFILE.contact.email}</a>
        </p>
        <p class="footer-contact-item">
          <a href={CONTACT_ROUTE.path} class="contact-details-link">
            Consultation Expectations & Redressal →
          </a>
        </p>
        <p class="footer-contact-item">
          <a 
            href={BUSINESS_PROFILE.contact.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="whatsapp-link"
          >
            Chat with Santhosh on WhatsApp ↗
          </a>
        </p>
      </div>
    </div>

    <!-- Statutory Regulatory Notices Box -->
    <div class="statutory-notice-box" id="statutory-notices">
      <p class="statutory-risk-title">Regulatory Disclosures & Consumer Information:</p>
      
      <p class="statutory-text">
        <strong>Mutual Fund Market Risk Notice:</strong> {BUSINESS_PROFILE.disclosures.mutualFundRisk}
      </p>

      <p class="statutory-text">
        <strong>Intermediary Disclosure:</strong> {BUSINESS_PROFILE.disclosures.intermediaryStatement}
      </p>

      <p class="statutory-text">
        <strong>Simulation & Projection Caveat:</strong> {BUSINESS_PROFILE.disclosures.simulationDisclaimer}
      </p>

      <p class="statutory-subtle">
        {BUSINESS_PROFILE.disclosures.prototypeNotice}
      </p>
    </div>

    <!-- Copyright and Legal Bar -->
    <div class="footer-bottom-bar">
      <p class="copyright-text">
        {BUSINESS_PROFILE.disclosures.copyrightText}
      </p>
      <div class="legal-nav">
        {LEGAL_ROUTES.map((item, idx) => (
          <>
            <a href={item.path}>{item.label}</a>
            {idx < LEGAL_ROUTES.length - 1 && <span aria-hidden="true">•</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-surface-dark);
    color: var(--primitive-slate-300);
    padding: var(--space-12) 0 var(--space-8);
    margin-top: auto;
    font-size: var(--text-body-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .footer-brand-title {
    color: var(--primitive-white);
    font-size: 1.25rem;
    font-family: var(--font-family-heading);
    margin-bottom: var(--space-2);
  }

  .footer-tagline {
    color: var(--primitive-teal-400);
    font-size: 0.9rem;
    margin-bottom: var(--space-4);
  }

  .footer-credentials p {
    margin: 4px 0;
    color: var(--primitive-slate-300);
    font-size: 0.85rem;
  }

  .footer-heading {
    color: var(--primitive-white);
    font-size: 0.95rem;
    font-family: var(--font-family-heading);
    font-weight: 600;
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--primitive-slate-300);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--primitive-teal-400);
  }

  .footer-contact-item {
    margin: var(--space-2) 0;
    color: var(--primitive-slate-300);
  }

  .footer-contact-item a {
    color: var(--primitive-teal-400);
    text-decoration: none;
  }

  .contact-details-link {
    color: var(--primitive-teal-300) !important;
    text-decoration: underline !important;
  }

  .whatsapp-link {
    display: inline-block;
    color: var(--primitive-teal-400);
    text-decoration: underline;
    font-weight: 500;
  }

  .statutory-notice-box {
    background-color: var(--primitive-navy-950);
    border: 1px solid var(--primitive-navy-700);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .statutory-risk-title {
    color: var(--primitive-gold-400);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .statutory-text {
    font-size: 0.825rem;
    line-height: 1.6;
    color: var(--primitive-slate-300);
    margin-bottom: var(--space-3);
  }

  .statutory-text strong {
    color: var(--primitive-white);
  }

  .statutory-subtle {
    font-size: 0.775rem;
    color: var(--primitive-slate-400);
    font-style: italic;
    margin: 0;
  }

  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 1px solid var(--primitive-navy-800);
    padding-top: var(--space-6);
    align-items: center;
    text-align: center;
    font-size: 0.8rem;
  }

  .legal-nav {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  .legal-nav a {
    color: var(--primitive-slate-400);
    text-decoration: none;
  }

  .legal-nav a:hover {
    color: var(--primitive-white);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
    }

    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
