---
import { BUSINESS_PROFILE } from '../../config/businessProfile';
import {
  CONTACT_ROUTE,
  DIAGNOSTIC_ROUTES,
  GOAL_ROUTES,
  LEGAL_ROUTES,
  TOOL_ROUTES,
  TOP_NAV_ROUTES,
} from '../../config/routes';

const exploreRoutes = TOP_NAV_ROUTES.filter((r) => r.path !== '/');
const realStatement = DIAGNOSTIC_ROUTES.find((r) => r.id === 'diag-real-statement');
const goalLinks = [...GOAL_ROUTES, ...(realStatement ? [realStatement] : [])];
---

<footer class="site-footer surface-dark" role="contentinfo" id="footer-disclosures">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Identity -->
      <div class="footer-col brand-col">
        <h3 class="footer-brand-title">{BUSINESS_PROFILE.firm.name}</h3>
        <p class="footer-tagline">{BUSINESS_PROFILE.firm.tagline}</p>
        <div class="footer-credentials">
          <p><strong>Founder:</strong> {BUSINESS_PROFILE.founder.fullName}</p>
          <p><strong>Status:</strong> {BUSINESS_PROFILE.regulatory.registrationStatusText}</p>
          <p><strong>Credentials:</strong> {BUSINESS_PROFILE.founder.credentials}</p>
          <p><strong>Experience:</strong> Financial Markets Since {BUSINESS_PROFILE.firm.experienceSince}</p>
        </div>
      </div>

      <!-- Explore -->
      <nav class="footer-col" aria-label="Explore">
        <h4 class="footer-heading">Explore</h4>
        <ul class="footer-links" role="list">
          {exploreRoutes.map((route) => (
            <li><a href={route.path}>{route.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Goals & tools -->
      <nav class="footer-col" aria-label="Goals and tools">
        <h4 class="footer-heading">Goals &amp; tools</h4>
        <ul class="footer-links" role="list">
          {goalLinks.map((route) => (
            <li><a href={route.path}>{route.label}</a></li>
          ))}
          {TOOL_ROUTES.slice(0, 3).map((tool) => (
            <li><a href={tool.path}>{tool.label}</a></li>
          ))}
          <li><a href="/tools/">All tools →</a></li>
        </ul>
      </nav>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Contact</h4>
        <p class="footer-contact-item">{BUSINESS_PROFILE.firm.headquarters}</p>
        <p class="footer-contact-item">
          <a href={`tel:${BUSINESS_PROFILE.contact.phone}`}>{BUSINESS_PROFILE.contact.phoneDisplay}</a>
        </p>
        <p class="footer-contact-item">
          <a href={`mailto:${BUSINESS_PROFILE.contact.email}`}>{BUSINESS_PROFILE.contact.email}</a>
        </p>
        <p class="footer-contact-item">
          <a href={CONTACT_ROUTE.path}>Consultation expectations &amp; redressal →</a>
        </p>
        <p class="footer-contact-item">
          <a
            href={BUSINESS_PROFILE.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp {BUSINESS_PROFILE.founder.shortName} ↗
          </a>
        </p>
        <p class="footer-contact-item">
          <a
            href={BUSINESS_PROFILE.contact.portfolioLoginUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Client portfolio login ↗
          </a>
        </p>
      </div>
    </div>

    <!-- Statutory notices (required disclosures; kept in full) -->
    <div class="statutory-notice-box" id="statutory-notices">
      <p class="statutory-risk-title">Regulatory disclosures &amp; consumer information</p>

      <p class="statutory-text">
        <strong>Mutual Fund Market Risk Notice:</strong> {BUSINESS_PROFILE.disclosures.mutualFundRisk}
      </p>

      <p class="statutory-text">
        <strong>Intermediary Disclosure:</strong> {BUSINESS_PROFILE.disclosures.intermediaryStatement}
      </p>

      <p class="statutory-text">
        <strong>Simulation &amp; Projection Caveat:</strong> {BUSINESS_PROFILE.disclosures.simulationDisclaimer}
      </p>

      <p class="statutory-text">
        <strong>Business Structure:</strong> {BUSINESS_PROFILE.disclosures.soleProprietorStatement}
      </p>

      <p class="statutory-subtle">
        {BUSINESS_PROFILE.disclosures.prototypeNotice}
      </p>
    </div>

    <div class="footer-bottom-bar">
      <p class="copyright-text">
        {BUSINESS_PROFILE.disclosures.copyrightText}
      </p>
      <nav class="legal-nav" aria-label="Legal">
        {LEGAL_ROUTES.map((item) => (
          <a href={item.path}>{item.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding: var(--space-12) 0 var(--space-8);
    background-color: var(--awc-navy-night);
    color: var(--color-text-on-dark);
    font-size: var(--text-body-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .footer-brand-title {
    margin-bottom: var(--space-2);
    font-size: 1.25rem;
    color: var(--primitive-white);
  }

  .footer-tagline {
    margin-bottom: var(--space-4);
    font-size: 0.9rem;
    color: var(--awc-gold);
    font-weight: 700;
  }

  .footer-credentials p {
    margin: 4px 0;
    font-size: 0.85rem;
    color: var(--color-text-on-dark);
  }

  .footer-heading {
    margin-bottom: var(--space-3);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a7beb8;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links a,
  .footer-contact-item a {
    display: inline-block;
    padding: 2px 0;
    color: var(--color-text-on-dark);
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-contact-item a:hover {
    color: var(--primitive-white);
    text-decoration: underline;
  }

  .footer-contact-item {
    margin: var(--space-2) 0;
    color: var(--color-text-on-dark);
  }

  .statutory-notice-box {
    margin-bottom: var(--space-8);
    padding: var(--space-6);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
  }

  .statutory-risk-title {
    margin-bottom: var(--space-3);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--awc-gold);
  }

  .statutory-text {
    margin-bottom: var(--space-3);
    font-size: 0.825rem;
    line-height: 1.65;
    color: var(--color-text-on-dark);
  }

  .statutory-text strong {
    color: var(--primitive-white);
  }

  .statutory-subtle {
    margin: 0;
    font-size: 0.775rem;
    font-style: italic;
    color: #b7cbc6;
  }

  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    text-align: center;
    font-size: 0.8rem;
  }

  .copyright-text {
    margin: 0;
    color: #b7cbc6;
  }

  .legal-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
  }

  .legal-nav a {
    padding: 4px 0;
    color: var(--primitive-white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.3fr 0.8fr 1.1fr 1.1fr;
    }

    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
