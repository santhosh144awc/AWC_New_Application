---
import { BUSINESS_PROFILE } from '../../config/businessProfile';

interface Props {
  toolName: string;
  promptQuestion?: string;
}

const {
  toolName,
  promptQuestion = 'Want to review how these numbers fit into your family financial plan?',
} = Astro.props;

const whatsappMessage = encodeURIComponent(
  `Hi Santhosh, I just tried the ${toolName} on Ant Wealth Creation and would like to discuss my scenario and numbers with you.`
);
const whatsappHref = `https://wa.me/${BUSINESS_PROFILE.contact.phone.replace(/[^0-9]/g, '')}?text=${whatsappMessage}`;
---

<section class="whatsapp-lead-bar" aria-label="Discuss this scenario with Santhosh on WhatsApp">
  <div class="lead-bar-content">
    <span class="lead-eyebrow">Personalized Review · Direct Guidance</span>
    <h2 class="lead-title">{promptQuestion}</h2>
    <p class="lead-desc">
      Share your scenario directly with <strong>{BUSINESS_PROFILE.founder.fullName}</strong> ({BUSINESS_PROFILE.founder.credentials}) on WhatsApp for a clear, practical discussion—or build your full 6-stage household statement.
    </p>
  </div>

  <div class="lead-bar-actions">
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-whatsapp-lead"
    >
      Discuss This Scenario on WhatsApp ↗
    </a>
    <a href="/tools/personal-finance-statement/" class="btn-pfs-secondary">
      Open Personal Finance Statement →
    </a>
  </div>
</section>

<style>
  .whatsapp-lead-bar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    margin: 32px 0;
    padding: 24px 28px;
    border-radius: 22px;
    background: linear-gradient(135deg, var(--awc-navy) 0%, var(--primitive-navy-800) 100%);
    color: var(--primitive-white);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 900px) {
    .whatsapp-lead-bar {
      flex-direction: row;
      align-items: center;
    }
  }

  .lead-bar-content {
    max-width: 640px;
  }

  .lead-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--awc-gold);
    margin-bottom: 6px;
  }

  .lead-title {
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 850;
    letter-spacing: -0.02em;
    color: var(--primitive-white);
    margin: 0 0 6px 0;
  }

  .lead-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-text-on-dark);
    margin: 0;
  }

  .lead-desc strong {
    color: var(--primitive-white);
  }

  .lead-bar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    flex-shrink: 0;
  }

  .btn-whatsapp-lead {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 20px;
    border-radius: 999px;
    background-color: var(--awc-gold);
    color: var(--awc-navy);
    font-size: 13.5px;
    font-weight: 850;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .btn-whatsapp-lead:hover {
    filter: brightness(1.04);
    transform: translateY(-1px);
  }

  .btn-pfs-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--primitive-white);
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .btn-pfs-secondary:hover {
    background-color: rgba(255, 255, 255, 0.16);
  }
</style>

