---
interface Props {
  number: string;
  name: string;
  focus: string;
  question: string;
  benchmark: string;
}

const { number, name, focus, question, benchmark } = Astro.props;
---

<div class="pillar-card">
  <div class="pillar-card-top">
    <span class="pillar-number">{number}</span>
    <span class="pillar-focus-badge">{focus}</span>
  </div>
  <h3 class="pillar-name">{name}</h3>
  <p class="pillar-question">"{question}"</p>
  <div class="pillar-benchmark">
    <span class="benchmark-label">Sound Benchmark:</span>
    <span class="benchmark-val">{benchmark}</span>
  </div>
</div>

<style>
  .pillar-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .pillar-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-interactive);
  }

  .pillar-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .pillar-number {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--color-text-brand);
  }

  .pillar-focus-badge {
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--primitive-slate-100);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .pillar-name {
    font-size: var(--text-h3);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .pillar-question {
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    font-style: italic;
    line-height: 1.5;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .pillar-benchmark {
    border-top: 1px solid var(--primitive-slate-100);
    padding-top: var(--space-3);
    font-size: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .benchmark-label {
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .benchmark-val {
    color: var(--color-text-primary);
    font-weight: 500;
  }
</style>
