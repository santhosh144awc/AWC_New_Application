---
interface Props {
  title: string;
  category: string;
  realQuestion: string;
  description: string;
  statusBadge?: string;
  href?: string;
  isActive?: boolean;
}

const {
  title,
  category,
  realQuestion,
  description,
  statusBadge = "Engine Under Spec Review",
  href,
  isActive = false,
} = Astro.props;
---

<div class={`tool-preview-card ${isActive ? 'tool-card-active' : ''}`}>
  <div class="tool-meta-row">
    <span class="tool-category">{category}</span>
    <span class={`tool-status ${isActive ? 'status-active' : ''}`}>{statusBadge}</span>
  </div>
  <h3 class="tool-title">{title}</h3>
  <p class="tool-real-question">"{realQuestion}"</p>
  <p class="tool-desc">{description}</p>
  <div class="tool-action-row">
    {href ? (
      <a href={href} class={`btn-tool-link ${isActive ? 'btn-tool-link-active' : ''}`}>
        {isActive ? 'Launch Simulator →' : 'Explore Planning Preview →'}
      </a>
    ) : (
      <span class="tool-note">Scheduled for verified domain porting</span>
    )}
  </div>
</div>

<style>
  .tool-preview-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .tool-preview-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-interactive);
  }

  .tool-card-active {
    border-color: var(--color-border-interactive);
  }

  .tool-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .tool-category {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tool-status {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-accent);
    background-color: var(--primitive-gold-50);
    border: 1px solid var(--primitive-gold-100);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .status-active {
    background-color: #ecfdf5;
    color: #047857;
    border-color: #a7f3d0;
  }

  .tool-title {
    font-size: var(--text-h4);
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: var(--space-2);
  }

  .tool-real-question {
    font-size: var(--text-body-sm);
    color: var(--color-text-primary);
    font-weight: 600;
    line-height: 1.45;
    margin-bottom: var(--space-3);
  }

  .tool-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .tool-action-row {
    border-top: 1px solid var(--primitive-slate-100);
    padding-top: var(--space-3);
  }

  .btn-tool-link {
    font-size: var(--text-body-sm);
    font-weight: 700;
    color: var(--color-brand-primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color var(--transition-fast);
  }

  .btn-tool-link:hover {
    color: var(--color-text-brand);
    text-decoration: underline;
  }

  .btn-tool-link-active {
    color: var(--color-brand-primary);
    font-weight: 800;
  }

  .tool-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
