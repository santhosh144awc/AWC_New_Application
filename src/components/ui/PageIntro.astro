---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  statusBadge?: string;
}

const { eyebrow, title, description, statusBadge } = Astro.props;
---

<header class="page-intro">
  {eyebrow && <span class="intro-eyebrow">{eyebrow}</span>}
  <h1 class="intro-title">{title}</h1>
  <p class="intro-desc">{description}</p>
  {statusBadge && (
    <div class="intro-status-wrap">
      <span class="status-indicator-dot" aria-hidden="true"></span>
      <span class="intro-status-badge">{statusBadge}</span>
    </div>
  )}
</header>

<style>
  .page-intro {
    padding: var(--space-8) 0 var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-10);
    max-width: 860px;
  }

  .intro-eyebrow {
    display: inline-block;
    font-size: var(--text-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-brand);
    background-color: var(--primitive-teal-50);
    border: 1px solid var(--primitive-teal-100);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }

  .intro-title {
    font-size: var(--text-h1);
    font-family: var(--font-family-heading);
    font-weight: 800;
    color: var(--color-brand-primary);
    line-height: 1.15;
    margin-bottom: var(--space-4);
    letter-spacing: -0.015em;
  }

  .intro-desc {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .intro-status-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0.3rem 0.75rem;
    background-color: var(--primitive-gold-50);
    border: 1px solid var(--primitive-gold-100);
    border-radius: var(--radius-pill);
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--primitive-gold-500);
  }

  .intro-status-badge {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--color-text-accent);
  }
</style>
