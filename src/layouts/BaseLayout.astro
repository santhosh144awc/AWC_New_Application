---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { BUSINESS_PROFILE } from '../config/businessProfile';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  /** 
   * In pre-launch staging, defaults to 'noindex, nofollow' to prevent search engine ingestion of prototype routes.
   * Switch to 'index, follow' on production release.
   */
  robots?: string;
}

const {
  title = `${BUSINESS_PROFILE.firm.name} — ${BUSINESS_PROFILE.firm.tagline}`,
  description = 'Simple, transparent personal financial guidance for Indian families. Plan your children\'s education, home purchase, and dignified retirement.',
  currentPath = '/',
  robots = 'noindex, nofollow',
} = Astro.props;

const canonicalUrl = new URL(currentPath, BUSINESS_PROFILE.firm.canonicalDomain).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="/assets/homeScreenimage.webp" />
  </head>
  <body>
    <!-- WCAG Accessible Skip Link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Global Header Landmark -->
    <Header currentPath={currentPath} />

    <!-- Main Content Landmark -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Global Footer Landmark -->
    <Footer />
  </body>
</html>

<style>
  #main-content:focus {
    outline: none;
  }
</style>
